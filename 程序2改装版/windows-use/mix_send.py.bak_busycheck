def _load_cfg():
    try:
        with open(CFG_FILE, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return []

def _lookup(ai):
    """从配置里查 CDP 端口，返回 (port, url_kw)；无则返回 None"""
    for e in _load_cfg():
        if e.get("名字") == ai:
            port = e.get("cdp_port")
            typ  = e.get("类型", "")
            if port:
                # web 类型带上 url 关键字（便于匹配标签页）
                kw = ""
                if typ == "web":
                    u = (e.get("url") or "").lower()
                    for token in ("deepseek","kimi","claude","chatgpt","gemini","tongyi","doubao"):
                        if token in u: kw = token; break
                return (port, kw)
            return None
    return _FALLBACK_CDP.get(ai)

# 兼容旧代码对 CDP_APPS 的用法（动态函数式访问）
class _CDPProxy:
    def __contains__(self, k): return _lookup(k) is not None
    def __getitem__(self, k):
        v = _lookup(k)
        if v is None: raise KeyError(k)
        return v
    def get(self, k, d=None): return _lookup(k) or d
CDP_APPS = _CDPProxy()
