# tasks.py — 为「每个环节 × 每个目标 AI」生成 Windows-Use 自然语言任务
#
# Windows-Use 是「看屏幕、控键鼠」的 GUI 代理：它读不到我们的 Python 变量，
# 只能靠一段自然语言 SOP 去操作真实软件（网页版 AI 或桌面端 AI）。
# 本模块只做一件事：把 (哪个 app / 哪段 prompt / 哪些输入 / 存到哪) 组装成这段 SOP。
#
# ── 四程序模型下共有五类原子任务 ──────────────────────────────
#   produce  产出：按「块」产出一版（块可以是环节、子项、六要素某一段、章节）
#   review   盲审：隔离评审某一版，按审核框架（八方向/六要素/润色清单/质检节）逐条打勾
#   merge    拼接：读全部版本 + 全部评审，按「段落级择优」拼候选稿
#   vote     终审：对候选稿投票（通过/不通过），反对票必须附「问题定位卡」四件套
#   probe    探测：核对今日阵容里某个 AI 是否真的可用、已登录
#
# ── 今日阵容（动态） ─────────────────────────────────────────
# app 字典由 session.py 合成，必备字段：
#   key     标识
#   label   显示名
#   form    "web" 或 "desktop"（今天实际用哪种形态）
#   target  web→网址；desktop→可执行文件路径
#   browser web 形态用哪个浏览器（默认 EDGE）


# ──────────────────────────────── 基础零件 ────────────────────────────────

class _Steps:
    """连续步骤号生成器。避免在 f-string 里手写序号写错。"""

    def __init__(self):
        self.i = 0

    def __call__(self) -> str:
        self.i += 1
        return str(self.i)


def _form_of(app: dict) -> str:
    """取今日实际形态。兼容旧字段 type。"""
    f = (app.get("form") or app.get("type") or "web").lower()
    return "desktop" if f.startswith("desk") else "web"


def _open_instruction(app: dict) -> str:
    """生成「打开并聚焦这个 AI」的指令。electron/web 走不同路径。"""
    label = app.get("label") or app.get("key") or "目标程序"
    # electron / desktop 类型 → 桌面程序
    _t = (app.get("类型") or app.get("form") or "").lower()
    if _t in ("electron", "desktop") or _form_of(app) == "desktop":
        exe = (app.get("target") or "").strip()
        if exe and exe.lower().endswith(".exe"):
            return (
                f"启动或聚焦「{label}」桌面程序（可执行文件：{exe}）。"
                f"若已在运行，直接切换到它的主窗口并置前；"
                f"若未安装或启动失败，停下并报告「{label} 不可用」，不要尝试其它程序。"
            )
        if exe:
            return (
                f"启动或聚焦「{label}」桌面程序（它在系统中的识别方式：{exe}）。"
                f"若已在运行，直接切换到其主窗口并置前；找不到就停下并报告不可用。"
            )
        return (
            f"启动或聚焦「{label}」桌面程序。"
            f"若已在运行，直接切换到其主窗口并置前；找不到就停下并报告不可用。"
        )
    # web 类型 → 浏览器
    url = (app.get("target") or "").strip()
    browser = (app.get("browser") or "EDGE").upper()
    return (
        f"打开 {browser} 浏览器，导航到网址 {url}，等待页面加载完成。"
        f"确认页面处于「可输入提问」状态（输入框可见、可点击）；"
        f"若要求登录而当前未登录，停下并报告「{label} 需先登录」，不要尝试输入账号密码。"
    )

def _new_chat_instruction(app: dict, isolate: bool = False) -> str:
    """新建干净会话。盲审必须隔离，故附加强制说明。"""
    base = "在该 AI 中「新建对话 / 新聊天」，确认是一个干净的空白会话（历史条目为空）。"
    if isolate:
        return (
            base
            + " 本次是隔离盲审：只能依据本次粘贴进去的内容判断，"
              "不得点开任何历史对话、不得引用既有记忆、不得去看其它文件。"
        )
    return base


def _wait_instruction() -> str:
    return (
        "等待 AI 完全生成回复：直到发送按钮重新可点击、且回复文字在 5 秒内不再增长。"
        "若界面出现「停止生成 / Stop」按钮，先点它再继续。"
    )


def _save_block(s: _Steps, out_path: str, what: str = "AI 的最新一条回复正文") -> str:
    """统一落盘方式：记事本另存为 UTF-8。"""
    n1, n2, n3 = s(), s(), s()
    return (
        f"{n1} 用鼠标拖选或 Ctrl+A 全选{what}，按 Ctrl+C 复制。\n"
        f"{n2} 打开记事本（notepad），Ctrl+V 粘贴。\n"
        f"     再按 Ctrl+S 另存为，路径填：{out_path}\n"
        f"     保存类型选「所有文件」，编码选 UTF-8，文件名后缀保留 .md 或 .json。\n"
        f"{n3} 关闭记事本与该 AI 窗口。\n"
        f"只执行以上步骤，不要做额外操作。"
    )


