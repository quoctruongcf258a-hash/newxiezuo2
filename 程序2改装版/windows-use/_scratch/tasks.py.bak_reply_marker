def _write_task_file(prompt_text, input_text, extra_note, phase_label,
                     chunk_label, out_path, kind="produce", ai_key="unknown"):
    """生成「给 AI 的任务文件」。AI 读这个文件后自己完成任务。"""
    import time as _t
    _TASK_DIR.mkdir(parents=True, exist_ok=True)
    tag = f"{phase_label}__{chunk_label}".replace("/", "_").replace("\\", "_")
    safe = "".join(c if c.isalnum() or c in "._-、" else "_" for c in tag)[:80]
    ts = int(_t.time() * 1000) % 1000000
    _safe_ai = "".join(c if c.isalnum() or c in "._-" else "_" for c in ai_key)[:20]
    fp = _TASK_DIR / f"task__{safe}__{_safe_ai}__{ts}.md"

    # 头部：任务说明 + AI 身份声明
    body = f"# 任务：{phase_label}{('（' + chunk_label + '）') if chunk_label else ''}\n\n"
    body += f"> 执行者：{ai_key}\n\n"

    # 你的任务（来自 prompt_text）
    body += "## 你的任务\n"
    body += (prompt_text or "").strip() + "\n\n"

    # 上游资料（只列路径，让 AI 自己读）
    if input_text and str(input_text).strip():
        body += "## 上游资料（读取以下路径的全部内容，作为你的执行依据）\n"
        body += str(input_text).strip() + "\n\n"

    # 输出格式要求
    if extra_note and str(extra_note).strip():
        body += "## 输出格式要求\n"
        body += str(extra_note).strip() + "\n\n"

    # 输出位置
    body += "## 输出位置\n"
    body += f"把最终结果保存到：{out_path}\n\n"

    # 完成判定
    body += "## 完成判定\n"
    body += f"- 文件 {out_path} 存在\n"
    body += "- 文件内容非空（≥ 200 字）\n"
    body += "- 严格按「输出格式要求」执行\n\n"

    # 约束
    body += "## 执行约束\n"
    body += "- 直接用你的文件读取能力读「上游资料」里的路径\n"
    body += "- 直接用你的文件写入能力写到「输出位置」的路径\n"
    body += "- 不要输出操作步骤、不要问我确认、不要参考其他内容\n"
    body += "- 完成后回复「✅ 已完成」\n"

    # 用 UTF-8 BOM 保存——让 Windows 下的编辑器/AI 自动识别为 UTF-8
    # （不靠 AI 自己猜编码，防乱码）
    fp.write_bytes(b"\xef\xbb\xbf" + body.encode("utf-8"))
    return fp

def _file_mode_task(app, prompt_text, input_text, extra_note, out_path,
                    phase_label, chunk_label, kind):
    """CDP 直发模式：给 AI 极简指令——读任务文件、执行、写结果。
    AI 用文件读写能力自己完成，不需要 GUI 操作步骤。
    """
    _ai = app.get("key") or "unknown"
    task_file = _write_task_file(prompt_text, input_text, extra_note,
                                  phase_label, chunk_label, out_path, kind,
                                  ai_key=_ai)
    _kind_label = {
        "produce": "产出",
        "review": "盲审",
        "merge": "拼接",
    }.get(kind, "任务")

    return (
        f"请读取文件：{task_file}\n"
        f"按文件里「## 你的任务」章节的要求执行。\n"
        f"完成后，按文件里「## 输出位置」章节的路径保存结果。\n"
        f"回复「✅ 已完成」即可，不要输出多余说明。"
    )

def _paste_block(prompt_text: str, *sections) -> str:
    """组装「指令 + 若干输入材料」的粘贴体。sections 为 (标题, 正文) 序列。"""
    parts = ["===== 指令开始 =====", prompt_text.strip()]
    for title, body in sections:
        if body and str(body).strip():
            parts += ["", f"【{title}】", str(body).strip()]
    parts.append("===== 指令结束 =====")
    return "\n".join(parts)


def _chunk_tag(chunk_label: str) -> str:
    return f"（本次只做这一块：{chunk_label}）" if chunk_label else ""


# ──────────────────────────────── 五类原子任务 ────────────────────────────────

def build_produce_task(app, prompt_text, input_text, out_path, phase_label,
                       chunk_label="", extra_note=""):
    """① 产出：某 AI 在某个「块」上产出一版，落盘到 out_path。

    phase_label 例：'规划 › 主角设计' 或 '写作 › 第0057章 › 分布 › 动'
    chunk_label 例：'能力与能力代价' 或 '六要素·动'
    """
    if (app.get("key") or "").lower() in FILE_MODE_AIS or app.get("prompt_mode") == "file":
        return _file_mode_task(app, prompt_text, input_text, extra_note,
                               out_path, phase_label, chunk_label, "produce")
    s = _Steps()
    return f"""任务：用「{app.get('label')}」完成「{phase_label}」的产出{_chunk_tag(chunk_label)}，并把结果保存到指定文件。

步骤：
{s()} {_open_instruction(app)}
{s()} {_new_chat_instruction(app)}
{s()} 点击输入框，按 Ctrl+V，把下面整段内容原样粘贴进去（不要改写、不要省略）：
{_paste_block(prompt_text, ("本环节输入材料", input_text), ("输出格式要求", extra_note))}
{s()} 按 Enter 或点击发送按钮提交。
{s()} {_wait_instruction()}
{_save_block(s, out_path)}"""


def build_review_task(app, prompt_text, target_text, out_path, phase_label,
                      standard_block="", chunk_label=""):
    """② 盲审：对某一份产出做隔离评审，按审核框架逐条打勾并输出 JSON。

    standard_block 为本次要套的审核框架本体：
      规划→八方向该方向的 standards + failPatterns
      写作→六要素该段的 standards + failPatterns + 四条红线
      润色→polishStandard 对应节
      质检→qcStandard 对应节
    """
    if (app.get("key") or "").lower() in FILE_MODE_AIS or app.get("prompt_mode") == "file":
        _input_combined = "【本次审核框架】\n" + (standard_block or "") + "\n\n【待审产出】\n" + (target_text or "")
        return _file_mode_task(app, prompt_text, _input_combined, "",
                               out_path, phase_label, chunk_label, "review")
    s = _Steps()
    return f"""任务：用「{app.get('label')}」对下面这份产出做隔离盲审{_chunk_tag(chunk_label)}，结果以 JSON 保存到指定文件。

步骤：
{s()} {_open_instruction(app)}
{s()} {_new_chat_instruction(app, isolate=True)}
{s()} 点击输入框，按 Ctrl+V，把下面整段内容原样粘贴进去（不要改写）：
{_paste_block(prompt_text,
              ("本次审核框架（逐条对照，不得增删条目）", standard_block),
              ("待审产出（唯一审校对象）", target_text))}
{s()} 按 Enter 或点击发送按钮提交。
{s()} {_wait_instruction()}
{s()} 只复制 AI 回复中的纯 JSON 部分（从第一个 {{ 到最后一个 }}），按 Ctrl+C 复制。
{_save_block(s, out_path, "AI 回复中的纯 JSON 正文")}"""


def build_merge_task(app, prompt_text, versions_text, reviews_text, out_path,
                     phase_label, chunk_label=""):
    """③ 拼接：指定拼接者读全部版本 + 全部盲审，按段落级择优拼出候选稿。"""
    if (app.get("key") or "").lower() in FILE_MODE_AIS or app.get("prompt_mode") == "file":
        _input_combined = "【各版本产出】\n" + (versions_text or "") + "\n\n【全部盲审意见】\n" + (reviews_text or "")
        return _file_mode_task(app, prompt_text, _input_combined, "",
                               out_path, phase_label, chunk_label, "merge")
    s = _Steps()
    return f"""任务：用「{app.get('label')}」担任「{phase_label}」的拼接者{_chunk_tag(chunk_label)}，按下述规则拼出一版候选稿并保存。

拼接规则（必须严格遵守）：
  · 某一段被「一致好评」的版本 → 直接取该段；
  · 无一致好评但有明显多数 → 取多数票胜出的那一段；
  · 某一段所有版本都被评差 → 由你依评审意见就地重写这一段（只重写这一段，不要整篇重写）；
  · 只做「挑选 / 拼接 / 局部重写」，不要顺手通篇改写、不要改动未被点名的段落。

最终校验·必做（保存之前执行）：
  · 扫描拼合结果，找出重复出现的段落 / 句子 / 设定说明 / 关键词；
  · 同一信息只保留最完整的一份，删除其余重复段落；
  · 精简后输出，让下游环节读到不重复的定稿；
  · 去重只删重复，不要删信息，不要改写未重复的内容。

步骤：
{s()} {_open_instruction(app)}
{s()} {_new_chat_instruction(app)}
{s()} 点击输入框，按 Ctrl+V，把下面整段内容原样粘贴进去：
{_paste_block(prompt_text,
              ("各版本产出（含版本编号与产出者）", versions_text),
              ("全部盲审意见（按 好/差 标注，含问题定位）", reviews_text))}
{s()} 按 Enter 或点击发送按钮提交。
{s()} {_wait_instruction()}
{_save_block(s, out_path, "AI 给出的候选稿正文")}"""


def build_vote_task(app, prompt_text, candidate_text, out_path, phase_label,
                    gate_label, standard_block="", roster_hint=""):
    """④ 终审投票：对候选稿投「通过 / 不通过」，并给参战 AI 打分（赛马记分榜）。

    用户硬规则：反对票必须附「问题定位卡」四件套，缺件不计票。
    roster_hint：本次参战 AI 名单（供打分用，形如「doubao=豆包、kimi=Kimi、...」）。
    """
    s = _Steps()
    extra = (f"\n赛马打分（必填）：从下列参战 AI 中排除你自己，逐一打 1—10 分并附一句依据：\n"
             f"  {roster_hint}\n") if roster_hint else ""
    return f"""任务：用「{app.get('label')}」对「{gate_label}」的候选稿投出终审票，以 JSON 保存到指定文件。

投票规则（必须遵守）：
  · 投「通过」：候选稿达到本闸全部硬性要求，无 S/A 级问题。
  · 投「不通过」：必须同时给出至少一张「问题定位卡」，四件套缺一不可——
      ① 问题出在哪（程序 › 环节 › 卷 › 章 › 六要素段位 › 场景 › 段，禁止只写章号）
      ② 哪一条出了问题（引用审核标准条目的原文或编号，禁止「节奏不好」这类无源描述）
      ③ 正文关键句（正文里原样存在、可直接搜索到的字串，另附 2—4 个唯一检索词）
      ④ 修改建议（改法方向 + 改动范围，禁止「建议优化」这类空话）
  · 缺任一件的反对票视为无效票，不计入统计。{extra}
步骤：
{s()} {_open_instruction(app)}
{s()} {_new_chat_instruction(app, isolate=True)}
{s()} 点击输入框，按 Ctrl+V，把下面整段内容原样粘贴进去：
{_paste_block(prompt_text,
              ("本闸验收标准", standard_block),
              ("本次参战 AI 名单（打分对象）", roster_hint or "（未提供）"),
              ("待表决的候选稿", candidate_text))}
{s()} 按 Enter 或点击发送按钮提交。
{s()} {_wait_instruction()}
{s()} 只复制 AI 回复中的纯 JSON 部分（从第一个 {{ 到最后一个 }}），按 Ctrl+C 复制。
{_save_block(s, out_path, "AI 回复中的纯 JSON 正文")}"""


def build_probe_task(app, out_path):
