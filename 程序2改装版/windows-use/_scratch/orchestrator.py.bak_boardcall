def _load_phases(cfg, program):
    """优先从 rings_items.json 读该程序的环节清单；读不到则回退 cfg["phases"]。"""
    if RINGS_JSON.exists():
        try:
            rings = json.loads(RINGS_JSON.read_text(encoding="utf-8"))
        except Exception:
            rings = None
        if rings:
            stage_key = STAGE_MAP.get(program)
            if stage_key and stage_key in rings:
                items = rings[stage_key].get("环节", [])
                out = []
                for item in items:
                    d = dict(item)  # 先保留原字段（fields / segment_mode / segment_size 等）
                    d.update({
                        "key": item.get("name") or item.get("code"),
                        "code": item.get("code"),
                        "mode": item.get("type") or "mesh",
                        "stage": program,
                        "supp": False,
                        "desc": item.get("desc", ""),
                    })
                    out.append(d)
                if out:
                    print(f"[rings] 读入 {RINGS_JSON.name} 的 {stage_key}：{len(out)} 环")
                    return out
    return [p for p in cfg["phases"] if p["stage"] == program]


