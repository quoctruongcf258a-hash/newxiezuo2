def keywords_for_phase(cfg, program, phase_cfg):
    """从 apps.json 提取本环节关键词，返回 dict。"""
    out = {"内容词": [], "动作词": [], "禁止词": [], "验收词": [], "红线": []}
    key = phase_cfg.get("key") or phase_cfg.get("name") or ""

    if program == "规划":
        # 优先用 fields（新环有明确字段列表）
        _fields = phase_cfg.get("fields") or []
        if _fields:
            out["内容词"] = [str(f) for f in _fields]
        else:
            # 回退：从 desc 拆（→ 后面是动作）
            _desc = (phase_cfg.get("desc") or "").strip()
            if _desc:
                _head = _desc
                for _sep in ("→", "->", "=>"):
                    if _sep in _head:
                        _head = _head.split(_sep)[0]
                        break
                for _part in re.split(r"[+/、，,；;]+", _head):
                    _p = _part.strip()
                    if _p and not _p.startswith("输出"):
                        out["内容词"].append(_p)

    if program == "写作":
        seg = phase_cfg.get("six_segment") or ""
        for e in (cfg.get("sixElements") or {}).get("elements") or []:
            if e.get("key") == seg:
                kws = e.get("keywords") or ""
                out["内容词"] += [x for x in kws.split("・") if x]
                out["验收词"] += list(e.get("standards") or [])
                out["禁止词"] += list(e.get("failPatterns") or [])
        for r in (cfg.get("sixElements") or {}).get("redLines") or []:
            out["红线"].append(f"{r.get('key')}：{r.get('rule')}")
        craft = phase_cfg.get("craft") or ""
        cat = craft.split("(")[0].strip()
        for c in (cfg.get("writingEnvironment") or {}).get("categories") or []:
            if c.get("key") == cat:
                for it in c.get("items") or []:
                    out["动作词"].append(f"{it.get('key')}：{it.get('check')}")
                    if it.get("坑"):
                        out["禁止词"].append(it["坑"])
                break

    if program == "润色":
        for s in (cfg.get("polishStandard") or {}).get("sections") or []:
            for it in s.get("items") or []:
                out["动作词"].append(f"{it.get('name')}：{it.get('check')}")
        out["禁止词"] += list((cfg.get("polishStandard") or {}).get("pitfalls") or [])

    if program == "质检":
        for n in phase_cfg.get("qcSecs") or []:
            for s in (cfg.get("qcStandard") or {}).get("sections") or []:
                if str(s.get("n")) == str(n):
                    out["内容词"] += list(s.get("items") or [])

    # 每类去重（保持首次出现顺序）
    for _k in list(out.keys()):
        _seen = set()
        _uniq = []
        for _x in out[_k]:
            _s = str(_x)
            if _s not in _seen:
                _seen.add(_s)
                _uniq.append(_x)
        out[_k] = _uniq

    return out


def _upstream_files(program, phase_cfg, chapter=None):
    """返回本环应读取的上游文件路径列表。"""
    _root = _project_root()
    _stage = _STAGE_DIR_MAP.get(program, program)
    _stage_dir = _root / _stage
    ups = []

    # 首个程序（规划）读 00_初始化 的项目信息 + 7 份规划蓝图
    if program == "规划":
        _init_dir = _root / "00_初始化"
        _info = _init_dir / "项目信息.json"
        if _info.exists():
            ups.append(str(_info))
        # 7 份规划蓝图（UI 环节0.5 生成）：1.0_总纲 ~ 1.6_卷纲
        for _bp in ("1.0_总纲.md", "1.1_定位与卖点.md", "1.2_故事核心主题.md",
                    "1.3_人物系统.md", "1.4_世界观与设定.md",
                    "1.5_结构与节奏.md", "1.6_卷纲.md"):
            _fp = _init_dir / _bp
            if _fp.exists():
                ups.append(str(_fp))

    # 读前面环的 phase_candidate.md（按 rings_items.json 顺序）
    try:
        import json as _json
        if RINGS_JSON.exists():
            _rings = _json.loads(RINGS_JSON.read_text(encoding="utf-8"))
            _stage_key = {"规划": "01_规划", "写作": "02_写作",
                          "润色": "03_去AI", "质检": "04_审核"}.get(program, "")
            _items = _rings.get(_stage_key, {}).get("环节", [])
            _order = [x.get("name") or x.get("code") for x in _items]
            _cur = phase_cfg.get("key") or phase_cfg.get("name")
            if _cur in _order:
                _idx = _order.index(_cur)
                for _prev in _order[:_idx]:
                    fp = _stage_dir / _prev / "phase_candidate.md"
                    if fp.exists():
                        ups.append(str(fp))
    except Exception:
        pass

    # 章循环：读上一章产物
    if chapter and program in ("写作", "润色", "质检"):
        try:
            _prev_ch = str(int(chapter) - 1).zfill(4)
            _prev_dir = _root / "02_写作" / f"ch{_prev_ch}"
            if _prev_dir.exists():
                for _fp in _prev_dir.rglob("phase_candidate.md"):
                    ups.append(str(_fp))
        except Exception:
            pass

    return ups


def phase_dir(program, chapter, phase_key):
    """_PROJECT_ROOT：产物写到 output/<项目名>/<阶段目录>/<环名>/"""
    _stage = _STAGE_DIR_MAP.get(program, program)
    d = _project_root() / _stage
    if chapter:
        d = d / f"ch{chapter}"
    return d / phase_key


