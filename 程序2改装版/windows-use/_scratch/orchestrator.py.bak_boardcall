def phase_input(cfg, program, phase_cfg, chapter) -> str:
    """为某环节准备输入材料：上游产物 + 平台约束 + 前情。"""
    parts = []

    # _UPSTREAM_PATHS：注入读取路径 + 完成判定
    _ups = _upstream_files(program, phase_cfg, chapter)
    _out_dir = phase_dir(program, chapter, phase_cfg["key"])
    _read_block = "【读取资料（逐字读，唯一依据）】"
    if _ups:
        for _f in _ups:
            _read_block += f"\n  · {_f}"
        # 注入上游文件内容（长文件截断，防止 prompt 爆炸）
        _read_block += "\n\n【上游文件内容（已注入，可直接引用）】"
        _MAX = 4000
        for _f in _ups:
            try:
                _fp = Path(_f)
                if not _fp.exists() or not _fp.is_file():
                    continue
                _content = _fp.read_text(encoding="utf-8", errors="ignore")
                if len(_content) > _MAX:
                    _content = _content[:_MAX] + f"\n…（已截断，全文 {len(_content)} 字，请读源文件）"
                _read_block += f"\n\n--- {_fp.name} ---\n{_content}"
            except Exception:
                pass
    else:
        _read_block += "\n  （本环是第一个环节，无上游产物）"
    _read_block += (
        "\n\n【本环节输出路径（写到这里才算完成）】"
        f"\n  {_out_dir / 'versions' / (phase_cfg['key'] + '__<你的名字>.md')}"
        "\n\n【完成判定】"
        "\n  任务完成 = 下列全部满足："
        "\n    1. 文件已保存到上面「输出路径」"
        "\n    2. 文件内容非空（≥200 字）"
        "\n    3. 严格按【输出格式要求】执行"
        "\n    4. 只输出本块成品，不越界"
    )
    parts.append(_read_block)

    # _INJECT_DESC：注入本环节的任务说明（来自 rings_items.json 的 desc）
    _desc = (phase_cfg.get("desc") or "").strip()
    _name = phase_cfg.get("key") or phase_cfg.get("name") or ""
    if _desc:
        _task_block = f"【本环节任务说明：{_name}】\n{_desc}"
        # 从 apps.json 的 auditDirections 找本环归属方向，附上验收标准
        try:
            _dirs = cfg.get("auditDirections") or []
            for _d in _dirs:
                _rings = list(_d.get("rings") or []) + list(_d.get("extends") or [])
                if _name in _rings:
                    _std = _d.get("standards") or []
                    _fail = _d.get("failPatterns") or []
                    if _std:
                        _task_block += "\n\n【本方向审核标准（逐条满足）】"
                        for _s in _std:
                            _task_block += f"\n  □ {_s}"
                    if _fail:
                        _task_block += "\n\n【反模式（命中即判不合格）】"
                        for _f in _fail:
                            _task_block += f"\n  ✗ {_f}"
                    break
        except Exception:
            pass
        parts.append(_task_block)

    # _KEYWORDS：注入本环节关键词（从 apps.json 自动提取）
    try:
        _kw = keywords_for_phase(cfg, program, phase_cfg)
        _kb = "【本环节关键词（落笔时逐条对照）】"
        _has = False
        if _kw["内容词"]:
            _kb += "\n  内容词：" + "、".join(_kw["内容词"][:30])
            _has = True
        if _kw["动作词"]:
            _kb += "\n  动作词：" + "、".join(_kw["动作词"][:30])
            _has = True
        if _kw["红线"]:
            _kb += "\n  红线：" + "、".join(_kw["红线"])
            _has = True
        if _has:
            parts.append(_kb)
    except Exception:
        pass
    pb = platform_block(cfg)
    if pb:
        parts.append(pb)

    prev = (WORK / program / (f"ch{chapter}" if chapter else "") / "_context.md")
    if prev.exists():
        parts.append("【前情/上游产物】\n" + read_text(prev))

    if program == "写作" and chapter:
        locked = WORK / "规划" / "章纲" / "phase_candidate.md"
        if locked.exists():
            parts.append("【本章章纲（锁定）】\n" + read_text(locked))
        lib = WORK / "library"
        if lib.exists():
            recent = sorted(lib.glob("*.md"))[-2:]
            if recent:
                parts.append("【最近已入库章节（承接用）】\n"
                             + "\n\n".join(read_text(p) for p in recent))
    if program == "写作":
        eb = env_block(cfg, phase_cfg.get("craft"))
        if eb:
            parts.append(eb)
    if program == "润色" and chapter:
        body = WORK / "写作" / f"ch{chapter}" / "正文" / "phase_candidate.md"
        if body.exists():
            parts.append("【待润色正文】\n" + read_text(body))
    if program == "质检" and chapter:
        pol = WORK / "润色" / f"ch{chapter}" / "润色" / "phase_candidate.md"
        if pol.exists():
            parts.append("【已润色定稿】\n" + read_text(pol))
    if not parts:
        parts.append("（无上游材料，请依据指令中的标准自行推进）")
    return "\n\n".join(parts)


