def _parse_volumes():
    """从 00_初始化/1.6_卷纲.md 解析卷划分，返回 [(卷名, 起章, 止章), ...]。
    匹配形如：## 第一卷：...（第1-30章）"""
    import re
    p = _project_root() / "00_初始化" / "1.6_卷纲.md"
    if not p.exists():
        return []
    text = p.read_text(encoding="utf-8", errors="ignore")
    out = []
    for m in re.finditer(r"##\s*(第[一二三四五六七八九十百]+卷)[：:][^\n]*?第\s*(\d+)\s*[-—～~]\s*(\d+)\s*章", text):
        out.append((m.group(1), int(m.group(2)), int(m.group(3))))
    return out


def chunks_for_phase(cfg, program, phase_cfg) -> list:
    """把一个环节切成若干「块」。返回 [(chunk_id, chunk_label, standard_block), ...]

    规划：环节即块（desc 作为说明）；P16 volume 按卷纲切，P17 chapters 按 segment_size 切
    写作：分布/正文 按六要素切 6 块；其余环节单块
    润色：按 4 节切
    质检：按 qcSecs 每节一块
    """
    key = phase_cfg["key"]

    # P16：按卷切（从 1.6_卷纲.md 读真实区间）
    if phase_cfg.get("segment_mode") == "volume":
        vols = _parse_volumes()
        if vols:
            return [(v[0], f"{v[0]}（第{v[1]}-{v[2]}章）", "") for v in vols]
        # 兜底：从 cfg 读卷数
        n = cfg.get("卷数") or 3
        total = cfg.get("章节数") or 150
        per = total // n
        out = []
        for i in range(n):
            s = i * per + 1
            e = (i + 1) * per if i < n - 1 else total
            out.append((f"V{i+1}", f"第{i+1}卷（{s}-{e}章）", ""))
        return out

    # P17：按 segment_size 章一段切
    if phase_cfg.get("segment_mode") == "chapters":
        size = phase_cfg.get("segment_size") or 30
        total = cfg.get("章节数") or 150
        out = []
        for s in range(0, total, size):
            e = min(s + size, total)
            out.append((f"{s+1}-{e}", f"{s+1}-{e}章", ""))
        return out
    if program == "写作" and phase_cfg.get("six"):
        els = (cfg.get("sixElements") or {}).get("elements") or []
        return [(e["key"], f"六要素·{e['key']}", six_standard(cfg, e["key"])) for e in els]
    if program == "润色":
        secs = (cfg.get("polishStandard") or {}).get("sections") or []
        return [(_polish_no(s), s.get("key", ""), polish_standard(cfg, [_polish_no(s)]))
                for s in secs]
    if program == "质检" and phase_cfg.get("qcSecs"):
        out = []
        for n in phase_cfg["qcSecs"]:
            out.append((str(n), f"{n}", qc_standard(cfg, [n])))
        return out
    if program == "规划":
        return [(key, key, plan_direction_standard(cfg, key))]
    return [(key, key, "")]


