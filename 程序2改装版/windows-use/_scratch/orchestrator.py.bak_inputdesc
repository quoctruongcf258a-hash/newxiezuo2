def do_produce(agent, sess, app, program, phase_cfg, chunk_id, chunk_label,
               input_text, out_dir, dry, extra_note="", ai_assist=False):
    """① 产出：一名 AI 产出一版。"""
    out = Path(out_dir) / "versions" / f"{chunk_id}__{app['key']}.md"
    label = f"{program} › {phase_cfg['key']}"
    tpl = compose_prompt("PROMPT_PRODUCE.md", program)
    note = format_note(program, phase_cfg)
    if extra_note:
        note = (note + "\n\n【上一轮终审反对意见（必须逐条对应处理）】\n" + extra_note).strip()
    if ai_assist:
        task = tasks_mod.build_scaffold_task(app, tpl, input_text, str(out), label)
    else:
        task = tasks_mod.build_produce_task(app, tpl, input_text, str(out), label,
                                            chunk_label, note)
    ok = run_task(agent, task, dry, title=f"产出 | {app['label']} | {label} | {chunk_label}", app=app)
    if ok and not dry:
        wait_file(out)
    return out


def do_review(agent, sess, app, program, phase_cfg, chunk_id, chunk_label,
              target_path, out_dir, dry, std=None):
    """② 盲审：其余 AI 隔离评审某一版，输出 JSON。

    std 为该块的审核标准（由 chunks_for_phase 给出）；未给则按程序回退取全集。
    """
    tgt = read_text(target_path)
    if not tgt.strip():
        return None
    out = Path(out_dir) / "reviews" / f"{chunk_id}__{Path(target_path).stem}__{app['key']}.json"
    label = f"{program} › {phase_cfg['key']}"
    if std is None:
        if program == "规划":
            std = plan_direction_standard(agent_cfg, phase_cfg["key"])
        elif program == "写作":
            std = six_standard(agent_cfg, None)
        elif program == "润色":
            std = polish_standard(agent_cfg, None)
        elif program == "质检":
            std = qc_standard(agent_cfg, phase_cfg.get("qcSecs"))
    task = tasks_mod.build_review_task(app, compose_prompt("PROMPT_REVIEW.md", program), tgt,
                                       str(out), label, std, chunk_label)
    ok = run_task(agent, task, dry, title=f"盲审 | {app['label']} | {label} | {chunk_label}", app=app)
    if ok and not dry:
        wait_file(out)
    return out


def do_merge(agent, sess, app, program, phase_cfg, chunk_id, chunk_label,
             version_paths, review_paths, out_dir, dry, extra_issues=""):
    """③ 拼接：指定拼接者按段落级择优拼出候选稿。"""
    label = f"{program} › {phase_cfg['key']}"
    vtext = []
    for i, p in enumerate(version_paths, 1):
        t = read_text(p)
        if t.strip():
            vtext.append(f"── 版本{i}（产出者：{Path(p).stem.split('__')[-1]}）──\n{t}")
    rtext = []
    for p in review_paths:
        if not p:
            continue
        t = read_text(p)
        if t.strip():
            rtext.append(f"── 评审（{Path(p).stem}）──\n{t}")
    if extra_issues:
        rtext.append("── 上一轮终审反对意见（本轮必须逐条处理）──\n" + extra_issues)
    out = Path(out_dir) / "merged" / f"{chunk_id}.md"
    task = tasks_mod.build_merge_task(app, compose_prompt("PROMPT_MERGE.md", program),
                                      "\n\n".join(vtext), "\n\n".join(rtext),
                                      str(out), label, chunk_label)
    ok = run_task(agent, task, dry, title=f"拼接 | {app['label']} | {label} | {chunk_label}", app=app)
    if ok and not dry:
        wait_file(out)
    return out


