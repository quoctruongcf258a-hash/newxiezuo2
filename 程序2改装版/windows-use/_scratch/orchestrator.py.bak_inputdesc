def _extract_prompt(task_text):
    """从 SOP 里抠出『指令开始...指令结束』之间的正文。"""
    i = task_text.find("===== 指令开始 =====")
    j = task_text.find("===== 指令结束 =====")
    if i >= 0 and j > i:
        return task_text[i + len("===== 指令开始 ====="):j].strip()
    return task_text


def run_task(agent, task_text, dry=False, title="", app=None):
    """_CDP_FIRST：优先走 CDP（app 有 cdpPort），失败/无端口才回退 windows_use。"""
    print("\n" + "─" * 74)
    if title:
        print(f"[{title}]")
    print(task_text)
    print("─" * 74)
    if dry:
        print("[dry-run] 未实际驱动。")
        return True

    # ── CDP 分支 ──
    cdp_port = (app or {}).get("cdpPort")
    if cdp_port:
        try:
            import sys as _sys
            _wu = HERE.parent
            if str(_wu) not in _sys.path:
                _sys.path.insert(0, str(_wu))
            from mix_send import send as _cdp_send
            prompt = _extract_prompt(task_text)
            label = (app or {}).get("label") or (app or {}).get("key") or ""
            print(f"[CDP] 发送到 {label}（端口 {cdp_port}），prompt {len(prompt)} 字")
            r = _cdp_send(label, prompt)
            print(f"[CDP] 返回：{r}")
            return True
        except Exception as e:                 # noqa: BLE001
            print(f"[CDP 失败] {e}，回退 windows_use")

    # ── windows_use 分支 ──
    if agent is None:
        print("[错误] agent=None 且该 AI 无 cdpPort，无法执行")
        return False
    try:
        agent.invoke(task=task_text)
        return True
    except Exception as e:                     # noqa: BLE001
        print(f"[错误] Windows-Use 执行失败：{e}")
        return False


def wait_file(p, timeout=180):
    p = Path(p)
    t0 = time.time()
    while time.time() - t0 < timeout:
        if p.exists() and p.stat().st_size > 0:
            return True
        time.sleep(5)
    return p.exists() and p.stat().st_size > 0


# ════════════════════════════ 审核标准提取 ════════════════════════════

def _fmt_lines(items, bullet="  · ") -> str:
    return "\n".join(f"{bullet}{x}" for x in items)


def _item_line(it, indent="  - ") -> str:
    """兼容渲染：标准条目可能是纯字符串，也可能是 {n,name/key,check} 对象。"""
    if isinstance(it, str):
        return f"{indent}{it}"
    if isinstance(it, dict):
        no = it.get("n") or ""
        name = it.get("name") or it.get("key") or ""
        check = it.get("check") or it.get("desc") or ""
        head = f"{indent}{no} {name}".rstrip()
        return f"{head}：{check}" if check else head
    return f"{indent}{it}"


def _polish_no(section: dict) -> str:
    """润色节编号：有 n 用 n，否则从 key（如「一、润色前准备」）里取前缀。"""
    if section.get("n"):
        return str(section["n"])
    k = str(section.get("key", ""))
    return k.split("、")[0] if "、" in k else k


def platform_block(cfg) -> str:
    """番茄平台硬约束，注入每一次产出与盲审。"""
    p = cfg.get("platform") or {}
    if not p:
        return ""
    cs = p.get("chapterSpec") or {}
    parts = ["【平台硬约束（番茄）——任何产出都不得违反】"]
    for k in ("开篇", "单章字数", "钩子密度", "视角", "称谓"):
        if cs.get(k):
            parts.append(f"  · {k}：{cs[k]}")
    if p.get("metrics", {}).get("核心指标"):
        parts.append(f"  · 核心指标：{'、'.join(p['metrics']['核心指标'])}")
    # _NO_AI_POLICY：AI 政策行已去掉（用户要求）
    return "\n".join(parts)


def plan_direction_standard(cfg, phase_key: str) -> str:
    """给规划某个环节，找出它归属的八方向，返回该方向的审核标准。"""
    dirs = cfg.get("auditDirections") or []
    hit = None
    for d in dirs:
        rings = list(d.get("rings") or []) + list(d.get("extends") or [])
        if phase_key in rings:
            hit = d
            break
    if not hit:
        # 兜底：把全部方向标准都给（用于收口环节）
        return "\n\n".join(_dir_text(d) for d in dirs)
    return _dir_text(hit)


def _dir_text(d: dict) -> str:
    s = [f"方向：{d.get('key', '')}"]
    if d.get("questions"):
        s.append("要回答：" + " / ".join(d["questions"]))
    if d.get("standards"):
        s.append("审核标准（逐条打勾）：")
        s.append(_fmt_lines(d["standards"], "  □ "))
    if d.get("failPatterns"):
        s.append("不合格表现（命中即判不通过）：")
        s.append(_fmt_lines(d["failPatterns"], "  ✗ "))
    return "\n".join(s)


def six_standard(cfg, element_key=None) -> str:
    """六要素审核标准（写作程序）。element_key 给了就只给该要素。"""
    se = cfg.get("sixElements") or {}
    els = se.get("elements") or []
    out = ["【写作审核框架：六要素（始・显・通・动・成・终）】"]
    for e in els:
        if element_key and e.get("key") != element_key:
            continue
        out.append(f"\n■ {e.get('key')}（{e.get('name', '')}）")
        if e.get("action"):
            out.append(f"  创作动作：{e['action']}")
        if e.get("keywords"):
            out.append(f"  关键词：{'・'.join(e['keywords'])}")
        if e.get("standards"):
            out.append("  审核要点：")
            out.append(_fmt_lines(e["standards"], "    □ "))
        if e.get("failPatterns"):
            out.append("  不合格表现：")
            out.append(_fmt_lines(e["failPatterns"], "    ✗ "))
    if se.get("redLines"):
        out.append("\n【四条红线（命中即不通过）】")
        for r in se["redLines"]:
            out.append(f"  ✗ {r.get('key')}：{r.get('rule', '')}")
    return "\n".join(out)


def polish_standard(cfg, section_nos=None) -> str:
    """润色标准（程序三）。section_nos 给了就只取那几节。"""
    ps = cfg.get("polishStandard") or {}
    out = []
    for s in ps.get("sections", []):
        if section_nos and _polish_no(s) not in section_nos:
            continue
        out.append(f"■ {s.get('key', '')}")
        if s.get("note"):
            out.append(f"  （{s['note']}）")
        for it in s.get("items", []):
            out.append(_item_line(it))
            if isinstance(it, dict):
                for sub in (it.get("subs") or []):
                    out.append(f"      · {sub}")
    if not section_nos:
        acc = ps.get("acceptance") or {}
        for k, v in acc.items():
            out.append(f"\n【验收清单·{k}】")
            out.append(_fmt_lines(v, "  □ "))
        if ps.get("pitfalls"):
            out.append("\n【常见坑】")
            out.append(_fmt_lines(ps["pitfalls"], "  ⚠ "))
    return "\n".join(out)


def qc_standard(cfg, section_nos=None) -> str:
    """质检标准（程序四）。section_nos 给了就只取那几节。"""
    q = cfg.get("qcStandard") or {}
    out = []
    for s in q.get("sections", []):
        if section_nos and str(s.get("n")) not in [str(x) for x in section_nos]:
            continue
        out.append(f"■ {s.get('n', '')} {s.get('key', '')}")
        for it in s.get("items", []):
            out.append(_item_line(it))
    if q.get("severity") and not section_nos:
        out.append("\n【严重程度分级】")
        for k, v in q["severity"].items():
            out.append(f"  {k}：{v}")
    return "\n".join(out)


def env_block(cfg, craft_str) -> str:
    """写作程序专用：把 writingEnvironment 里对应类别的技法条注入 prompt。

    craft_str 例："落笔技术类(7-13)" → 取 "落笔技术类"。
    「写作模式类」无论哪个环节都注入（每章选一种写法）。
    """
    we = cfg.get("writingEnvironment") or {}
    cats = we.get("categories") or []
    if not cats:
        return ""
    cat_name = str(craft_str or "").split("(")[0].strip()
    out = ["【本环节适用的写作技法（逐条落实，坑要主动规避）】"]
    for c in cats:
        if c["key"] != cat_name and c["key"] != "写作模式类":
            continue
        out.append(f"\n■ {c['key']}")
        for it in c.get("items", []):
            line = f"  {it.get('n', '')}. {it['key']}：{it.get('check', '')}"
            out.append(line)
            for k in ("坑", "原则", "适合"):
                if it.get(k):
                    out.append(f"       {k}：{it[k]}")
    return "\n".join(out)


# ════════════════════════════ 块切分 ════════════════════════════

def chunks_for_phase(cfg, program, phase_cfg) -> list:
    """把一个环节切成若干「块」。返回 [(chunk_id, chunk_label, standard_block), ...]

    规划：环节即块（desc 作为说明）
    写作：分布/正文 按六要素切 6 块；其余环节单块
    润色：按 4 节切
    质检：按 qcSecs 每节一块
    """
    key = phase_cfg["key"]
    if program == "写作" and phase_cfg.get("six"):
        els = (cfg.get("sixElements") or {}).get("elements") or []
        return [(e["key"], f"六要素·{e['key']}", six_standard(cfg, e["key"])) for e in els]
    if program == "润色":
        secs = (cfg.get("polishStandard") or {}).get("sections") or []
        return [(_polish_no(s), s.get("key", ""), polish_standard(cfg, [_polish_no(s)]))
                for s in secs]
    if program == "质检" and phase_cfg.get("qcSecs"):
        out = []
        for n in phase_cfg["qcSecs"]:
            out.append((str(n), f"{n}", qc_standard(cfg, [n])))
        return out
    if program == "规划":
        return [(key, key, plan_direction_standard(cfg, key))]
    return [(key, key, "")]


