def _upstream_candidate(program, chapter):
    """找某个程序编排时应对其投票的上游定稿。

    质检程序按你的流程：质检汇总 → 成书检验 → 上架前低级错误检查 → 入库 → 推演下一章。
    故成书检验的表决对象是「质检汇总」的产物（缺失时退到润色定稿），
    绝不能退到「推演下一章」——那是入库之后的下一章准备，不属于本章待检对象。
    """
    base = f"ch{chapter}" if chapter else ""
    if program == "质检":
        for cand in (
            WORK / "质检" / base / "质检汇总" / "phase_candidate.md",
            WORK / "润色" / base / "润色" / "phase_candidate.md",
        ):
            if cand.exists():
                return cand
    d = WORK / program / base
    cands = sorted(d.glob("*/phase_candidate.md"))
    return cands[-1] if cands else (d / "phase_candidate.md")


# 只投票、不产出的环节（对上游定稿做闸门判定）
GATE_ONLY_PHASES = ("成书检验",)


def run_program(agent, cfg, sess, program, chapter, dry, only_phase=None,
                once=False, max_loop=2):
    phases = _load_phases(cfg, program)
    if not phases:
        print(f"[错误] apps.json 里没有程序「{program}」的环节。")
        return
    if only_phase:
        phases = [p for p in phases if p["key"] == only_phase]
        if not phases:
            print(f"[错误] 程序「{program}」下没有环节「{only_phase}」。")
            return

    print("\n" + "█" * 74)
    print(f"█ 程序：{program}　环节数：{len(phases)}　章：{chapter or '（一次性）'}")
    print(f"█ 出口闸：{PROGRAM_GATES[program]}")
    print("█" * 74)

    for ph in phases:
        if ph.get("mode") == "human":
            print(f"\n▶ 环节「{ph['key']}」为【人工定·AI 辅助】，跳过自动网格。")
            print(f"   说明：{ph.get('desc', '')}")
            print(f"   请在 {WORK / program / ph['key']} 放置人工定稿，或让 AI 出候选后自行拍板。")
            continue
        if ph.get("mode") == "storage":
            _do_storage(cfg, program, chapter, dry)
            if program == "质检":
                # 入库之后、推演下一章之前：按期连贯性综合复检
                run_periodic_recheck(agent, cfg, sess, chapter, dry, once)
            continue
        if ph["key"] in GATE_ONLY_PHASES:
            up = _upstream_candidate(program, chapter)
            print(f"\n▶ 环节「{ph['key']}」为【只投票·不产出】，直接对上游定稿表决：{up}")
            run_gate(agent, cfg, sess, program, up, chapter, dry, max_loop)
            continue

        inp = phase_input(cfg, program, ph, chapter)
        cand = run_mesh_phase(agent, cfg, sess, program, ph, chapter, inp, dry, once=once)
        if ph.get("finalGate"):
            run_gate(agent, cfg, sess, program, cand, chapter, dry, max_loop)

    # 程序出口闸
    if not only_phase:
        run_gate(agent, cfg, sess, program,
                 _upstream_candidate(program, chapter), chapter, dry, max_loop)


def _chapter_num(chapter):
    try:
        return int(str(chapter).lstrip("0") or "0")
    except Exception:                              # noqa: BLE001
        return 0


def _recheck_input(cfg, chapter, scope_key) -> str:
    """组装配检材料：平台约束 + 待检正文（近 10 章或全文）+ 已锁章纲。"""
    parts = []
    pb = platform_block(cfg)
    if pb:
        parts.append(pb)
    lib = WORK / "library"
    if lib.exists():
        files = sorted(lib.glob("*.md"))
        if scope_key.startswith("近"):
            files = files[-10:]
        if files:
            parts.append(f"【待复检正文（{scope_key}，共 {len(files)} 章）】\n"
                         + "\n\n".join(f"── {p.name} ──\n{read_text(p)}" for p in files))
    locked = WORK / "规划" / "章纲" / "phase_candidate.md"
    if locked.exists():
        parts.append("【已锁章纲（对照主线是否跑偏）】\n" + read_text(locked))
    if not parts:
        parts.append("（尚无已入库正文，复检为空跑）")
    return "\n\n".join(parts)


def run_periodic_recheck(agent, cfg, sess, chapter, dry, once=False, force=False):
    """每 N 章连贯性综合复检（入库之后、推演下一章之前触发）。

    只复盘、不出稿、不投票：输出带优先级的「问题定位卡」清单，交作者裁定。
    force=True 时忽略「章号是否为 N 的倍数」，手动跑一次。
    """
    pr = cfg.get("periodicRecheck") or {}
    if not pr or not chapter:
        return None
    every = int((pr.get("trigger") or {}).get("every") or 10)
    n = _chapter_num(chapter)
    if not force and (n <= 0 or n % every):
        return None

    print("\n" + "★" * 74)
    print(f"★ 每 {every} 章 · 连贯性综合复检（第 {n} 章入库后触发）")
    print(f"★ 参与：全员 {len(sess['participants'])} 人；输出问题定位卡交作者裁定，不自动改稿")
    print("★" * 74)

    out_root = WORK / "质检" / f"ch{chapter}" / "_recheck"
    reports = []
    for scope in pr.get("scopes", []):
        skey = scope.get("key", "复检")
        checks = scope.get("checks", [])
        std = ("【本范围的检查项（逐条核对，不得增删）】\n"
               + "\n".join(f"  □ {c}" for c in checks)
               + "\n\n【严重度】" + "；".join(
                   f"{k}={v}" for k, v in (pr.get("output", {}).get("priorityLevels") or {}).items())
               + "\n\n【输出格式】逐条给出问题定位卡：\n"
                 "  ① 位置（程序 › 环节 › 卷 › 章 › 六要素段位 › 场景 › 第N段）\n"
                 "  ② 命中条目（违反的标准/设定/伏笔编号）\n"
                 "  ③ 正文关键句（原样可搜字串 + 2—4 个唯一检索词）\n"
                 "  ④ 修改建议（改法方向 + 改动范围）\n"
                 "  另附：优先级（P0/P1/P2/P3）与影响范围。")
        pcfg = {"key": f"复检·{skey}"}
        inp = _recheck_input(cfg, chapter, skey)
        cand = run_mesh_phase(agent, cfg, sess, "质检", pcfg, chapter, inp, dry,
                              once=once, custom_chunks=[(skey, skey, std)])
        reports.append((skey, cand))

    if dry:
        print(f"[dry-run] 复检报告将写入 {out_root / 'recheck_report.md'}")
        return None

    body = [f"# 第 {n} 章 · 每 {every} 章连贯性综合复检报告",
            f"\n触发：第 {n} 章入库后（下一章写作前）　参与：全员 {len(sess['participants'])} 人",
            "\n> 作者裁定：逐卡三选一 —— 改（按类型回对应程序返修）／不改（留档，不阻断更新）／延后。",
            "\n> AI 只出定位卡与建议，不代替作者决定。已发布正文除非作者确认否则不回改。\n"]
    for skey, cand in reports:
        body.append(f"\n## {skey}\n")
        body.append(read_text(cand).strip() or "（无内容）")
    out = out_root / "recheck_report.md"
    write_text(out, "\n".join(body))
    print(f"✔ 复检报告已出：{out}")
    print("  请人工过一遍定位卡，逐张三选一（改 / 不改 / 延后）。")
    return out


def _do_storage(cfg, program, chapter, dry):
    base = f"ch{chapter}" if chapter else ""
    d = WORK / program / base
    src = d / "上架前低级错误检查" / "phase_candidate.md"
    if not src.exists():
        # 回退时排除「推演下一章」——那是下一章的输入，不是本章定稿
        cands = [p for p in sorted(d.glob("*/phase_candidate.md"))
                 if "推演下一章" not in str(p)]
        src = cands[-1] if cands else None
    dst = WORK / "library" / (f"第{chapter}章.md" if chapter else "成书.md")
    if dry:
        print(f"[dry-run] 入库：{src} → {dst}")
        return
    if src and src.exists():
        write_text(dst, read_text(src))
        print(f"✔ 已入库：{dst}")
    else:
        print("[警告] 找不到可入库的定稿。")


def main():
    ap = argparse.ArgumentParser(description="多 AI 协作写作流水线 · 四程序编排")
    ap.add_argument("--program", choices=["规划", "写作", "润色", "质检"])
    ap.add_argument("--chapter", default="", help="章号，如 0057（规划程序可不填）")
    ap.add_argument("--phase", default="", help="只跑该程序下的某一个环节")
    ap.add_argument("--dry-run", action="store_true", help="只打印任务不驱动")
    ap.add_argument("--loop", type=int, default=2, help="出口闸最大回改轮数")
    ap.add_argument("--once", action="store_true", help="每环节只让 1 名 AI 产出（省额度试跑）")
    ap.add_argument("--check-session", action="store_true", help="只校验今日阵容")
    ap.add_argument("--probe", action="store_true", help="探测今日阵容可用性")
    ap.add_argument("--recheck", action="store_true",
                    help="手动触发一次按期连贯性复检（配合 --chapter）")
    ap.add_argument("--board", nargs="?", const="ALL", default=None, metavar="程序",
                    help="查看赛马记分榜（可带程序名过滤，如 --board 写作）")
    args = ap.parse_args()

    if args.board:
        prog = None if args.board == "ALL" else args.board
        board_mod.show(prog)
        print()
        board_mod.show_crown(prog)
        print()
        board_mod.show_best_at(prog)
        return

    cfg = load_cfg()
    global agent_cfg
    agent_cfg = cfg

    roster = session_mod.load_roster()
    today = session_mod.load_today()
    sess = session_mod.resolve(roster, today,
                               program=args.program, phase=args.phase or None,
                               chapter=args.chapter or None)

    if args.check_session:
        ok = cmd_check_session(cfg, sess)
        sys.exit(0 if ok else 1)

    if not sess["participants"]:
        print("[错误] 今日阵容为空。先用 `python session.py show` 登记今天打开了哪些 AI。")
        sys.exit(1)

    agent = None
    if not args.dry_run:
        try:
            agent = get_agent()
        except Exception as _e:
            print(f"[警告] windows_use agent 初始化失败（{_e}）")
            print("       若所有 AI 都走 CDP，可继续运行；否则需要 Ollama。")
            agent = None

    if args.probe:
        cmd_probe(agent, cfg, sess, args.dry_run)
        return

    if args.recheck:
        if not args.chapter:
            print("[错误] --recheck 需要配合 --chapter 指定刚入库的章号。")
            sys.exit(1)
        run_periodic_recheck(agent, cfg, sess, args.chapter, args.dry_run, force=True)
        return

    if not args.program:
        print("[提示] 未指定 --program。可用的程序：规划 / 写作 / 润色 / 质检")
        print("       例：python orchestrator.py --program 写作 --chapter 0057 --dry-run")
        cmd_check_session(cfg, sess)
        return

    run_program(agent, cfg, sess, args.program, args.chapter or None,
                args.dry_run, args.phase or None, args.once, args.loop)
    print("\n编排结束。")


if __name__ == "__main__":
    main()
