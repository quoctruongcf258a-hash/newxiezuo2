# 需要带「写作硬指标」的程序（规划程序不必带，省 token）
HARD_RULE_PROGRAMS = ("写作", "润色", "质检")


def compose_prompt(base_name: str, program: str) -> str:
    """基础 prompt + 按程序附带的固定件（硬指标）。"""
    p = load_prompt(base_name)
    if program in HARD_RULE_PROGRAMS:
        hr = load_prompt("PROMPT_HARD_RULES.md")
        if hr.strip():
            p = p.rstrip() + "\n\n---\n\n" + hr
    return p


def format_note(program, phase_cfg) -> str:
    """为产出环节指定输出格式（写进 prompt 的【输出格式要求】）。"""
    key = phase_cfg.get("key", "")
    if program == "规划":
        return "输出结构化条目（`字段名：内容`），像一份可直接归档的设定表或清单。"
    if program == "写作":
        if key == "章前对齐卡":
            return ("输出一张对齐卡，字段固定：视角 / 视角人物 / 视角限制 / 本章释放信息 / "
                    "本章隐藏信息 / 本章误导信息 / 本章伏笔信息 / 场景进出方式 / 章首方式 / "
                    "章末钩子类型 / 平台红线 / 本块目标。")
        if key == "分布":
            return ("输出分镜式条目，每条一行：`段序 | 目标字数 | 发生了什么 | 关键词 | "
                    "六要素归属 | 自检红线`。")
        if key == "正文":
            return "输出连贯的正文段落，不带任何标注、不加小节标题、不写解释与总结。"
        if key == "章内节奏自检":
            return ("输出自检表，字段：断点位置 / 四条红线是否命中 / 章末钩强度（1—10）/ "
                    "留白比例 / 待改条目（含定位卡四件套）。")
    if program == "润色":
        return "输出润色后的**完整文本**，不要输出修改说明、不要输出对照表。"
    if program == "质检":
        return ("输出问题清单，每条含：位置 / 命中条目 / 正文关键句 / 修改建议 / 严重度（S/A/B/C）。"
                "若是质检汇总或成书检验环节，改为输出 JSON。")
    return ""


