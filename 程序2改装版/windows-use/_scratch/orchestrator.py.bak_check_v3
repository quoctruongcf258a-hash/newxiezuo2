]


def load_stage_assignments():
    for _p in STAGE_BOARD_PATHS:
        if _p.exists():
            try:
                _d = json.loads(_p.read_text(encoding="utf-8"))
                return _d.get("assignments", {}) or {}
            except Exception:
                pass
    return {}


def _name_to_key(name, participants):
    if not name:
        return None
    for _p in participants:
        if _p.get("label") == name or _p.get("key") == name:
            return _p["key"]
    return (name or "").lower().replace(" ", "_")


def _names_to_parts(names, participants):
    if isinstance(names, str):
        names = [names] if names else []
    out, seen = [], set()
    for _n in (names or []):
        _k = _name_to_key(_n, participants)
        if not _k or _k in seen:
            continue
        for _p in participants:
            if _p["key"] == _k:
                out.append(_p)
                seen.add(_k)
                break
    return out


# 程序名 → rings_items.json 里的阶段键
STAGE_MAP = {
    "规划": "01_规划",
    "写作": "02_写作",
    "润色": "03_去AI",
    "质检": "04_审核",
    "出厂": "05_出厂",
}


def _load_phases(cfg, program):
    """优先从 rings_items.json 读该程序的环节清单；读不到则回退 cfg["phases"]。"""
    if RINGS_JSON.exists():
        try:
            rings = json.loads(RINGS_JSON.read_text(encoding="utf-8"))
        except Exception:
            rings = None
        if rings:
            stage_key = STAGE_MAP.get(program)
            if stage_key and stage_key in rings:
                items = rings[stage_key].get("环节", [])
                out = []
                for item in items:
                    d = dict(item)  # 先保留原字段（fields / segment_mode / segment_size 等）
                    # 兜底：有 fields 或 segment_mode 的环节一律走 mesh（不是 fixed）
                    _m = item.get("type") or "mesh"
                    if _m == "fixed" and (item.get("fields") or item.get("segment_mode")):
                        _m = "mesh"
                    d.update({
                        "key": item.get("name") or item.get("code"),
                        "code": item.get("code"),
                        "mode": _m,
                        "stage": program,
                        "supp": False,
                        "desc": item.get("desc", ""),
                    })
                    out.append(d)
                if out:
                    print(f"[rings] 读入 {RINGS_JSON.name} 的 {stage_key}：{len(out)} 环")
                    return out
    return [p for p in cfg["phases"] if p["stage"] == program]


