# orchestrator.py — 多 AI 协作写作流水线 · 四程序编排总控
#
# 跑在你的 Windows PC 上。它把「今天打开的那几个 AI」组织起来，按四个程序干活：
#
#   程序一 · 规划（23 环）  → 产出：章纲（含上架包装）   出口闸：章纲终审
#   程序二 · 写作（每章 4 环）→ 产出：正文             出口闸：正文终审
#   程序三 · 润色（1 环 28 项）→ 产出：润色定稿          出口闸：润色终审
#   程序四 · 质检（9 环）   → 产出：入库定稿 + 质检报告  出口闸：成书检验
#
# 每个「块」都走同一条链：多人产出 → 其余人盲审 → 指定拼接者段落级择优 → 环节候选稿
# 每个程序出口都投一次票：过半通过 / 未过半打回 / 平票交叉提意见再投（上限 2 轮）
#
# ── 用法 ────────────────────────────────────────────────────────
#   python session.py show                      # 先看名单、登记今天开了哪些 AI
#   python orchestrator.py --check-session       # 校验今日阵容（人数/拼接者/跨厂）
#   python orchestrator.py --probe               # 逐个探测今日 AI 是否可用
#   python orchestrator.py --program 规划 --dry-run
#   python orchestrator.py --program 规划
#   python orchestrator.py --program 写作 --chapter 0057
#   python orchestrator.py --program 写作 --chapter 0057 --phase 正文   # 只跑某一环
#   python orchestrator.py --program 润色 --chapter 0057
#   python orchestrator.py --program 质检 --chapter 0057
#
#   --dry-run  只打印将派发的任务，不真驱动（强烈建议先跑一次）
#   --loop N   单个出口闸的最大回改轮数（默认 2）
#   --once     每个环节只让 1 名 AI 产出（省额度试跑用；正式跑别加）

from concurrent.futures import ThreadPoolExecutor, as_completed
import threading

# 每个 AI 一把锁：同一 AI 不能并发调用（CDP 单连接）
_AI_LOCKS = {}
_AI_LOCKS_MU = threading.Lock()


def _get_ai_lock(key):
    with _AI_LOCKS_MU:
        if key not in _AI_LOCKS:
            _AI_LOCKS[key] = threading.Lock()
        return _AI_LOCKS[key]
