# ════════════════════════════════ 基础 ════════════════════════════════

def load_cfg() -> dict:
    with open(APPS_JSON, encoding="utf-8") as f:
        return json.load(f)


def read_text(p) -> str:
    p = Path(p)
    return p.read_text(encoding="utf-8", errors="ignore") if p.exists() else ""


def write_text(p, s):
    p = Path(p)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(s, encoding="utf-8")


def load_prompt(name: str) -> str:
    return read_text(PROMPTS / name)


# 需要带「写作硬指标」的程序（规划程序不必带，省 token）
HARD_RULE_PROGRAMS = ("写作", "润色", "质检")


def compose_prompt(base_name: str, program: str) -> str:
    """基础 prompt + 按程序附带的固定件（硬指标）。"""
    p = load_prompt(base_name)
    if program in HARD_RULE_PROGRAMS:
        hr = load_prompt("PROMPT_HARD_RULES.md")
        if hr.strip():
            p = p.rstrip() + "\n\n---\n\n" + hr
    return p


