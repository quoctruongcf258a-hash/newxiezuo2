def format_note(program, phase_cfg) -> str:
    """为产出环节指定输出格式（写进 prompt 的【输出格式要求】）。"""
    key = phase_cfg.get("key") or phase_cfg.get("name") or ""
    if program == "规划":
        # 优先用 phase_cfg 里的 fields 字段（结构化字段列表）
        _fields = phase_cfg.get("fields") or []
        if _fields:
            _lines = "\n".join(f"  {f}：" for f in _fields)
            _base = ("严格按下面字段输出，一行一个字段，不要增减：\n"
                    + _lines
                    + "\n  （补充说明：如本环节有其他必要信息，可在最后另起一节）")
            _pn = phase_cfg.get("name") or phase_cfg.get("key") or ""
            if _pn in SPLIT_PRODUCERS:
                _dim = SPLIT_PRODUCERS[_pn]
                _base += (
                    "\n\n【额外要求：结构化清单】\n"
                    "在上面正文的最后，追加一个 JSON 代码块（用三反引号 json 和三反引号 包裹），\n"
                    "用于下游环节自动拆分任务。JSON 必须符合下面格式：\n\n"
                    "```json\n"
                    "{\n"
                    '  "拆分维度": "' + _dim + '",\n'
                    '  "列表": [\n'
                    '    {"key": "' + _dim + '1", "name": "名称", "start": 1, "end": 50, "note": "要点"}\n'
                    "  ]\n"
                    "}\n"
                    "```\n\n"
                    "要求：\n"
                    "- 列表里的每一项代表一个下游任务单元\n"
                    "- key 用短标识（如 \"" + _dim + "1\"）\n"
                    "- 必须覆盖整个" + _dim + "范围，不能遗漏\n"
                    "- JSON 必须语法合法，不能有注释\n"
                )
            return _base
        # 人物设计：多人多文件
        if key == "人物设计":
            return (
                "本环节**为每个人物生成一份独立文件**。\n\n"
                "第一步：先读项目信息.json 的 `人物设计列表` 字段，拿到人物名单（N 个人）。\n\n"
                "第二步：为列表中**每个名字**输出一份档案，格式如下（每份一份 .md）：\n"
                "  # 人物设计：<人物名>\n"
                "  基础信息：<性别/年龄/身份/出身>\n"
                "  外貌：<身高/体型/标志性特征>\n"
                "  性格：<3-5 个关键词 + 说明>\n"
                "  表层欲望：<他想要什么>\n"
                "  深层欲望：<他真正需要什么>\n"
                "  恐惧：<最怕什么>\n"
                "  创伤：<过去发生了什么>\n"
                "  秘密：<他隐藏什么>\n"
                "  能力：<能力/功法>\n"
                "  能力代价：<使用代价>\n"
                "  弱点：<软肋/破绽>\n"
                "  口癖标志：<口头禅/动作特征>\n"
                "  初始状态：<出场时的处境/境界>\n"
                "  终局状态：<结局时的处境/境界>\n"
                "  成长弧光：<从 ___ 到 ___>\n"
                "  功法：<该人物使用的功法体系>\n"
                "  宝物：<该人物持有的宝物>\n"
                "  获取时间线：<何时获得功法/宝物/关键节点>\n\n"
                "**输出要求**：\n"
                "  - 每个名字输出一段 `# 人物设计：<名字>` 开头的档案\n"
                "  - 全部档案按人物列表顺序拼成一个 md 文件\n"
                "  - 不要漏人、不要多人挤在一段"
            )
        # 从 desc 拆出字段模板
        _desc = (phase_cfg.get("desc") or "").strip()
        _head = _desc
        for _sep in ("→", "->", "=>"):
            if _sep in _head:
                _head = _head.split(_sep)[0]
                break
        _fields = []
        import re as _re
        for _p in _re.split(r"[+/、，,；;]+", _head):
            _p = _p.strip()
            if _p and len(_p) <= 12 and not _p.startswith("输出"):
                _fields.append(_p)
        if _fields:
            _lines = "\n".join(f"  {f}：" for f in _fields)
            return ("严格按下面字段输出，一行一个字段，不要增减：\n"
                    + _lines
                    + "\n  （补充说明：如本环节有其他必要信息，可在最后另起一节）")
        return "输出结构化条目（`字段名：内容`），像一份可直接归档的设定表或清单。"
    if program == "写作":
        # W0_细纲分析：把本章 16 项细纲展开为写作素材
        if key == "W0_细纲分析" or "细纲分析" in key:
            return (
                "把本章的详细细纲展开为写作可用的素材，按下面结构逐项输出（一行一项）：\n"
                "  【本章一句话】：用一句话概括本章\n"
                "  【目标】：主角本章想做什么\n"
                "  【阻力】：什么在阻止他\n"
                "  【代价】：失败要付出什么\n"
                "  【时间锚点】：本章发生在故事时间轴的什么位置\n"
                "  【章内跨度】：本章覆盖多长时间\n"
                "  【与上章时差】：距离上一章多久\n"
                "  【倒计时状态】：是否有倒计时在走\n"
                "  【爽点】：读者的爽感来自哪里\n"
                "  【叙事线归属】：属于哪条叙事线（主线/支线/暗线）\n"
                "  【对手层级】：本章对手是什么级别\n"
                "  【视角】：用谁的视角叙述\n"
                "  【关键实体】：本章出现的关键人物、物品、地点\n"
                "  【本章变化】：本章结束时世界/人物发生了什么不可逆的变化\n"
                "  【章末未闭合问题】：留给下一章的悬念\n"
                "  【六要素阶段】：本章处于六要素的哪个阶段\n"
                "  【钩子类型】：章末使用哪种钩子"
            )
        if "章前对齐卡" in key:
            return ("输出一张对齐卡，字段固定：视角 / 视角人物 / 视角限制 / 本章释放信息 / "
                    "本章隐藏信息 / 本章误导信息 / 本章伏笔信息 / 场景进出方式 / 章首方式 / "
                    "章末钩子类型 / 平台红线 / 本块目标。")
        if "分布" in key:
            return ("输出分镜式条目，每条一行：`段序 | 目标字数 | 发生了什么 | 关键词 | "
                    "六要素归属 | 自检红线`。")
        if "正文" in key:
            return "输出连贯的正文段落，不带任何标注、不加小节标题、不写解释与总结。"
        if "章内节奏自检" in key:
            return ("输出自检表，字段：断点位置 / 四条红线是否命中 / 章末钩强度（1—10）/ "
                    "留白比例 / 待改条目（含定位卡四件套）。")
    if program == "润色":
        return "输出润色后的**完整文本**，不要输出修改说明、不要输出对照表。"
    if program == "质检":
        return ("输出问题清单，每条含：位置 / 命中条目 / 正文关键句 / 修改建议 / 严重度（S/A/B/C）。"
                "若是质检汇总或成书检验环节，改为输出 JSON。")
    return ""


def get_agent():
    """初始化 Windows-Use 代理（延迟导入，dry-run 不需要）。"""
    provider = os.getenv("WINDOWS_USE_PROVIDER", "ollama").lower()
    try:
        from windows_use.providers.ollama import ChatOllama as OllamaP
        from windows_use.providers.google import ChatGoogle as GoogleP
        from windows_use.providers.openai import ChatOpenAI as OpenAIP
        from windows_use.providers.deepseek import ChatDeepSeek as DeepSeekP
        from windows_use import Agent, Browser
    except Exception:
        from windows_use.llms.ollama import ChatOllama as OllamaP
        from windows_use.llms.google import ChatGoogle as GoogleP
        from windows_use.llms.openai import ChatOpenAI as OpenAIP
        from windows_use.llms.deepseek import ChatDeepSeek as DeepSeekP
        from windows_use.agent import Agent, Browser

    if provider == "gemini":
        from dotenv import load_dotenv
        load_dotenv()
        llm = GoogleP(model=os.getenv("GEMINI_MODEL", "gemini-2.5-flash"),
                      api_key=os.getenv("GOOGLE_API_KEY"))
    elif provider == "openai":
        from dotenv import load_dotenv
        load_dotenv()
        llm = OpenAIP(model=os.getenv("OPENAI_MODEL", "gpt-4o"))
    elif provider == "deepseek":
        from dotenv import load_dotenv
        load_dotenv()
        llm = DeepSeekP(model=os.getenv("DEEPSEEK_MODEL", "deepseek-chat"))
    else:
        llm = OllamaP(model=os.getenv("OLLAMA_MODEL", "qwen2.5:14b"))

    browser = getattr(Browser, os.getenv("WINDOWS_USE_BROWSER", "EDGE").upper(), Browser.EDGE)
    return Agent(llm=llm, browser=browser, use_vision=False)


def _extract_prompt(task_text):
    """从 SOP 里抠出『指令开始...指令结束』之间的正文。

    文件模式（含 _task_files 路径）不走截取——整个 task 都是要发给 AI 的指令。
    """
    # 文件模式：整个 task 就是指令，不截取
    if "_task_files" in task_text:
        return task_text
    i = task_text.find("===== 指令开始 =====")
    j = task_text.find("===== 指令结束 =====")
    if i >= 0 and j > i:
        return task_text[i + len("===== 指令开始 ====="):j].strip()
    return task_text


def run_task(agent, task_text, dry=False, title="", app=None):
    """_CDP_FIRST：优先走 CDP（app 有 cdpPort），失败/无端口才回退 windows_use。"""
    print("\n" + "─" * 74)
    if title:
        print(f"[{title}]")
    print(task_text)
    print("─" * 74)
    if dry:
        print("[dry-run] 未实际驱动。")
        return True

    # ── CDP 分支 ──
    cdp_port = (app or {}).get("cdpPort")
    if cdp_port:
        try:
            import sys as _sys
            _wu = HERE.parent
            if str(_wu) not in _sys.path:
                _sys.path.insert(0, str(_wu))
            from mix_send import send as _cdp_send
            prompt = _extract_prompt(task_text)
            label = (app or {}).get("label") or (app or {}).get("key") or ""
            print(f"[CDP] 发送到 {label}（端口 {cdp_port}），prompt {len(prompt)} 字")
            r = _cdp_send(label, prompt)
            print(f"[CDP] 返回：{r}")
            # 判断是否真发送成功：mix_send 返回值以 ✅ 开头为成功
            _rs = str(r or "")
            if _rs.lstrip().startswith("✅"):
                # 发送后运行校验（3 秒后查「停止」按钮）
                try:
                    time.sleep(3)
                    from mix_send import check_running as _chk
                    _st = _chk(label)
                    if _st == "running":
                        print(f"[校验] ✓ {label} 正在运行")
                    elif _st == "idle":
                        print(f"[校验] ⚠ {label} 未检测到运行（可能已回复完）")
                    else:
                        print(f"[校验] ⚠ {label} 状态：{_st}")
                except Exception as _ve:
                    print(f"[校验] 异常：{_ve}")
                return True
            print("[CDP] 返回非成功标记，判定为失败")
            return False
        except Exception as e:                 # noqa: BLE001
            print(f"[CDP 失败] {e}，回退 windows_use")

    # ── windows_use 分支 ──
    if agent is None:
        print("[错误] agent=None 且该 AI 无 cdpPort，无法执行")
        return False
    try:
        agent.invoke(task=task_text)
        return True
    except Exception as e:                     # noqa: BLE001
        print(f"[错误] Windows-Use 执行失败：{e}")
        return False


def wait_file(p, timeout=180):
    p = Path(p)
    t0 = time.time()
    while time.time() - t0 < timeout:
        if p.exists() and p.stat().st_size > 0:
            return True
        time.sleep(5)
    return p.exists() and p.stat().st_size > 0


# ════════════════════════════ 审核标准提取 ════════════════════════════

def _fmt_lines(items, bullet="  · ") -> str:
    return "\n".join(f"{bullet}{x}" for x in items)


def _item_line(it, indent="  - ") -> str:
    """兼容渲染：标准条目可能是纯字符串，也可能是 {n,name/key,check} 对象。"""
    if isinstance(it, str):
        return f"{indent}{it}"
    if isinstance(it, dict):
        no = it.get("n") or ""
        name = it.get("name") or it.get("key") or ""
        check = it.get("check") or it.get("desc") or ""
        head = f"{indent}{no} {name}".rstrip()
        return f"{head}：{check}" if check else head
    return f"{indent}{it}"


def _polish_no(section: dict) -> str:
    """润色节编号：有 n 用 n，否则从 key（如「一、润色前准备」）里取前缀。"""
    if section.get("n"):
        return str(section["n"])
    k = str(section.get("key", ""))
    return k.split("、")[0] if "、" in k else k


def platform_block(cfg) -> str:
    """番茄平台硬约束，注入每一次产出与盲审。"""
    p = cfg.get("platform") or {}
    if not p:
        return ""
    cs = p.get("chapterSpec") or {}
    parts = ["【平台硬约束（番茄）——任何产出都不得违反】"]
    for k in ("开篇", "单章字数", "钩子密度", "视角", "称谓"):
        if cs.get(k):
            parts.append(f"  · {k}：{cs[k]}")
    if p.get("metrics", {}).get("核心指标"):
        parts.append(f"  · 核心指标：{'、'.join(p['metrics']['核心指标'])}")
    # _NO_AI_POLICY：AI 政策行已去掉（用户要求）
    return "\n".join(parts)


def plan_direction_standard(cfg, phase_key: str) -> str:
    """给规划某个环节，找出它归属的八方向，返回该方向的审核标准。"""
    dirs = cfg.get("auditDirections") or []
    hit = None
    for d in dirs:
        rings = list(d.get("rings") or []) + list(d.get("extends") or [])
        if phase_key in rings:
            hit = d
            break
    if not hit:
        # 兜底：把全部方向标准都给（用于收口环节）
        return "\n\n".join(_dir_text(d) for d in dirs)
    return _dir_text(hit)


def _dir_text(d: dict) -> str:
    s = [f"方向：{d.get('key', '')}"]
    if d.get("questions"):
        s.append("要回答：" + " / ".join(d["questions"]))
    if d.get("standards"):
        s.append("审核标准（逐条打勾）：")
        s.append(_fmt_lines(d["standards"], "  □ "))
    if d.get("failPatterns"):
        s.append("不合格表现（命中即判不通过）：")
        s.append(_fmt_lines(d["failPatterns"], "  ✗ "))
    return "\n".join(s)


def six_standard(cfg, element_key=None) -> str:
    """六要素审核标准（写作程序）。element_key 给了就只给该要素。"""
    se = cfg.get("sixElements") or {}
    els = se.get("elements") or []
    out = ["【写作审核框架：六要素（始・显・通・动・成・终）】"]
    for e in els:
        if element_key and e.get("key") != element_key:
            continue
        out.append(f"\n■ {e.get('key')}（{e.get('name', '')}）")
        if e.get("action"):
            out.append(f"  创作动作：{e['action']}")
        if e.get("keywords"):
            out.append(f"  关键词：{'・'.join(e['keywords'])}")
        if e.get("standards"):
            out.append("  审核要点：")
            out.append(_fmt_lines(e["standards"], "    □ "))
        if e.get("failPatterns"):
            out.append("  不合格表现：")
            out.append(_fmt_lines(e["failPatterns"], "    ✗ "))
    if se.get("redLines"):
        out.append("\n【四条红线（命中即不通过）】")
        for r in se["redLines"]:
            out.append(f"  ✗ {r.get('key')}：{r.get('rule', '')}")
    return "\n".join(out)


def polish_standard(cfg, section_nos=None) -> str:
    """润色标准（程序三）。section_nos 给了就只取那几节。"""
    ps = cfg.get("polishStandard") or {}
    out = []
    for s in ps.get("sections", []):
        if section_nos and _polish_no(s) not in section_nos:
            continue
        out.append(f"■ {s.get('key', '')}")
        if s.get("note"):
            out.append(f"  （{s['note']}）")
        for it in s.get("items", []):
            out.append(_item_line(it))
            if isinstance(it, dict):
                for sub in (it.get("subs") or []):
                    out.append(f"      · {sub}")
    if not section_nos:
        acc = ps.get("acceptance") or {}
        for k, v in acc.items():
            out.append(f"\n【验收清单·{k}】")
            out.append(_fmt_lines(v, "  □ "))
        if ps.get("pitfalls"):
            out.append("\n【常见坑】")
            out.append(_fmt_lines(ps["pitfalls"], "  ⚠ "))
    return "\n".join(out)


def qc_standard(cfg, section_nos=None) -> str:
    """质检标准（程序四）。section_nos 给了就只取那几节。"""
    q = cfg.get("qcStandard") or {}
    out = []
    for s in q.get("sections", []):
        if section_nos and str(s.get("n")) not in [str(x) for x in section_nos]:
            continue
        out.append(f"■ {s.get('n', '')} {s.get('key', '')}")
        for it in s.get("items", []):
            out.append(_item_line(it))
    if q.get("severity") and not section_nos:
        out.append("\n【严重程度分级】")
        for k, v in q["severity"].items():
            out.append(f"  {k}：{v}")
    return "\n".join(out)


def env_block(cfg, craft_str) -> str:
    """写作程序专用：把 writingEnvironment 里对应类别的技法条注入 prompt。

    craft_str 例："落笔技术类(7-13)" → 取 "落笔技术类"。
    「写作模式类」无论哪个环节都注入（每章选一种写法）。
    """
    we = cfg.get("writingEnvironment") or {}
    cats = we.get("categories") or []
    if not cats:
        return ""
    cat_name = str(craft_str or "").split("(")[0].strip()
    out = ["【本环节适用的写作技法（逐条落实，坑要主动规避）】"]
    for c in cats:
        if c["key"] != cat_name and c["key"] != "写作模式类":
            continue
        out.append(f"\n■ {c['key']}")
        for it in c.get("items", []):
            line = f"  {it.get('n', '')}. {it['key']}：{it.get('check', '')}"
            out.append(line)
            for k in ("坑", "原则", "适合"):
                if it.get(k):
                    out.append(f"       {k}：{it[k]}")
    return "\n".join(out)


# ════════════════════════════ 块切分 ════════════════════════════

def _parse_volumes():
    """解析卷划分，返回 [(卷名, 起章, 止章), ...]。

    查找顺序（fallback）：
      1. 00_初始化/1.6_卷纲.md         ← 现在
      2. 01_规划/分卷结构/phase_candidate.md  ← 将来（1.6 移到规划后）
      3. 01_规划/分卷结构/merged/分卷结构.md
      4. 01_规划/全书结构/phase_candidate.md
    """
    import re
    root = _project_root()
    candidates = [
        root / "00_初始化" / "1.6_卷纲.md",
        root / "01_规划" / "分卷结构" / "phase_candidate.md",
        root / "01_规划" / "分卷结构" / "merged" / "分卷结构.md",
        root / "01_规划" / "全书结构" / "phase_candidate.md",
    ]
    p = None
    for c in candidates:
        if c.exists() and c.stat().st_size > 0:
            p = c
            break
    if p is None:
        return []
    text = p.read_text(encoding="utf-8", errors="ignore")
    out = []
    for m in re.finditer(r"##\s*(第[一二三四五六七八九十百]+卷)[：:][^\n]*?第\s*(\d+)\s*[-—～~]\s*(\d+)\s*章", text):
        out.append((m.group(1), int(m.group(2)), int(m.group(3))))
    return out


def chunks_for_phase(cfg, program, phase_cfg) -> list:
    """把一个环节切成若干「块」。返回 [(chunk_id, chunk_label, standard_block), ...]

    规划：环节即块（desc 作为说明）；P16 volume 按卷纲切，P17 chapters 按 segment_size 切
    写作：分布/正文 按六要素切 6 块；其余环节单块
    润色：按 4 节切
    质检：按 qcSecs 每节一块
    """
    key = phase_cfg["key"]

    # 走拆分引擎的环节：单块，让 _get_split_spec 接管
    _name = phase_cfg.get("name") or phase_cfg.get("key") or ""
    if _name in SPLIT_SOURCES:
        return [(key, key, "")]

    # P16：按卷切（从 1.6_卷纲.md 读真实区间）
    if phase_cfg.get("segment_mode") == "volume":
        vols = _parse_volumes()
        if vols:
            return [(v[0], f"{v[0]}（第{v[1]}-{v[2]}章）", "") for v in vols]
        # 兜底：从 cfg 读卷数
        n = cfg.get("卷数") or 3
        total = cfg.get("章节数") or 150
        per = total // n
        out = []
        for i in range(n):
            s = i * per + 1
            e = (i + 1) * per if i < n - 1 else total
            out.append((f"V{i+1}", f"第{i+1}卷（{s}-{e}章）", ""))
        return out

    # P17：按 segment_size 章一段切
    if phase_cfg.get("segment_mode") == "chapters":
        size = phase_cfg.get("segment_size") or 30
        total = cfg.get("章节数") or 150
        out = []
        for s in range(0, total, size):
            e = min(s + size, total)
            out.append((f"{s+1}-{e}", f"{s+1}-{e}章", ""))
        return out
    if program == "写作" and phase_cfg.get("six"):
        els = (cfg.get("sixElements") or {}).get("elements") or []
        return [(e["key"], f"六要素·{e['key']}", six_standard(cfg, e["key"])) for e in els]
    if program == "润色":
        secs = (cfg.get("polishStandard") or {}).get("sections") or []
        return [(_polish_no(s), s.get("key", ""), polish_standard(cfg, [_polish_no(s)]))
                for s in secs]
    if program == "质检" and phase_cfg.get("qcSecs"):
        out = []
        for n in phase_cfg["qcSecs"]:
            out.append((str(n), f"{n}", qc_standard(cfg, [n])))
        return out
    if program == "规划":
        return [(key, key, plan_direction_standard(cfg, key))]
    return [(key, key, "")]


# ════════════════════════════ 网格三件套 ════════════════════════════

def do_produce(agent, sess, app, program, phase_cfg, chunk_id, chunk_label,
               input_text, out_dir, dry, extra_note="", ai_assist=False):
    """① 产出：一名 AI 产出一版。"""
    # ── 人物设计：每个人物单独调 AI，各自落一个文件 ──
    _pkey = phase_cfg.get("key") or phase_cfg.get("name") or ""
    if "人物设计" in _pkey:
        return _do_produce_renwu(
            agent, sess, app, program, phase_cfg, chunk_id, chunk_label,
            input_text, out_dir, dry, extra_note=extra_note, ai_assist=ai_assist
        )
    # ── 通用拆分：按上游 split.json 批量产出（1 条命令生成 N 文件）──
    _split_spec = _get_split_spec(phase_cfg, out_dir, chunk_id)
    if _split_spec is not None:
        if _split_spec.get("列表"):
            # 批量模式：1 条命令，让 AI 自己生成全部文件
            return _do_produce_batch(
                agent, sess, app, program, phase_cfg, chunk_id, chunk_label,
                input_text, out_dir, dry, extra_note=extra_note,
                ai_assist=ai_assist, split_spec=_split_spec,
            )
        else:
            return []
    out = Path(out_dir) / "versions" / f"{chunk_id}__{app['key']}.md"
    out.parent.mkdir(parents=True, exist_ok=True)   # 保证 versions 目录存在
    label = f"{program} › {phase_cfg['key']}"
    # 把输入材料里的 <你的名字> 替换成实际 AI key
    input_text = input_text.replace("<你的名字>", app["key"])
    tpl = compose_prompt("PROMPT_PRODUCE.md", program)
    note = format_note(program, phase_cfg)
    if extra_note:
        note = (note + "\n\n【上一轮终审反对意见（必须逐条对应处理）】\n" + extra_note).strip()
    if ai_assist:
        task = tasks_mod.build_scaffold_task(app, tpl, input_text, str(out), label)
    else:
        task = tasks_mod.build_produce_task(app, tpl, input_text, str(out), label,
                                            chunk_label, note)
    ok = run_task(agent, task, dry, title=f"产出 | {app['label']} | {label} | {chunk_label}", app=app)
    if ok and not dry:
        # 先尝试等 AI 自己另存（60 秒）
        wait_file(out, timeout=60)
        # 若没落盘，用 capture 抓回复写文件
        if not (out.exists() and out.stat().st_size > 0):
            try:
                import sys as _s
                _wu = HERE.parent
                if str(_wu) not in _s.path:
                    _s.path.insert(0, str(_wu))
                from mix_send import capture_with_meta as _cap
                # 先抓 baseline
                _r0 = _cap(app["key"])
                _baseline = ((_r0 or {}).get("text", "") if isinstance(_r0, dict) else str(_r0 or "")).strip()
                _txt = ""
                for _try in range(30):        # 180 秒
                    _r = _cap(app["key"])
                    _cur = ((_r or {}).get("text", "") if isinstance(_r, dict) else str(_r or "")).strip()
                    if _cur and len(_cur) >= 50 and _cur != _baseline:
                        _txt = _cur
                        break
                    time.sleep(6)
                if _txt:
                    out.parent.mkdir(parents=True, exist_ok=True)
                    out.write_text(_txt, encoding="utf-8")
                    print(f"[产出] capture 已落盘：{out.name}（{len(_txt)} 字）")
                else:
                    print(f"[产出] capture 未抓到新回复：{app['key']}")
            except Exception as _e:
                print(f"[产出] capture 失败：{_e}")
        # 人物设计环节：拆成 N 个文件（每人一份）
        _pkey2 = phase_cfg.get("key") or phase_cfg.get("name") or ""
        if "人物设计" in _pkey2 and out.exists() and out.stat().st_size > 0:
            try:
                _split_renwu(out, app["key"])
            except Exception as _e:
                print(f"   [拆分失败] {_e}")
        # 通用拆分生产者：从产出里提取 split.json
        if out.exists() and out.stat().st_size > 0:
            try:
                _maybe_extract_split(phase_cfg, out, out_dir)
            except Exception as _e:
                print(f"   [split 提取失败] {_e}")
    return out


def _split_renwu(main_path, ai_key):
    """把人物设计合并文件按「# 人物设计：<名字>」拆成 N 个文件。"""
    import re
    text = read_text(main_path)
    if not text.strip():
        return
    parts = re.split(r"^#\s*人物设计[：:]\s*", text, flags=re.MULTILINE)
    if len(parts) < 2:
        print("   [拆分] 未找到人物标记，保留原文件")
        return
    parent = Path(main_path).parent
    n = 0
    for seg in parts[1:]:
        lines = seg.splitlines()
        if not lines:
            continue
        name = lines[0].strip()
        if not name:
            continue
        safe = name.replace("/", "_").replace("\\", "_").replace(":", "_").strip()[:40]
        body = "\n".join(lines[1:]).strip()
        out = parent / f"{safe}__{ai_key}.md"
        write_text(out, f"# 人物设计：{name}\n{body}\n")
        n += 1
    print(f"   [拆分] 人物设计 → {n} 个文件（{parent}）")


def do_review(agent, sess, app, program, phase_cfg, chunk_id, chunk_label,
              target_path, out_dir, dry, std=None):
    """② 盲审：其余 AI 隔离评审某一版，输出 JSON。

    std 为该块的审核标准（由 chunks_for_phase 给出）；未给则按程序回退取全集。
    """
    tgt = read_text(target_path)
    if not tgt.strip():
        return None
    out = Path(out_dir) / "reviews" / f"{chunk_id}__{Path(target_path).stem}__{app['key']}.json"
    out.parent.mkdir(parents=True, exist_ok=True)   # 保证 reviews 目录存在
    label = f"{program} › {phase_cfg['key']}"
    if std is None:
        if program == "规划":
            std = plan_direction_standard(agent_cfg, phase_cfg["key"])
        elif program == "写作":
            std = six_standard(agent_cfg, None)
        elif program == "润色":
            std = polish_standard(agent_cfg, None)
        elif program == "质检":
            std = qc_standard(agent_cfg, phase_cfg.get("qcSecs"))
    task = tasks_mod.build_review_task(app, compose_prompt("PROMPT_REVIEW.md", program), tgt,
                                       str(out), label, std, chunk_label)
    # 发送前先抓「当前最后回复」作为 baseline（防止误读旧回复）
    _baseline = ""
    if not dry:
        try:
            import sys as _s
            _wu = HERE.parent
            if str(_wu) not in _s.path:
                _s.path.insert(0, str(_wu))
            from mix_send import capture_with_meta as _cap0
            _r0 = _cap0(app["key"])
            _baseline = ((_r0 or {}).get("text", "") if isinstance(_r0, dict) else str(_r0 or "")).strip()
        except Exception:
            _baseline = ""

    ok = run_task(agent, task, dry, title=f"盲审 | {app['label']} | {label} | {chunk_label}", app=app)
    if ok and not dry:
        # 用 capture 抓 AI 回复，Python 自己写 JSON（不再依赖 AI 另存）
        try:
            import sys as _s
            _wu = HERE.parent
            if str(_wu) not in _s.path:
                _s.path.insert(0, str(_wu))
            from mix_send import capture_with_meta as _cap
            _txt = ""
            for _try in range(30):                # 最多等 150 秒
                _r = _cap(app["key"])
                _cur = ((_r or {}).get("text", "") if isinstance(_r, dict) else str(_r or "")).strip()
                # 判定：必须有内容 + 内容 ≥ 30 字 + 与 baseline 不同
                if _cur and len(_cur) >= 30 and _cur != _baseline:
                    _txt = _cur
                    break
                time.sleep(5)
            if _txt:
                import re as _re
                # 从回复里抠 JSON（第一个 { 到最后一个 }）
                _m = _re.search(r"\{.*\}", _txt, _re.S)
                _payload = _m.group(0) if _m else _txt
                out.parent.mkdir(parents=True, exist_ok=True)
                out.write_text(_payload, encoding="utf-8")
                print(f"[盲审] 已抓取并落盘：{out.name}（{len(_payload)} 字，baseline {len(_baseline)} 字）")
            else:
                print(f"[盲审] 未抓到新回复：{app['key']}（baseline {len(_baseline)} 字）")
        except Exception as _e:
            print(f"[盲审] capture 失败：{_e}")
    return out


def do_merge(agent, sess, app, program, phase_cfg, chunk_id, chunk_label,
             version_paths, review_paths, out_dir, dry, extra_issues=""):
    """③ 拼接：指定拼接者按段落级择优拼出候选稿。"""
    label = f"{program} › {phase_cfg['key']}"
    vtext = []
    for i, p in enumerate(version_paths, 1):
        t = read_text(p)
        if t.strip():
            vtext.append(f"── 版本{i}（产出者：{Path(p).stem.split('__')[-1]}）──\n{t}")
    rtext = []
    for p in review_paths:
        if not p:
            continue
        t = read_text(p)
        if t.strip():
            rtext.append(f"── 评审（{Path(p).stem}）──\n{t}")
    if extra_issues:
        rtext.append("── 上一轮终审反对意见（本轮必须逐条处理）──\n" + extra_issues)
    out = Path(out_dir) / "merged" / f"{chunk_id}.md"
    out.parent.mkdir(parents=True, exist_ok=True)   # 保证 merged 目录存在
    task = tasks_mod.build_merge_task(app, compose_prompt("PROMPT_MERGE.md", program),
                                      "\n\n".join(vtext), "\n\n".join(rtext),
                                      str(out), label, chunk_label)
    ok = run_task(agent, task, dry, title=f"拼接 | {app['label']} | {label} | {chunk_label}", app=app)
    if ok and not dry:
        wait_file(out)
    return out


agent_cfg = {}   # 由 main 注入（供 do_review 取标准）


# ════════════════════════════ 环节 / 程序 ════════════════════════════

# _UPSTREAM_PATHS：列出本环之前已产出的文件路径
def keywords_for_phase(cfg, program, phase_cfg):
    """从 apps.json 提取本环节关键词，返回 dict。"""
    out = {"内容词": [], "动作词": [], "禁止词": [], "验收词": [], "红线": []}
    key = phase_cfg.get("key") or phase_cfg.get("name") or ""

    if program == "规划":
        # 优先用 fields（新环有明确字段列表）
        _fields = phase_cfg.get("fields") or []
        if _fields:
            out["内容词"] = [str(f) for f in _fields]
        else:
            # 回退：从 desc 拆（→ 后面是动作）
            _desc = (phase_cfg.get("desc") or "").strip()
            if _desc:
                _head = _desc
                for _sep in ("→", "->", "=>"):
                    if _sep in _head:
                        _head = _head.split(_sep)[0]
                        break
                for _part in re.split(r"[+/、，,；;]+", _head):
                    _p = _part.strip()
                    if _p and not _p.startswith("输出"):
                        out["内容词"].append(_p)

    if program == "写作":
        seg = phase_cfg.get("six_segment") or ""
        for e in (cfg.get("sixElements") or {}).get("elements") or []:
            if e.get("key") == seg:
                kws = e.get("keywords") or ""
                out["内容词"] += [x for x in kws.split("・") if x]
                out["验收词"] += list(e.get("standards") or [])
                out["禁止词"] += list(e.get("failPatterns") or [])
        for r in (cfg.get("sixElements") or {}).get("redLines") or []:
            out["红线"].append(f"{r.get('key')}：{r.get('rule')}")
        craft = phase_cfg.get("craft") or ""
        cat = craft.split("(")[0].strip()
        for c in (cfg.get("writingEnvironment") or {}).get("categories") or []:
            if c.get("key") == cat:
                for it in c.get("items") or []:
                    out["动作词"].append(f"{it.get('key')}：{it.get('check')}")
                    if it.get("坑"):
                        out["禁止词"].append(it["坑"])
                break

    if program == "润色":
        for s in (cfg.get("polishStandard") or {}).get("sections") or []:
            for it in s.get("items") or []:
                out["动作词"].append(f"{it.get('name')}：{it.get('check')}")
        out["禁止词"] += list((cfg.get("polishStandard") or {}).get("pitfalls") or [])

    if program == "质检":
        for n in phase_cfg.get("qcSecs") or []:
            for s in (cfg.get("qcStandard") or {}).get("sections") or []:
                if str(s.get("n")) == str(n):
                    out["内容词"] += list(s.get("items") or [])

    # 每类去重（保持首次出现顺序）
    for _k in list(out.keys()):
        _seen = set()
        _uniq = []
        for _x in out[_k]:
            _s = str(_x)
            if _s not in _seen:
                _seen.add(_s)
                _uniq.append(_x)
        out[_k] = _uniq

    return out


def _upstream_files(program, phase_cfg, chapter=None):
    """返回本环应读取的上游文件路径列表。"""
    _root = _project_root()
    _stage = _STAGE_DIR_MAP.get(program, program)
    _stage_dir = _root / _stage
    ups = []

    # 首个程序（规划）读 00_初始化 的项目信息 + 7 份规划蓝图
    if program == "规划":
        _init_dir = _root / "00_初始化"
        _info = _init_dir / "项目信息.json"
        if _info.exists():
            ups.append(str(_info))
        # 00_初始化 读取：用户输入 + 梗概 + 卷纲
        for _bp in ("用户输入.md", "第0步梗概.md", "1.6_卷纲.md"):
            _fp = _init_dir / _bp
            if _fp.exists():
                ups.append(str(_fp))

    # 读前面环的 phase_candidate.md（按 rings_items.json 顺序）
    try:
        import json as _json
        if RINGS_JSON.exists():
            _rings = _json.loads(RINGS_JSON.read_text(encoding="utf-8"))
            _stage_key = {"规划": "01_规划", "写作": "02_写作",
                          "润色": "03_去AI", "质检": "04_审核"}.get(program, "")
            _items = _rings.get(_stage_key, {}).get("环节", [])
            _order = [x.get("name") or x.get("code") for x in _items]
            _cur = phase_cfg.get("key") or phase_cfg.get("name")
            if _cur in _order:
                _idx = _order.index(_cur)
                for _prev in _order[:_idx]:
                    fp = _stage_dir / _prev / "phase_candidate.md"
                    if fp.exists():
                        ups.append(str(fp))
    except Exception:
        pass

    # 章循环：读上一章产物
    if chapter and program in ("写作", "润色", "质检"):
        try:
            _prev_ch = str(int(chapter) - 1).zfill(4)
            _prev_dir = _root / "02_写作" / f"ch{_prev_ch}"
            if _prev_dir.exists():
                for _fp in _prev_dir.rglob("phase_candidate.md"):
                    ups.append(str(_fp))
        except Exception:
            pass

    return ups


def phase_dir(program, chapter, phase_key):
    """_PROJECT_ROOT：产物写到 output/<项目名>/<阶段目录>/<环名>/"""
    _stage = _STAGE_DIR_MAP.get(program, program)
    d = _project_root() / _stage
    if chapter:
        d = d / f"ch{chapter}"
    return d / phase_key


def run_mesh_phase(agent, cfg, sess, program, phase_cfg, chapter, input_text, dry,
                   once=False, extra_issues="", custom_chunks=None):
    """跑一个环节：逐块 产出→盲审→拼接，拼成环节候选稿。返回候选稿路径。

    custom_chunks 给了就用它（每项 (chunk_id, chunk_label, standard_block)），
    用于周期性复检这类「不属于标准环节」的特殊跑法。
    """
    parts = sess["participants"]
    merger = sess["merge_app"]

    # _roles_from_stage_board：读 UI 指派
    _assign = load_stage_assignments()
    _stage_a = _assign.get(program, {}).get("steps", {})
    _this_a = _stage_a.get(phase_cfg["key"], {}) or {}

    _exec_names = (_this_a.get("blocks", {}) or {}).get("产出") or []
    _rev_names = _this_a.get("reviewer") or []
    _adj_name = _this_a.get("adjuster") or ""

    phase_writers = _names_to_parts(_exec_names, parts) or parts
    phase_reviewers = _names_to_parts(_rev_names, parts) or parts
    phase_merger = None
    if _adj_name:
        _adj_key = _name_to_key(_adj_name, parts)
        for _p in parts:
            if _p["key"] == _adj_key:
                phase_merger = _p
                break
    if not phase_merger:
        phase_merger = merger

    # ─── 角色覆盖校验：确保每个 AI 都有任务 ───
    _all_keys = {p["key"] for p in parts}
    _writer_keys = {p["key"] for p in phase_writers}
    _reviewer_keys = {p["key"] for p in phase_reviewers}

    _missing_w = _all_keys - _writer_keys
    _missing_r = _all_keys - _reviewer_keys

    if _missing_w:
        print(f"  ⚠ [校验] 这些 AI 没被指派为写手：{_missing_w}，自动补入")
        for p in parts:
            if p["key"] in _missing_w:
                phase_writers.append(p)
    if _missing_r:
        print(f"  ⚠ [校验] 这些 AI 没被指派为审核：{_missing_r}，自动补入")
        for p in parts:
            if p["key"] in _missing_r:
                phase_reviewers.append(p)

    print(f"  [角色] 执行={[p['label'] for p in phase_writers]} "
          f"审核={[p['label'] for p in phase_reviewers]} "
          f"调整={phase_merger['label']}")
    print(f"  [校验] 参与者 {len(parts)} 人：写手 {len(phase_writers)} / 审核 {len(phase_reviewers)}")

    out_dir = phase_dir(program, chapter, phase_cfg["key"])
    chunks = custom_chunks or chunks_for_phase(cfg, program, phase_cfg)

    print(f"\n{'=' * 74}")
    mode = ((cfg.get("complianceMode") or {}).get("default") or "aiDirect")
    assist = (mode == "aiAssist")
    print(f"【{program} › {phase_cfg['key']}】参战 {len(parts)} 人，"
          f"拼接者 {merger['label']}，共 {len(chunks)} 块"
          + (f"｜合规模式：{mode}" + ("（AI 出蓝图，作者手写正文）" if assist else "（AI 直出正文）")
             if program == "写作" else ""))
    print(f"{'=' * 74}")

    for cid, clabel, _std in chunks:
        writers = phase_writers[:1] if once else phase_writers
        versions = []
        # 并发发送：4 个写手同时发任务
        if not dry and len(writers) > 1:
            print(f"\n[并发] {len(writers)} 个写手同时发送块「{clabel}」...")
            with ThreadPoolExecutor(max_workers=len(writers)) as _ex:
                _futs = {}
                def _produce_locked(_w):
                    with _get_ai_lock(_w["key"]):
                        return do_produce(agent, sess, _w, program, phase_cfg,
                                          cid, clabel, input_text, out_dir, dry,
                                          extra_note=extra_issues, ai_assist=assist)
                for w in writers:
                    _futs[_ex.submit(_produce_locked, w)] = w
                for _fut in as_completed(_futs):
                    _w = _futs[_fut]
                    try:
                        v = _fut.result()
                        if isinstance(v, list):
                            _got = [x for x in v if x and x.exists() and x.stat().st_size > 0]
                            versions.extend(_got)
                            print(f"  ✔ {_w['label']} 完成：{len(_got)} 个人物档案")
                        elif v and v.exists() and v.stat().st_size > 0:
                            versions.append(v)
                            print(f"  ✔ {_w['label']} 完成：{v.name}")
                        else:
                            print(f"  ✗ {_w['label']} 无产出")
                    except Exception as _e:
                        print(f"  ✗ {_w['label']} 异常：{_e}")
        else:
            # 单写手或 dry-run：串行
            for w in writers:
                v = do_produce(agent, sess, w, program, phase_cfg, cid, clabel,
                               input_text, out_dir, dry, extra_note=extra_issues,
                               ai_assist=assist)
                if isinstance(v, list):
                    versions.extend([x for x in v if x])
                elif dry or (v.exists() and v.stat().st_size > 0):
                    versions.append(v)

        # 汇总产出校验（目录式命名：<versions>/<ai>/<item>.md）
        if not versions:
            print(f"  [产出校验] 本 chunk 无产出（可能被阶段过滤跳过）")
            _skip_check = True
        else:
            _skip_check = False
        _expect_ais = {w["key"] for w in writers}
        _out_ais = set()
        _out_pairs = set()      # (AI, item)
        _split_mode = False

        if not _skip_check:
            _versions_dir_chk = Path(out_dir) / "versions"
            if _versions_dir_chk.exists():
                for _ai_dir in _versions_dir_chk.iterdir():
                    if not _ai_dir.is_dir():
                        continue
                    _ai = _ai_dir.name
                    if _ai not in _expect_ais:
                        continue
                    _out_ais.add(_ai)
                    for _f in _ai_dir.glob("*.md"):
                        if _f.stat().st_size > 0:
                            _out_pairs.add((_ai, _f.stem))
                            _split_mode = True

            _missing_ais = _expect_ais - _out_ais
            if _split_mode:
                _phase_label = phase_cfg.get("key") or phase_cfg.get("name") or "?"
                print(f"  [产出校验] {_phase_label}：共 {len(_out_pairs)} 份产出，覆盖 {len(_out_ais)}/{len(_expect_ais)} 个 AI")
                if _missing_ais:
                    print(f"  [产出校验] ⚠ 未产出 AI：{_missing_ais}")
            else:
                print(f"  [产出校验] 期望 {len(_expect_ais)} 个，落盘 {len(_out_ais)} 个")
                if _missing_ais:
                    print(f"  [产出校验] ⚠ 未落盘：{_missing_ais}")

        # dry-run 模式且没有产出时，伪造 versions 让下游能继续
        if dry and not versions:
            _pkey_dry = phase_cfg.get("key") or phase_cfg.get("name") or ""
            _split_spec_dry = _get_split_spec(phase_cfg, out_dir, cid)
            if _split_spec_dry and _split_spec_dry.get("列表"):
                _vers_dir = Path(out_dir) / "versions"
                versions = []
                for _it in _split_spec_dry.get("列表") or []:
                    _k = _it.get("key") or _it.get("name") or "item"
                    _safe = str(_k).replace("/", "_").replace("\\", "_").replace(":", "_").strip()[:40]
                    for w in writers:
                        versions.append(_vers_dir / w["key"] / f"{_safe}.md")
            else:
                versions = [Path(out_dir) / "versions" / f"{cid}__{w['key']}.md" for w in writers]

        reviews = []
        # 收集所有 (版本, 审核者) 组合
        _review_jobs = []
        for v in versions:
            writer_key = v.stem.split("__")[-1]
            for r in phase_reviewers:
                if r["key"] == writer_key:
                    continue                       # 不审自己写的
                _review_jobs.append((v, r))

        # 并发盲审
        if not dry and len(_review_jobs) > 1:
            print(f"\n[并发] {len(_review_jobs)} 个盲审同时发送...")
            with ThreadPoolExecutor(max_workers=min(4, len(_review_jobs))) as _ex:
                _futs = {}
                def _review_locked(_v, _r):
                    with _get_ai_lock(_r["key"]):
                        return do_review(agent, sess, _r, program, phase_cfg,
                                         cid, clabel, _v, out_dir, dry, std=_std)
                for v, r in _review_jobs:
                    _futs[_ex.submit(_review_locked, v, r)] = (v, r)
                for _fut in as_completed(_futs):
                    v, r = _futs[_fut]
                    try:
                        rv = _fut.result()
                        if rv:
                            reviews.append(rv)
                            print(f"  ✔ {r['label']} 审 {v.stem.split('__')[-1]} 完成")
                        else:
                            print(f"  ✗ {r['label']} 审 {v.stem.split('__')[-1]} 无产出")
                    except Exception as _e:
                        print(f"  ✗ {r['label']} 异常：{_e}")
        else:
            for v, r in _review_jobs:
                rv = do_review(agent, sess, r, program, phase_cfg, cid, clabel,
                               v, out_dir, dry, std=_std)
                if rv:
                    reviews.append(rv)

        if len(versions) >= 2:
            do_merge(agent, sess, phase_merger, program, phase_cfg, cid, clabel,
                     versions, reviews, out_dir, dry)
        else:
            # 只有一版时无需拼接，直接作为该块结果
            src = versions[0] if versions else None
            dst = Path(out_dir) / "merged" / f"{cid}.md"
            if src and not dry:
                write_text(dst, read_text(src))
            elif dry:
                print(f"[dry-run] 该块仅 1 版，跳过拼接，直接采用 {dst.name}")

    # 环节候选稿：按块顺序串起来
    cand = Path(out_dir) / "phase_candidate.md"
    pieces = []
    for cid, clabel, _std in chunks:
        t = read_text(Path(out_dir) / "merged" / f"{cid}.md")
        if t.strip():
            pieces.append(f"<!-- 块：{clabel} -->\n{t.strip()}")
    body = "\n\n".join(pieces)
    if dry:
        print(f"[dry-run] 环节候选稿将写入 {cand}（{len(pieces)}/{len(chunks)} 块有内容）")
    else:
        write_text(cand, body)

    # 赛马记分榜：登记参与 + 解析拼接者的采纳标记
    # （可选功能；scoreboard 缺函数时跳过，不影响主流程）
    if not dry:
        try:
            if hasattr(board_mod, "note_participation"):
                for w in {v.stem.split("__")[-1] for v in versions}:
                    board_mod.note_participation(program, phase_cfg["key"], w)
            if hasattr(board_mod, "parse_adopt_markers") and hasattr(board_mod, "record_adoptions"):
                pairs = []
                for cid, _cl, _s in chunks:
                    mt = read_text(Path(out_dir) / "merged" / f"{cid}.md")
                    for ck, wk in board_mod.parse_adopt_markers(mt):
                        pairs.append((ck or cid, wk))
                if pairs:
                    board_mod.record_adoptions(program, chapter, phase_cfg["key"], pairs)
                    print(f"📊 记分榜：本环节采纳 → "
                          + "、".join(f"{wk}×{sum(1 for _, w2 in pairs if w2 == wk)}"
                                      for wk in {w2 for _, w2 in pairs}))
        except Exception as _e:
            print(f"[记分榜] 跳过（{_e}）")
    return cand


def run_gate(agent, cfg, sess, program, candidate_path, chapter, dry, max_loop=2):
    """程序出口闸：全员投票 → 过半通过 / 未过半打回 / 平票交叉改稿再投。"""
    gate = PROGRAM_GATES[program]
    merger = sess["merge_app"]
    parts = sess["participants"]
    out_dir = (WORK / program / (f"ch{chapter}" if chapter else "")) / "_gate"
    std = _gate_standard(cfg, program)

    last_issues = ""
    for rnd in range(1, max_loop + 1):
        if dry:
            print(f"[dry-run] {gate}：将对 {candidate_path} 收 {len(parts)} 张终审票"
                  f"（第 {rnd}/{max_loop} 轮，回改上限）")
            return {"verdict": "dry", "issues": [], "notes": []}

        cand_text = read_text(candidate_path)
        if not cand_text.strip():
            print(f"[警告] {gate}：候选稿为空，无法投票。")
            return {"verdict": "insufficient", "issues": [], "notes": ["候选稿为空"]}

        vdir = out_dir / f"round{rnd}"
        votes = []
        roster_hint = "、".join(f"{p['key']}（{p['label']}）" for p in parts)
        for p in parts:
            out = vdir / f"vote__{p['key']}.json"
            task = tasks_mod.build_vote_task(p, compose_prompt("PROMPT_VOTE.md", program), cand_text,
                                             str(out), program, gate, std, roster_hint)
            ok = run_task(agent, task, dry, title=f"终审投票 | {p['label']} | {gate} 第{rnd}轮", app=p)
            if ok and not dry:
                wait_file(out)
            v = voting_mod.load_vote_file(out)
            if v:
                v.setdefault("voter", p["key"])
                votes.append(v)

        if dry:
            print(f"[dry-run] {gate} 第{rnd}轮将收集 {len(parts)} 张票（{vdir}）")
            return {"verdict": "dry", "issues": [], "notes": []}

        res = voting_mod.tally(votes)
        print(f"\n【{gate}】第 {rnd}/{max_loop} 轮：{voting_mod.summarize(res)}")
        for n in res["notes"]:
            print("   ", n)

        # 赛马记分榜：终审官在票里附 scores，给本次参战 AI 逐环节打分
        board = board_mod.record_gate(program, chapter, gate, rnd, votes, res["verdict"])
        if board.get("notes"):
            for n in board["notes"]:
                print("   ", n)
        if board.get("scores"):
            top = sorted(board["scores"].items(), key=lambda x: -x[1])[:3]
            print("📊 记分榜（本轮）：" + "、".join(f"{k} {v}" for k, v in top))

        if res["verdict"] == "pass":
            print(f"✅ {gate} 通过。")
            write_text(out_dir / "gate.json",
                       json.dumps({**res, "round": rnd, "gate": gate},
                                  ensure_ascii=False, indent=2))
            board_mod.show_crown(program)
            return res
        if res["verdict"] == "fail":
            print(f"❌ {gate} 未过半，按反对意见打回重做。")
            last_issues = voting_mod.format_issues(res["issues"])
            if rnd < max_loop:
                continue
            write_text(out_dir / "gate.json",
                       json.dumps({**res, "round": rnd, "gate": gate},
                                  ensure_ascii=False, indent=2))
            return res
        # 平票 → 交叉提意见 + 综合改稿 → 再投
        print("⚖ 平票：交叉提意见 + 综合改稿后重投。")
        cross = _cross_review_text(res["issues"])
        merged = out_dir / f"round{rnd}" / "consolidated.md"
        do_merge(agent, sess, merger, program,
                 {"key": f"{gate}综合改稿"}, "cross", "综合改稿",
                 [candidate_path], [], merged.parent, dry, extra_issues=cross or last_issues)
        if merged.exists() and merged.stat().st_size > 0:
            candidate_path = merged
        last_issues = voting_mod.format_issues(res["issues"])

    print(f"⚠ {gate} 连续 {max_loop} 轮未通过，转人工裁决。")
    return {"verdict": "manual", "issues": [], "notes": ["需人工裁决"]}


def _gate_standard(cfg, program) -> str:
    name = PROGRAM_GATES[program]
    gates = cfg.get("stageFinalGates") or []
    for g in gates:
        if g.get("gate") == name:
            lines = [f"【{name}】通过标准："]
            lines += [f"  □ {c}" for c in g.get("checks", [])]
            if g.get("platformChecks"):
                lines += [f"  □ [番茄] {c}" for c in g["platformChecks"]]
            lines.append(f"  投票规则：{g.get('passRule', '过半通过')}；"
                         f"平票时：{g.get('onTie', '交叉提意见+综合改稿+再投')}")
            lines.append("  反对票必须附「问题定位卡」四件套（位置/条目/关键句/建议），缺件不计票。")
            return "\n".join(lines)
    return ""


def _cross_review_text(issues) -> str:
    if not issues:
        return ""
    return ("以下是平票双方交叉提出的意见，请综合两侧诉求改稿（不是二选一，是找兼容解）：\n"
            + voting_mod.format_issues(issues))


# ════════════════════════════ 输入材料组装 ════════════════════════════

def phase_input(cfg, program, phase_cfg, chapter) -> str:
    """为某环节准备输入材料：上游产物 + 平台约束 + 前情。"""
    parts = []

    # _UPSTREAM_PATHS：注入读取路径 + 完成判定
    _ups = _upstream_files(program, phase_cfg, chapter)
    _out_dir = phase_dir(program, chapter, phase_cfg["key"])
    _read_block = "【读取资料（逐字读，唯一依据）】"
    if _ups:
        for _f in _ups:
            _read_block += f"\n  · {_f}"
        # 注入上游文件内容（长文件截断，防止 prompt 爆炸）
        _read_block += "\n\n【上游文件内容（已注入，可直接引用）】"
        _MAX = 4000
        for _f in _ups:
            try:
                _fp = Path(_f)
                if not _fp.exists() or not _fp.is_file():
                    continue
                _content = _fp.read_text(encoding="utf-8", errors="ignore")
                if len(_content) > _MAX:
                    _content = _content[:_MAX] + f"\n…（已截断，全文 {len(_content)} 字，请读源文件）"
                _read_block += f"\n\n--- {_fp.name} ---\n{_content}"
            except Exception:
                pass
    else:
        _read_block += "\n  （本环是第一个环节，无上游产物）"
    _read_block += (
        "\n\n【本环节输出路径（写到这里才算完成）】"
        f"\n  {_out_dir / 'versions' / (phase_cfg['key'] + '__<你的名字>.md')}"
        "\n\n【完成判定】"
        "\n  任务完成 = 下列全部满足："
        "\n    1. 文件已保存到上面「输出路径」"
        "\n    2. 文件内容非空（≥200 字）"
        "\n    3. 严格按【输出格式要求】执行"
        "\n    4. 只输出本块成品，不越界"
    )
    parts.append(_read_block)

    # _INJECT_DESC：注入本环节的任务说明（来自 rings_items.json 的 desc）
    _desc = (phase_cfg.get("desc") or "").strip()
    _name = phase_cfg.get("key") or phase_cfg.get("name") or ""
    if _desc:
        _task_block = f"【本环节任务说明：{_name}】\n{_desc}"
        # 从 apps.json 的 auditDirections 找本环归属方向，附上验收标准
        try:
            _dirs = cfg.get("auditDirections") or []
            for _d in _dirs:
                _rings = list(_d.get("rings") or []) + list(_d.get("extends") or [])
                if _name in _rings:
                    _std = _d.get("standards") or []
                    _fail = _d.get("failPatterns") or []
                    if _std:
                        _task_block += "\n\n【本方向审核标准（逐条满足）】"
                        for _s in _std:
                            _task_block += f"\n  □ {_s}"
                    if _fail:
                        _task_block += "\n\n【反模式（命中即判不合格）】"
                        for _f in _fail:
                            _task_block += f"\n  ✗ {_f}"
                    break
        except Exception:
            pass
        parts.append(_task_block)

    # _KEYWORDS：注入本环节关键词（从 apps.json 自动提取）
    try:
        _kw = keywords_for_phase(cfg, program, phase_cfg)
        _kb = "【本环节关键词（落笔时逐条对照）】"
        _has = False
        if _kw["内容词"]:
            _kb += "\n  内容词：" + "、".join(_kw["内容词"][:30])
            _has = True
        if _kw["动作词"]:
            _kb += "\n  动作词：" + "、".join(_kw["动作词"][:30])
            _has = True
        if _kw["红线"]:
            _kb += "\n  红线：" + "、".join(_kw["红线"])
            _has = True
        if _has:
            parts.append(_kb)
    except Exception:
        pass
    pb = platform_block(cfg)
    if pb:
        parts.append(pb)

    prev = (WORK / program / (f"ch{chapter}" if chapter else "") / "_context.md")
    if prev.exists():
        parts.append("【前情/上游产物】\n" + read_text(prev))

    if program == "写作" and chapter:
        locked = WORK / "规划" / "章纲" / "phase_candidate.md"
        if locked.exists():
            parts.append("【本章章纲（锁定）】\n" + read_text(locked))
        lib = WORK / "library"
        if lib.exists():
            recent = sorted(lib.glob("*.md"))[-2:]
            if recent:
                parts.append("【最近已入库章节（承接用）】\n"
                             + "\n\n".join(read_text(p) for p in recent))
    if program == "写作":
        eb = env_block(cfg, phase_cfg.get("craft"))
        if eb:
            parts.append(eb)
    if program == "润色" and chapter:
        body = WORK / "写作" / f"ch{chapter}" / "正文" / "phase_candidate.md"
        if body.exists():
            parts.append("【待润色正文】\n" + read_text(body))
    if program == "质检" and chapter:
        pol = WORK / "润色" / f"ch{chapter}" / "润色" / "phase_candidate.md"
        if pol.exists():
            parts.append("【已润色定稿】\n" + read_text(pol))
    if not parts:
        parts.append("（无上游材料，请依据指令中的标准自行推进）")
    return "\n\n".join(parts)


# ════════════════════════════ 主流程 ════════════════════════════

def cmd_check_session(cfg, sess):
    print("=" * 74)
    print("今日阵容校验")
    print("=" * 74)
    for p in sess["participants"]:
        print(f"  ● {p['label']:<18} {p['form']:<8} {p.get('target', '')}")
    print(f"  拼接者：{(sess['merge_app'] or {}).get('label', '(无)')}")
    if sess["warnings"]:
        print("\n告警：")
        for w in sess["warnings"]:
            print(f"  ! {w}")
    else:
        print("\n无告警，可以开跑。")
    return not any("至少需要 2 名" in w for w in sess["warnings"])


def cmd_probe(agent, cfg, sess, dry):
    """逐个探测今日阵容的可用性，产出 probe 报告。"""
    out_dir = WORK / "_probe"
    ok_list, bad_list = [], []
    for p in sess["participants"]:
        out = out_dir / f"{p['key']}.txt"
        task = tasks_mod.build_probe_task(p, str(out))
        run_task(agent, task, dry, title=f"探测 | {p['label']}", app=p)
        if dry:
            continue
        wait_file(out, timeout=90)
        line = read_text(out).strip().splitlines()
        line = line[0] if line else ""
        if "| ready" in line and "notready" not in line:
            ok_list.append(p["label"])
        else:
            bad_list.append((p["label"], line or "无输出"))
    if not dry:
        print("\n可用：" + ("、".join(ok_list) or "无"))
        if bad_list:
            print("不可用：")
            for lb, why in bad_list:
                print(f"  ✗ {lb} —— {why}")
            print("请先在浏览器/客户端里登录好，再用 session.py 调整今日阵容。")


def _upstream_candidate(program, chapter):
    """找某个程序编排时应对其投票的上游定稿。

    质检程序按你的流程：质检汇总 → 成书检验 → 上架前低级错误检查 → 入库 → 推演下一章。
    故成书检验的表决对象是「质检汇总」的产物（缺失时退到润色定稿），
    绝不能退到「推演下一章」——那是入库之后的下一章准备，不属于本章待检对象。
    """
    base = f"ch{chapter}" if chapter else ""
    if program == "质检":
        for cand in (
            WORK / "质检" / base / "质检汇总" / "phase_candidate.md",
            WORK / "润色" / base / "润色" / "phase_candidate.md",
        ):
            if cand.exists():
                return cand
    d = WORK / program / base
    cands = sorted(d.glob("*/phase_candidate.md"))
    return cands[-1] if cands else (d / "phase_candidate.md")


# 只投票、不产出的环节（对上游定稿做闸门判定）
GATE_ONLY_PHASES = ("成书检验",)


def run_program(agent, cfg, sess, program, chapter, dry, only_phase=None,
                once=False, max_loop=2):
    phases = _load_phases(cfg, program)
    if not phases:
        print(f"[错误] apps.json 里没有程序「{program}」的环节。")
        return
    if only_phase:
        phases = [p for p in phases if p["key"] == only_phase]
        if not phases:
            print(f"[错误] 程序「{program}」下没有环节「{only_phase}」。")
            return

    print("\n" + "█" * 74)
    print(f"█ 程序：{program}　环节数：{len(phases)}　章：{chapter or '（一次性）'}")
    print(f"█ 出口闸：{PROGRAM_GATES[program]}")
    print("█" * 74)

    for ph in phases:
        if ph.get("mode") == "human":
            print(f"\n▶ 环节「{ph['key']}」为【人工定·AI 辅助】，跳过自动网格。")
            print(f"   说明：{ph.get('desc', '')}")
            print(f"   请在 {WORK / program / ph['key']} 放置人工定稿，或让 AI 出候选后自行拍板。")
            continue
        if ph.get("mode") == "fixed":
            print(f"\n▶ 环节「{ph['key']}」为【固定流程】，请人工确认。")
            print(f"   说明：{ph.get('desc', '')}")
            continue
        if ph.get("mode") == "storage":
            _do_storage(cfg, program, chapter, dry)
            if program == "质检":
                # 入库之后、推演下一章之前：按期连贯性综合复检
                run_periodic_recheck(agent, cfg, sess, chapter, dry, once)
            continue
        if ph["key"] in GATE_ONLY_PHASES:
            up = _upstream_candidate(program, chapter)
            print(f"\n▶ 环节「{ph['key']}」为【只投票·不产出】，直接对上游定稿表决：{up}")
            run_gate(agent, cfg, sess, program, up, chapter, dry, max_loop)
            continue

        inp = phase_input(cfg, program, ph, chapter)
        cand = run_mesh_phase(agent, cfg, sess, program, ph, chapter, inp, dry, once=once)
        if ph.get("finalGate"):
            run_gate(agent, cfg, sess, program, cand, chapter, dry, max_loop)

    # 程序出口闸
    if not only_phase:
        run_gate(agent, cfg, sess, program,
                 _upstream_candidate(program, chapter), chapter, dry, max_loop)


def run_pipeline(agent, cfg, sess, ch, dry, once, max_loop):
    """整章流水线：写作 → 润色 → 质检 → 出厂"""
    for program in ("写作", "润色", "质检", "出厂"):
        print(f"\n{'█' * 74}")
        print(f"█ 第 {ch} 章 · {program}")
        print("█" * 74)
        try:
            run_program(agent, cfg, sess, program, ch, dry, None, once, max_loop)
        except Exception as _e:
            print(f"[错误] {program} 程序失败：{_e}")
            return False
    return True


def _parse_chapters(s):
    """解析章范围：'1-150' / '1,3,5' / '5' → [1,2,...,150] 等"""
    s = (s or "").strip()
    if not s:
        return []
    out = []
    for part in s.split(","):
        part = part.strip()
        if "-" in part:
            a, b = part.split("-", 1)
            try:
                a, b = int(a.strip()), int(b.strip())
                out.extend(range(a, b + 1))
            except Exception:
                pass
        else:
            try:
                out.append(int(part))
            except Exception:
                pass
    return out


def _chapter_num(chapter):
    try:
        return int(str(chapter).lstrip("0") or "0")
    except Exception:                              # noqa: BLE001
        return 0


def _recheck_input(cfg, chapter, scope_key) -> str:
    """组装配检材料：平台约束 + 待检正文（近 10 章或全文）+ 已锁章纲。"""
    parts = []
    pb = platform_block(cfg)
    if pb:
        parts.append(pb)
    lib = WORK / "library"
    if lib.exists():
        files = sorted(lib.glob("*.md"))
        if scope_key.startswith("近"):
            files = files[-10:]
        if files:
            parts.append(f"【待复检正文（{scope_key}，共 {len(files)} 章）】\n"
                         + "\n\n".join(f"── {p.name} ──\n{read_text(p)}" for p in files))
    locked = WORK / "规划" / "章纲" / "phase_candidate.md"
    if locked.exists():
        parts.append("【已锁章纲（对照主线是否跑偏）】\n" + read_text(locked))
    if not parts:
        parts.append("（尚无已入库正文，复检为空跑）")
    return "\n\n".join(parts)


def run_periodic_recheck(agent, cfg, sess, chapter, dry, once=False, force=False):
    """每 N 章连贯性综合复检（入库之后、推演下一章之前触发）。

    只复盘、不出稿、不投票：输出带优先级的「问题定位卡」清单，交作者裁定。
    force=True 时忽略「章号是否为 N 的倍数」，手动跑一次。
    """
    pr = cfg.get("periodicRecheck") or {}
    if not pr or not chapter:
        return None
    every = int((pr.get("trigger") or {}).get("every") or 10)
    n = _chapter_num(chapter)
    if not force and (n <= 0 or n % every):
        return None

    print("\n" + "★" * 74)
    print(f"★ 每 {every} 章 · 连贯性综合复检（第 {n} 章入库后触发）")
    print(f"★ 参与：全员 {len(sess['participants'])} 人；输出问题定位卡交作者裁定，不自动改稿")
    print("★" * 74)

    out_root = WORK / "质检" / f"ch{chapter}" / "_recheck"
    reports = []
    for scope in pr.get("scopes", []):
        skey = scope.get("key", "复检")
        checks = scope.get("checks", [])
        std = ("【本范围的检查项（逐条核对，不得增删）】\n"
               + "\n".join(f"  □ {c}" for c in checks)
               + "\n\n【严重度】" + "；".join(
                   f"{k}={v}" for k, v in (pr.get("output", {}).get("priorityLevels") or {}).items())
               + "\n\n【输出格式】逐条给出问题定位卡：\n"
                 "  ① 位置（程序 › 环节 › 卷 › 章 › 六要素段位 › 场景 › 第N段）\n"
                 "  ② 命中条目（违反的标准/设定/伏笔编号）\n"
                 "  ③ 正文关键句（原样可搜字串 + 2—4 个唯一检索词）\n"
                 "  ④ 修改建议（改法方向 + 改动范围）\n"
                 "  另附：优先级（P0/P1/P2/P3）与影响范围。")
        pcfg = {"key": f"复检·{skey}"}
        inp = _recheck_input(cfg, chapter, skey)
        cand = run_mesh_phase(agent, cfg, sess, "质检", pcfg, chapter, inp, dry,
                              once=once, custom_chunks=[(skey, skey, std)])
        reports.append((skey, cand))

    if dry:
        print(f"[dry-run] 复检报告将写入 {out_root / 'recheck_report.md'}")
        return None

    body = [f"# 第 {n} 章 · 每 {every} 章连贯性综合复检报告",
            f"\n触发：第 {n} 章入库后（下一章写作前）　参与：全员 {len(sess['participants'])} 人",
            "\n> 作者裁定：逐卡三选一 —— 改（按类型回对应程序返修）／不改（留档，不阻断更新）／延后。",
            "\n> AI 只出定位卡与建议，不代替作者决定。已发布正文除非作者确认否则不回改。\n"]
    for skey, cand in reports:
        body.append(f"\n## {skey}\n")
        body.append(read_text(cand).strip() or "（无内容）")
    out = out_root / "recheck_report.md"
    write_text(out, "\n".join(body))
    print(f"✔ 复检报告已出：{out}")
    print("  请人工过一遍定位卡，逐张三选一（改 / 不改 / 延后）。")
    return out


def _do_storage(cfg, program, chapter, dry):
    base = f"ch{chapter}" if chapter else ""
    d = WORK / program / base
    src = d / "上架前低级错误检查" / "phase_candidate.md"
    if not src.exists():
        # 回退时排除「推演下一章」——那是下一章的输入，不是本章定稿
        cands = [p for p in sorted(d.glob("*/phase_candidate.md"))
                 if "推演下一章" not in str(p)]
        src = cands[-1] if cands else None
    dst = WORK / "library" / (f"第{chapter}章.md" if chapter else "成书.md")
    if dry:
        print(f"[dry-run] 入库：{src} → {dst}")
        return
    if src and src.exists():
        write_text(dst, read_text(src))
        print(f"✔ 已入库：{dst}")
    else:
        print("[警告] 找不到可入库的定稿。")


def main():
    ap = argparse.ArgumentParser(description="多 AI 协作写作流水线 · 四程序编排")
    ap.add_argument("--program", choices=["规划", "写作", "润色", "质检", "出厂"])
    ap.add_argument("--chapter", default="", help="章号，如 0057（规划程序可不填）")
    ap.add_argument("--phase", default="", help="只跑该程序下的某一个环节")
    ap.add_argument("--dry-run", action="store_true", help="只打印任务不驱动")
    ap.add_argument("--loop", type=int, default=2, help="出口闸最大回改轮数")
    ap.add_argument("--once", action="store_true", help="每环节只让 1 名 AI 产出（省额度试跑）")
    ap.add_argument("--pipeline", action="store_true", help="整章流水线：写作→润色→质检→出厂")
    ap.add_argument("--chapters", default="", help="章范围，如 1-150 / 1,3,5")
    ap.add_argument("--check-session", action="store_true", help="只校验今日阵容")
    ap.add_argument("--probe", action="store_true", help="探测今日阵容可用性")
    ap.add_argument("--recheck", action="store_true",
                    help="手动触发一次按期连贯性复检（配合 --chapter）")
    ap.add_argument("--board", nargs="?", const="ALL", default=None, metavar="程序",
                    help="查看赛马记分榜（可带程序名过滤，如 --board 写作）")
    args = ap.parse_args()

    if args.board:
        prog = None if args.board == "ALL" else args.board
        board_mod.show(prog)
        print()
        board_mod.show_crown(prog)
        print()
        board_mod.show_best_at(prog)
        return

    cfg = load_cfg()
    global agent_cfg
    agent_cfg = cfg

    roster = session_mod.load_roster()
    today = session_mod.load_today()
    sess = session_mod.resolve(roster, today,
                               program=args.program, phase=args.phase or None,
                               chapter=args.chapter or None)

    if args.check_session:
        ok = cmd_check_session(cfg, sess)
        sys.exit(0 if ok else 1)

    if not sess["participants"]:
        print("[错误] 今日阵容为空。先用 `python session.py show` 登记今天打开了哪些 AI。")
        sys.exit(1)

    agent = None
    if not args.dry_run:
        try:
            agent = get_agent()
        except Exception as _e:
            print(f"[警告] windows_use agent 初始化失败（{_e}）")
            print("       若所有 AI 都走 CDP，可继续运行；否则需要 Ollama。")
            agent = None

    if args.probe:
        cmd_probe(agent, cfg, sess, args.dry_run)
        return

    if args.recheck:
        if not args.chapter:
            print("[错误] --recheck 需要配合 --chapter 指定刚入库的章号。")
            sys.exit(1)
        run_periodic_recheck(agent, cfg, sess, args.chapter, args.dry_run, force=True)
        return

    if args.pipeline:
        chs = _parse_chapters(args.chapters)
        if not chs:
            print("[错误] --pipeline 需要 --chapters，例：--chapters 1-150")
            sys.exit(1)
        print(f"\n流水线模式：共 {len(chs)} 章，程序顺序 写作→润色→质检→出厂")
        for _ch in chs:
            _ch_str = str(_ch).zfill(4)
            print(f"\n{'=' * 74}")
            print(f"=== 第 {_ch} 章（{_ch_str}）开始 ===")
            print("=" * 74)
            run_pipeline(agent, cfg, sess, _ch_str, args.dry_run, args.once, args.loop)
        print("\n流水线结束。")
        return

    if not args.program:
        print("[提示] 未指定 --program。可用的程序：规划 / 写作 / 润色 / 质检 / 出厂")
        print("       例：python orchestrator.py --program 写作 --chapter 0057 --dry-run")
        print("       例：python orchestrator.py --pipeline --chapters 1-150")
        cmd_check_session(cfg, sess)
        return

    run_program(agent, cfg, sess, args.program, args.chapter or None,
                args.dry_run, args.phase or None, args.once, args.loop)
    print("\n编排结束。")


def _do_produce_renwu(agent, sess, app, program, phase_cfg, chunk_id, chunk_label,
                       input_text, out_dir, dry, extra_note="", ai_assist=False):
    """人物设计：读名单，为每个人物单独调一次 AI，各自落一个文件。"""
    import json as _json

    _od = Path(out_dir)
    _info = None
    for _p in [_od] + list(_od.parents):
        for _c in (_p / "00_初始化" / "项目信息.json", _p / "项目信息.json"):
            if _c.exists():
                _info = _c
                break
        if _info:
            break

    if not _info:
        print("   [人物设计] 未找到 项目信息.json，退回通用产出")
        _out = Path(out_dir) / "versions" / f"{chunk_id}__{app['key']}.md"
        _out.parent.mkdir(parents=True, exist_ok=True)
        return _out

    try:
        _data = _json.loads(_info.read_text(encoding="utf-8"))
    except Exception as _e:
        print(f"   [人物设计] 读 项目信息.json 失败：{_e}")
        return Path(out_dir) / "versions" / f"{chunk_id}__{app['key']}.md"

    _persons = _data.get("人物设计列表") or []
    if not _persons:
        print("   [人物设计] 人物设计列表为空，跳过")
        return []

    print(f"   [人物设计] 名单 {len(_persons)} 人：{_persons}")

    _versions_dir = Path(out_dir) / "versions"
    _versions_dir.mkdir(parents=True, exist_ok=True)

    _tpl = compose_prompt("PROMPT_PRODUCE.md", program)
    _base_note = format_note(program, phase_cfg)
    if extra_note:
        _base_note = (_base_note + "\n\n【上一轮终审反对意见（必须逐条对应处理）】\n" + extra_note).strip()

    _produced = []
    for _name in _persons:
        _safe = _name.replace("/", "_").replace("\\", "_").replace(":", "_").strip()[:40]
        _out = _versions_dir / f"{_safe}__{app['key']}.md"

        _person_input = input_text
        _person_note = (_base_note or "") + "\n\n【本次任务】只为人物「" + _name + "」写一份完整档案，不要写其他人。"
        _label = f"{program} › {phase_cfg.get('key') or phase_cfg.get('name') or ''} › {_name}"

        if ai_assist:
            _task = tasks_mod.build_scaffold_task(app, _tpl, _person_input, str(_out), _label)
        else:
            _task = tasks_mod.build_produce_task(
                app, _tpl, _person_input, str(_out),
                _label, f"{chunk_label} · {_name}", _person_note
            )

        _ok = run_task(agent, _task, dry,
                       title=f"产出 | {app['label']} | 人物设计 | {_name}",
                       app=app)

        if _ok and not dry:
            wait_file(_out, timeout=60)
            if not (_out.exists() and _out.stat().st_size > 0):
                try:
                    import sys as _s
                    _wu = HERE.parent
                    if str(_wu) not in _s.path:
                        _s.path.insert(0, str(_wu))
                    from mix_send import capture_with_meta as _cap
                    _r0 = _cap(app["key"])
                    _baseline = ((_r0 or {}).get("text", "") if isinstance(_r0, dict) else str(_r0 or "")).strip()
                    _txt = ""
                    for _try in range(30):
                        _r = _cap(app["key"])
                        _cur = ((_r or {}).get("text", "") if isinstance(_r, dict) else str(_r or "")).strip()
                        if _cur and len(_cur) >= 50 and _cur != _baseline:
                            _txt = _cur
                            break
                        time.sleep(6)
                    if _txt:
                        _out.write_text(_txt, encoding="utf-8")
                        print(f"   [人物设计|{_name}] capture 落盘：{_out.name}")
                except Exception as _e:
                    print(f"   [人物设计|{_name}] capture 失败：{_e}")

        if dry:
            _produced.append(_out)
            print(f"   [人物设计|{_name}] (dry-run) {_out.name}")
        elif _out.exists() and _out.stat().st_size > 0:
            _produced.append(_out)
            print(f"   [人物设计|{_name}] [OK] {_out.name}")
        else:
            print(f"   [人物设计|{_name}] [FAIL] 无产出")

    return _produced


def _extract_json_block(text):
    """从 AI 输出里提取 json 代码块，返回解析后的 dict 或 None。"""
    import re as _re, json as _json
    if not text:
        return None
    m = _re.search(r"```json\s*\n(.*?)\n```", text, flags=_re.DOTALL | _re.IGNORECASE)
    if not m:
        return None
    try:
        return _json.loads(m.group(1))
    except Exception:
        return None


def _get_current_stage(out_dir):
    """从项目目录/进度.json 读当前阶段信息。返回 dict（含 阶段号/起章/止章）或 None。"""
    import json as _json
    od = Path(out_dir)
    for p in [od] + list(od.parents):
        pj = p / "进度.json"
        if pj.exists():
            try:
                data = _json.loads(pj.read_text(encoding="utf-8"))
            except Exception:
                return None
            stage_no = data.get("当前阶段") or 1
            for s in data.get("阶段列表") or []:
                if s.get("阶段号") == stage_no:
                    return s
            return None
    return None


def _chunk_range(chunk_id):
    """从 chunk_id 解析起止章，如 '1-30' -> (1, 30)；解析不出返回 None。"""
    import re as _re
    m = _re.match(r"^(\d+)-(\d+)$", str(chunk_id).strip())
    if m:
        return int(m.group(1)), int(m.group(2))
    return None


def _chunk_overlaps_stage(chunk_id, out_dir):
    """检查 chunk 是否与当前阶段有交集。无法解析或无阶段时返回 True（不跳过）。"""
    r = _chunk_range(chunk_id)
    if not r:
        return True
    stage = _get_current_stage(out_dir)
    if not stage:
        return True
    s_start = stage.get("起章") or 1
    s_end = stage.get("止章") or 99999
    c_start, c_end = r
    return c_end >= s_start and c_start <= s_end


def _get_split_spec(phase_cfg, out_dir, chunk_id=None):
    """按环节名读上游 split.json，支持阶段过滤。"""
    import json as _json
    name = phase_cfg.get("name") or phase_cfg.get("key") or ""
    src = SPLIT_SOURCES.get(name)
    if not src:
        return None

    if isinstance(src, tuple):
        src_name, mode = src
    else:
        src_name, mode = src, None

    # src_name 含 "/" 时按项目根开始（跨程序读），否则按当前 out_dir.parent 找
    if "/" in src_name:
        # 从 out_dir 向上找项目根（含 00_初始化 或 进度.json 的目录）
        _root = Path(out_dir)
        for _p in [_root] + list(_root.parents):
            if (_p / "00_初始化").exists() or (_p / "进度.json").exists():
                _root = _p
                break
        src_dir = _root / src_name
    else:
        src_dir = Path(out_dir).parent / src_name
    split_json = src_dir / "split.json"
    if not split_json.exists():
        print(f"   [split] 上游 split.json 不存在：{split_json}")
        return None
    try:
        data = _json.loads(split_json.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"   [split] 读 split.json 失败：{e}")
        return None

    if not mode:
        return data

    stage = _get_current_stage(out_dir)
    if not stage:
        print(f"   [split] 找不到当前阶段，按全量走")
        return data

    s_start = stage.get("起章") or 1
    s_end = stage.get("止章") or 99999
    # chunk 范围（用于二次过滤）
    _cr = _chunk_range(chunk_id) if chunk_id else None
    c_start, c_end = _cr if _cr else (0, 99999)
    items = data.get("列表") or []
    filtered = []
    for it in items:
        it_start = it.get("start") or it.get("起章") or 0
        it_end = it.get("end") or it.get("止章") or 0
        if it_end == 0:
            filtered.append(it)
            continue
        # 同时满足：在阶段范围内 + 在 chunk 范围内
        if it_end >= s_start and it_start <= s_end and it_end >= c_start and it_start <= c_end:
            filtered.append(it)

    if mode == "current_stage_merged":
        if not filtered:
            print(f"   [split] 阶段{stage.get('阶段号')} 与当前 chunk 无交集，跳过")
            data["列表"] = []
            return data
        merged_key = f"阶段{stage.get('阶段号')}_{s_start}-{s_end}"
        data["列表"] = [{
            "key": merged_key,
            "name": f"阶段{stage.get('阶段号')}（{s_start}-{s_end}章）",
            "起章": s_start,
            "止章": s_end,
            "子项": filtered,
        }]
        print(f"   [split] 阶段{stage.get('阶段号')}（{s_start}-{s_end}章）：合并为 1 个任务，含 {len(filtered)} 子项")
    elif mode == "current_stage_split":
        if not filtered:
            print(f"   [split] 阶段{stage.get('阶段号')} 与当前 chunk 无交集，跳过")
            data["列表"] = []
            return data
        data["列表"] = filtered
        print(f"   [split] 阶段{stage.get('阶段号')}（{s_start}-{s_end}章）：过滤后 {len(filtered)} 个任务")
    else:
        print(f"   [split] 未知 mode：{mode}")

    return data


def _maybe_extract_split(phase_cfg, main_path, out_dir):
    """如果本环节是 split 生产者，从产出提取 JSON 并写 split.json。"""
    import json as _json
    name = phase_cfg.get("name") or phase_cfg.get("key") or ""
    if name not in SPLIT_PRODUCERS:
        return
    try:
        text = Path(main_path).read_text(encoding="utf-8", errors="ignore")
    except Exception as e:
        print(f"   [split] 读产出失败：{e}")
        return
    data = _extract_json_block(text)
    if not data:
        print(f"   [split] 未找到 JSON 块：{Path(main_path).name}")
        return
    data["环节"] = phase_cfg.get("code") or ""
    data["环节名"] = name
    out_json = Path(out_dir) / "split.json"
    out_json.write_text(_json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
    print(f"   [split] 已写出：{out_json.name}（{len(data.get('列表') or [])} 项）")


def _do_produce_split(agent, sess, app, program, phase_cfg, chunk_id, chunk_label,
                       input_text, out_dir, dry, extra_note, ai_assist, split_spec):
    """通用拆分引擎：按 split_spec['列表'] 循环调 AI，每项独立落盘。"""
    import json as _json
    items = split_spec.get("列表") or []
    if not items:
        return []

    _versions_dir = Path(out_dir) / "versions"
    _versions_dir.mkdir(parents=True, exist_ok=True)

    _tpl = compose_prompt("PROMPT_PRODUCE.md", program)
    _base_note = format_note(program, phase_cfg) or ""
    if extra_note:
        _base_note = (_base_note + "\n\n【上一轮终审反对意见（必须逐条对应处理）】\n" + extra_note).strip()

    _phase_name = phase_cfg.get("key") or phase_cfg.get("name") or ""
    _produced = []

    for _idx, item in enumerate(items, start=1):
        _key = item.get("key") or item.get("任务名") or item.get("name") or f"item{_idx}"
        _safe = _key.replace("/", "_").replace("\\", "_").replace(":", "_").strip()[:40]
        _out = _versions_dir / f"{chunk_id}__{app['key']}__{_safe}.md"

        _item_note = (_base_note + "\n\n【本次任务（只做这一项，不要处理其他项）】\n"
                       + _json.dumps(item, ensure_ascii=False, indent=2))
        _label = f"{program} › {_phase_name} › {_key}"

        # 按章追加专属上游（写作阶段：W0 读 P18 章纲；W1~W4 读前序环节同章产出）
        _ch_no = item.get("start") or item.get("end") or item.get("章号") or 0
        try:
            _ch_no = int(_ch_no)
        except Exception:
            _ch_no = 0
        if _ch_no:
            _extra_input = _read_upstream_for_chapter(program, phase_cfg, _ch_no, out_dir)
            if _extra_input:
                _item_input = input_text + "\n\n" + _extra_input
                print(f"   [{_key}] 追加按章上游：{len(_extra_input)} 字")
            else:
                _item_input = input_text
        else:
            _item_input = input_text

        if ai_assist:
            _task = tasks_mod.build_scaffold_task(app, _tpl, _item_input, str(_out), _label)
        else:
            _task = tasks_mod.build_produce_task(
                app, _tpl, _item_input, str(_out),
                _label, f"{chunk_label} · {_key}", _item_note
            )

        _ok = run_task(agent, _task, dry,
                        title=f"产出 | {app['label']} | {_phase_name} | {_key}",
                        app=app)

        if _ok and not dry:
            wait_file(_out, timeout=60)
            if not (_out.exists() and _out.stat().st_size > 0):
                try:
                    import sys as _s
                    _wu = HERE.parent
                    if str(_wu) not in _s.path:
                        _s.path.insert(0, str(_wu))
                    from mix_send import capture_with_meta as _cap
                    _r0 = _cap(app["key"])
                    _baseline = ((_r0 or {}).get("text", "") if isinstance(_r0, dict) else str(_r0 or "")).strip()
                    _txt = ""
                    for _try in range(30):
                        _r = _cap(app["key"])
                        _cur = ((_r or {}).get("text", "") if isinstance(_r, dict) else str(_r or "")).strip()
                        if _cur and len(_cur) >= 50 and _cur != _baseline:
                            _txt = _cur
                            break
                        time.sleep(6)
                    if _txt:
                        _out.write_text(_txt, encoding="utf-8")
                        print(f"   [{_key}] capture 落盘：{_out.name}")
                except Exception as _e:
                    print(f"   [{_key}] capture 失败：{_e}")

        if dry:
            _produced.append(_out)
            print(f"   [{_key}] (dry-run) {_out.name}")
        elif _out.exists() and _out.stat().st_size > 0:
            _produced.append(_out)
            print(f"   [{_key}] [OK] {_out.name}")
        else:
            print(f"   [{_key}] [FAIL] 无产出")

    return _produced


def _read_upstream_for_chapter(program, phase_cfg, chapter_no, out_dir):
    """为第 N 章读专属上游文件内容，返回拼好的字符串（可能为空）。
    写作阶段专用：W0 读 P18 章纲，W1~W4 读同程序前序环节的同章产出。
    """
    parts = []
    name = phase_cfg.get("name") or phase_cfg.get("key") or ""
    od = Path(out_dir)

    WRITE_ORDER = ["W0_细纲分析", "W1_章前对齐卡", "W2_分布", "W3_正文", "W4_章内节奏自检"]

    # ── 质检：读 03_去AI/R1_润色 的同章产出 ──
    if program == "质检" and name.startswith("Q"):
        proj_root = od.parent.parent
        r1_dir = proj_root / "03_去AI" / "R1_润色" / "versions"
        if r1_dir.exists():
            for f in sorted(r1_dir.glob(f"*/章{chapter_no}.md")):
                try:
                    c = f.read_text(encoding="utf-8", errors="ignore")
                    if len(c) > 8000:
                        c = c[:8000] + f"\n…（已截断，全文 {len(c)} 字）"
                    parts.append(f"【上游：R1_润色 第{chapter_no}章（{f.name}）】\n{c}")
                except Exception:
                    pass

    # ── 润色：读 02_写作/W3_正文 的同章产出 ──
    if program == "润色" and "润色" in name:
        proj_root = od.parent.parent     # .../03_去AI/R1_润色 → 项目根
        w3_dir = proj_root / "02_写作" / "W3_正文" / "versions"
        if w3_dir.exists():
            for f in sorted(w3_dir.glob(f"*/章{chapter_no}.md")):
                try:
                    c = f.read_text(encoding="utf-8", errors="ignore")
                    if len(c) > 8000:
                        c = c[:8000] + f"\n…（已截断，全文 {len(c)} 字）"
                    parts.append(f"【上游：W3_正文 第{chapter_no}章（{f.name}）】\n{c}")
                except Exception:
                    pass

    if program == "写作" and name in WRITE_ORDER:
        write_root = od.parent          # .../02_写作/
        cur_idx = WRITE_ORDER.index(name)

        # W0 读 01_规划/前30章落地章纲/versions/*__章N.md
        if cur_idx == 0:
            proj_root = write_root.parent
            p18_dir = proj_root / "01_规划" / "前30章落地章纲" / "versions"
            if p18_dir.exists():
                for f in sorted(p18_dir.glob(f"*/章{chapter_no}.md")):
                    try:
                        c = f.read_text(encoding="utf-8", errors="ignore")
                        if len(c) > 4000:
                            c = c[:4000] + f"\n…（已截断，全文 {len(c)} 字）"
                        parts.append(f"【上游：前30章落地章纲 第{chapter_no}章（{f.name}）】\n{c}")
                    except Exception:
                        pass

        # W1~W4 读同程序前序环节的同章产出
        for prev_name in WRITE_ORDER[:cur_idx]:
            prev_dir = write_root / prev_name / "versions"
            if not prev_dir.exists():
                continue
            for f in sorted(prev_dir.glob(f"*/章{chapter_no}.md")):
                try:
                    c = f.read_text(encoding="utf-8", errors="ignore")
                    if len(c) > 4000:
                        c = c[:4000] + f"\n…（已截断，全文 {len(c)} 字）"
                    parts.append(f"【上游：{prev_name} 第{chapter_no}章（{f.name}）】\n{c}")
                except Exception:
                    pass

    return "\n\n".join(parts)


# ═══════════════════════════════════════════════════════════════════════
# 批量多文件产出引擎 + 重试兜底
# ═══════════════════════════════════════════════════════════════════════

# ── 重试参数（已在设计阶段确认）──
RETRY_T_FIRST      = 200    # 首轮等待（秒）
RETRY_T_BUSY_LOOP  = 100    # AI 忙时再等（秒）
RETRY_T_RETRY      = 200    # 重试等待（秒）
RETRY_MAX_ATTEMPTS = 3      # 单 AI 最多尝试次数（首轮 + 2 次重试）


def _read_expected_files(phase_cfg, out_dir, chunk_id=None):
    """读本环节期望产出的文件清单。
    返回 [(item_key, item_data), ...]（按 split.json 的列表）。
    """
    spec = _get_split_spec(phase_cfg, out_dir, chunk_id)
    if not spec:
        return []
    items = spec.get("列表") or []
    return [(it.get("key") or it.get("name") or f"item{i}", it)
            for i, it in enumerate(items, 1)]


def _build_batch_prompt(phase_cfg, expected, out_dir, ai_key):
    """构造"生成 N 个文件"的 prompt，附完整文件清单。
    返回 (清单文本, [(item_key, out_path), ...])
    """
    lines = [f"【本环节需生成的完整文件清单（共 {len(expected)} 个，一个都不能漏）】"]
    paths = []
    versions_dir = Path(out_dir) / "versions"
    for item_key, item_data in expected:
        safe = str(item_key).replace("/", "_").replace("\\", "_").replace(":", "_").strip()[:40]
        out_path = versions_dir / f"{ai_key}__{safe}.md"
        paths.append((item_key, out_path))
        lines.append(f"  · {item_key}   →   {out_path}")
    lines.append("")
    lines.append("【完成判定】")
    lines.append(f"  - 必须生成上面清单里全部 {len(expected)} 个文件")
    lines.append(f"  - 每个文件 ≥ 200 字")
    lines.append(f"  - 文件不存在或不完整 = 任务失败")
    return "\n".join(lines), paths


def _write_failed_record(project_root, phase_key, stage, attempts, task_preview):
    """写失败记录到 <project>/_failed/<phase_key>/<stage>.json。"""
    import json as _json
    failed_dir = Path(project_root) / "_failed"
    phase_dir = failed_dir / phase_key
    phase_dir.mkdir(parents=True, exist_ok=True)

    record = {
        "phase_key": phase_key,
        "stage": stage,
        "attempts": attempts,
        "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
        "task_preview": task_preview[:300],
        "status": "pending",
    }
    (phase_dir / f"{stage}.json").write_text(
        _json.dumps(record, ensure_ascii=False, indent=2),
        encoding="utf-8",
    )

    # 更新 _index.json
    index_path = failed_dir / "_index.json"
    index = {"by_phase": {}, "updated": record["timestamp"]}
    if index_path.exists():
        try:
            index = _json.loads(index_path.read_text(encoding="utf-8"))
            index["updated"] = record["timestamp"]
        except Exception:
            pass
    plist = index.setdefault("by_phase", {}).setdefault(phase_key, [])
    if stage not in plist:
        plist.append(stage)
    index["total"] = sum(len(v) for v in index["by_phase"].values())
    index_path.write_text(
        _json.dumps(index, ensure_ascii=False, indent=2),
        encoding="utf-8",
    )
    print(f"   ⛔ 已写失败记录：{phase_dir / (stage + '.json')}")


def _judge_task_status(ai_key, verify_fn, wait_sec):
    """等待 wait_sec，每 5s 检查一次。
    返回 'success' / 'busy' / 'idle_no_output'
    """
    try:
        from mix_send import is_ai_busy
    except Exception:
        time.sleep(wait_sec)
        ok, _ = verify_fn()
        return "success" if ok else "idle_no_output"

    t0 = time.time()
    while time.time() - t0 < wait_sec:
        ok, _ = verify_fn()
        if ok:
            return "success"
        if not is_ai_busy(ai_key):
            time.sleep(5)
            ok, _ = verify_fn()
            if ok:
                return "success"
            if not is_ai_busy(ai_key):
                return "idle_no_output"
        time.sleep(5)

    return "busy" if is_ai_busy(ai_key) else "idle_no_output"


def _send_batch_task(ai_key, task_text, dry=False):
    """发送任务到指定 AI。返回 True/False。"""
    if dry:
        return True
    try:
        from mix_send import send
        r = send(ai_key, task_text)
        rs = str(r or "").lstrip()
        if rs.startswith("✅"):
            print(f"   [{ai_key}] 任务已发送")
            return True
        print(f"   [{ai_key}] 发送返回异常：{rs[:80]}")
        return False
    except Exception as e:
        print(f"   [{ai_key}] 发送失败：{e}")
        return False


def _run_with_retry_fallback(
    phase_cfg, out_dir, primary_ai, backup_ais,
    task_text_builder,      # 函数：(ai_key) → task_text
    verify_fn,              # 函数：() → (ok, detail)
    dry=False,
):
    """任务级重试 + 兜底。
    - primary_ai 先跑 3 次
    - 失败 → 依次试 backup_ais（各 3 次）
    - 全部失败 → 写 _failed/ 记录，返回 False
    """
    ai_order = [primary_ai] + list(backup_ais or [])
    attempts_log = []
    phase_key = f"{_STAGE_DIR_MAP.get('写作', '写作')}__{phase_cfg.get('name') or phase_cfg.get('key')}"
    project_root = _project_root()

    for ai_idx, ai_key in enumerate(ai_order):
        ai_attempts = {"ai": ai_key, "count": 0, "last_error": ""}
        is_primary = (ai_idx == 0)
        print(f"\n   ── [{ai_key}] {'主' if is_primary else '兜底'} AI 开始 ──")

        for attempt in range(RETRY_MAX_ATTEMPTS):
            t_wait = RETRY_T_FIRST if attempt == 0 else RETRY_T_RETRY

            # 等空闲
            if not dry:
                try:
                    from mix_send import wait_idle
                    if not wait_idle(ai_key, timeout=300, poll=5):
                        print(f"   [{ai_key}] 等空闲超时，换下一个 AI")
                        ai_attempts["last_error"] = "wait_idle_timeout"
                        break
                except Exception as e:
                    print(f"   [{ai_key}] wait_idle 异常：{e}")

            # 发送
            print(f"   [{ai_key}] 第 {attempt+1}/{RETRY_MAX_ATTEMPTS} 次（等 {t_wait}s）")
            task_text = task_text_builder(ai_key)
            if not _send_batch_task(ai_key, task_text, dry):
                ai_attempts["count"] += 1
                ai_attempts["last_error"] = "send_failed"
                continue

            # 判定
            status = _judge_task_status(ai_key, verify_fn, t_wait) if not dry else "success"
            if status == "success":
                print(f"   [{ai_key}] ✓ 成功")
                return True
            if status == "busy":
                print(f"   [{ai_key}] AI 仍在忙，再等 {RETRY_T_BUSY_LOOP}s")
                time.sleep(RETRY_T_BUSY_LOOP)
                ok, _ = verify_fn()
                if ok:
                    print(f"   [{ai_key}] ✓ 补等后成功")
                    return True
            ai_attempts["count"] += 1
            ai_attempts["last_error"] = status

        attempts_log.append(ai_attempts)

    # 全部失败
    _write_failed_record(project_root, phase_key, "产出",
                          attempts_log, task_text_builder(primary_ai)[:300])
    print(f"\n   ⛔ [{phase_key}] 产出阶段全 AI 失败，已写 _failed/ 记录")
    return False


def _do_produce_batch(
    agent, sess, app, program, phase_cfg, chunk_id, chunk_label,
    input_text, out_dir, dry, extra_note, ai_assist, split_spec,
):
    """批量产出：1 条命令让 AI 生成 N 个文件。
    成功返回 [(item_key, out_path), ...]；失败返回 []。
    """
    expected = [(it.get("key") or it.get("name") or f"item{i}", it)
                for i, it in enumerate(split_spec.get("列表") or [], 1)]
    if not expected:
        return []

    # 构造 4 个 AI 的兜底顺序（排除当前主 AI）
    _all_parts = sess.get("participants") or []
    primary_key = app["key"]
    backup_keys = [p["key"] for p in _all_parts if p["key"] != primary_key]

    # 期望文件清单（占位，仅用于校验）
    _versions_dir = Path(out_dir) / "versions"
    _versions_dir.mkdir(parents=True, exist_ok=True)

    # ── verify_fn：检查所有文件是否都达标 ──
    def verify_fn(ai_key_override=None):
        # 因为兜底时 ai_key 会变，需要动态计算路径
        _ai = ai_key_override or primary_key
        missing = 0
        for item_key, _ in expected:
            safe = str(item_key).replace("/", "_").replace("\\", "_").replace(":", "_").strip()[:40]
            p = _versions_dir / f"{_ai}__{safe}.md"
            if not (p.exists() and p.stat().st_size >= 100):
                missing += 1
        total = len(expected)
        ok = (missing == 0)
        return ok, f"{total - missing}/{total}"

    # ── task_text_builder ──
    def build_task(ai_key):
        files_text, _paths = _build_batch_prompt(phase_cfg, expected, out_dir, ai_key)
        full = (input_text + "\n\n" + files_text).replace("<你的名字>", ai_key)
        return full

    # ── 调用重试兜底 ──
    # 因为 verify_fn 需要感知当前 ai_key，闭包捕获有问题，改用重试内联
    # 简化：先对每个 AI 尝试；每个 AI 内部重试

    ai_order = [primary_key] + backup_keys
    attempts_log = []
    phase_key = f"{_STAGE_DIR_MAP.get(program, program)}__{phase_cfg.get('name') or phase_cfg.get('key')}"
    project_root = _project_root()

    for ai_idx, ai_key in enumerate(ai_order):
        ai_attempts = {"ai": ai_key, "count": 0, "last_error": ""}
        print(f"\n   ── [{ai_key}] {'主' if ai_idx == 0 else '兜底'} AI 开始 ──")

        for attempt in range(RETRY_MAX_ATTEMPTS):
            t_wait = RETRY_T_FIRST if attempt == 0 else RETRY_T_RETRY

            if not dry:
                try:
                    from mix_send import wait_idle
                    if not wait_idle(ai_key, timeout=300, poll=5):
                        print(f"   [{ai_key}] 等空闲超时")
                        ai_attempts["last_error"] = "wait_idle_timeout"
                        break
                except Exception:
                    pass

            print(f"   [{ai_key}] 第 {attempt+1}/{RETRY_MAX_ATTEMPTS} 次（等 {t_wait}s）")
            task_text = build_task(ai_key)
            if not _send_batch_task(ai_key, task_text, dry):
                ai_attempts["count"] += 1
                ai_attempts["last_error"] = "send_failed"
                continue

            # 闭包传入当前 ai_key
            def _vf(_k=ai_key):
                return verify_fn(_k)

            status = _judge_task_status(ai_key, _vf, t_wait) if not dry else "success"
            if status == "success":
                print(f"   [{ai_key}] ✓ 成功")
                # 返回实际产出的文件
                out_files = []
                for item_key, _ in expected:
                    safe = str(item_key).replace("/", "_").replace("\\", "_").replace(":", "_").strip()[:40]
                    p = _versions_dir / f"{ai_key}__{safe}.md"
                    out_files.append(p)
                return out_files
            if status == "busy":
                print(f"   [{ai_key}] AI 仍在忙，再等 {RETRY_T_BUSY_LOOP}s")
                time.sleep(RETRY_T_BUSY_LOOP)
                ok, _ = _vf()
                if ok:
                    out_files = []
                    for item_key, _ in expected:
                        safe = str(item_key).replace("/", "_").replace("\\", "_").replace(":", "_").strip()[:40]
                        p = _versions_dir / f"{ai_key}__{safe}.md"
                        out_files.append(p)
                    return out_files
            ai_attempts["count"] += 1
            ai_attempts["last_error"] = status

        attempts_log.append(ai_attempts)

    # 全部失败
    _write_failed_record(project_root, phase_key, "产出",
                          attempts_log, build_task(primary_key)[:300])
    print(f"\n   ⛔ [{phase_key}] 产出阶段全 AI 失败，已写 _failed/")
    return []

if __name__ == "__main__":
    main()
