            row = QHBoxLayout()
            row.setSpacing(6)
            lbl = QLabel(name)
            lbl.setFixedWidth(150)
            lbl.setStyleSheet("color:#ccc; font-size:12px;")
            row.addWidget(lbl)
            for val, role in ((ev, "执行"), (av, "审核"), (tv, "调整")):
                cb = QComboBox()
                opts = [""] + app_names
                if val and val not in opts:
                    opts = ["", val] + app_names
                cb.addItems(opts)
                cb.setCurrentText(val or "")
                cb.setFixedWidth(120)
                cb.setProperty("sub", name)
