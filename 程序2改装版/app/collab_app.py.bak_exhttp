        b_run.setToolTip("从头跑所选模块（重跑已有产出）")
        b_run.clicked.connect(lambda: self._run_37phase(resume=False))
        eh.addWidget(b_run)
        eh.addWidget(QLabel("章节数:"))
        self.eng_chapters = QSpinBox()
        self.eng_chapters.setRange(1, 99999)
        self.eng_chapters.setValue(3)
        self.eng_chapters.setMinimumHeight(26)
        self.eng_chapters.setFixedWidth(66)
        self.eng_chapters.setToolTip("章节循环次数：每循环一次加一章（写作4+润色1+审核9）")
        eh.addWidget(self.eng_chapters)
        b_book = QPushButton("▶▶ 运行全书（章节循环）")
        b_book.setMinimumHeight(28)
        b_book.setStyleSheet("QPushButton{background:#00897b;color:#fff;font-weight:bold;border-radius:4px;}")
        b_book.setToolTip("01_规划 跑一次 → 02写作+03润色+04审核 按章节循环 N 次 → 05出厂 一次")
        b_book.clicked.connect(lambda: self._run_37book(resume=False))
        eh.addWidget(b_book)
        b_pause = QPushButton("⏸ 暂停")
        b_pause.setMinimumHeight(28)
        b_pause.setStyleSheet("QPushButton{background:#f9a825;color:#000;font-weight:bold;border-radius:4px;}")
        b_pause.setToolTip("当前环节跑完后停住；可改指派 AI 后继续")
        b_pause.clicked.connect(self._pause_37phase)
        eh.addWidget(b_pause)
        b_cont = QPushButton("▶▶ 继续（断点续跑）")
        b_cont.setMinimumHeight(28)
        b_cont.setStyleSheet("QPushButton{background:#6a1b9a;color:#fff;font-weight:bold;border-radius:4px;}")
        b_cont.setToolTip("从断点继续：已有产出的环节自动跳过，用新指派跑剩下的")
        b_cont.clicked.connect(lambda: self._run_37book(resume=True))
        eh.addWidget(b_cont)
        b_rel = QPushButton("✅ 放行")
        b_rel.setMinimumHeight(28)
        b_rel.setStyleSheet("QPushButton{background:#43a047;color:#fff;font-weight:bold;border-radius:4px;}")
        b_rel.clicked.connect(self._release_37phase)
        eh.addWidget(b_rel)
        b_asg = QPushButton("🎯 AI指派(4大模块)")
        b_asg.setMinimumHeight(28)
        b_asg.setStyleSheet("QPushButton{background:#f9a825;color:#000;font-weight:bold;border-radius:4px;}")
        b_asg.setToolTip("每个大模块指派一次，模块下所有环节统一沿用；选项=当前绿灯 AI")
        b_asg.clicked.connect(self._open_assign_dialog)
        eh.addWidget(b_asg)
        eh.addStretch(1)
        tv.insertWidget(1, eng)

        tv.addWidget(self.tabs, 1)

        self.log_chat = QGroupBox("日志 · 单聊")
        self.log_chat.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        lc = QVBoxLayout(self.log_chat)
        lc.setContentsMargins(6, 6, 6, 6)
        lc.setSpacing(4)

        self.run_log = QTextEdit()
        self.run_log.setReadOnly(True)
        self.run_log.setFont(QFont("Consolas", 9))
        lc.addWidget(self.run_log, 1)

        chat = QWidget()
        ch = QHBoxLayout(chat)
        ch.setContentsMargins(0, 0, 0, 0)
        ch.addWidget(QLabel("单聊:"))
        self.chat_ai = QComboBox()
        self.chat_ai.setMinimumWidth(120)
        self.chat_in = QLineEdit()
        self.chat_in.setPlaceholderText("输入消息，回车或点发送…")
        self.chat_btn = QPushButton("发送")
        self.chat_btn.setMaximumWidth(80)
        ch.addWidget(self.chat_ai)
        ch.addWidget(self.chat_in, 1)
        ch.addWidget(self.chat_btn)
        lc.addWidget(chat)

        # ---- 三页版工作台：横向铺开，一屏全览 ----
        # 左＝环节编排（全部页签可见），右＝日志·单聊，中间可拖动分隔
        self.work_split = QSplitter(_Qt.Horizontal)
        self.work_split.setHandleWidth(6)
        self.work_split.setMinimumHeight(720)
        self.work_split.addWidget(self.tabs)
        self.work_split.addWidget(self.log_chat)
        self.work_split.setStretchFactor(0, 1)
        self.work_split.setStretchFactor(1, 0)
        self.work_split.setSizes([950, 430])
        tv.addWidget(self.work_split, 1)

        # 强制翻页（调试）：置于底部，不占用环节操作区
        force_row = QWidget()
        fh = QHBoxLayout(force_row)
        fh.setContentsMargins(0, 2, 0, 2)
        fh.setSpacing(6)
        force_btn = QPushButton("⏭ 强制翻页（调试）")
        force_btn.setMaximumHeight(24)
        force_btn.setStyleSheet("background:#f9a825; color:#000; font-weight:bold; border-radius:4px;")
        force_btn.setToolTip("不走任何流程、不检查本环节是否通过，直接跳到下一环节页，方便逐环节调试")
        force_btn.clicked.connect(self._force_turn_page)
        fh.addWidget(force_btn)
        fh.addStretch(1)

        central = QWidget()
        cv = QVBoxLayout(central)
        cv.setContentsMargins(0, 0, 0, 0)
        cv.setSpacing(0)
        cv.addWidget(self.top, 1)
        cv.addWidget(force_row)

        self.stage0_widget = self._build_stage0_widget()
        self.summary_widget = self._build_summary_widget()
        self.stack = QStackedWidget()
        self.stack.addWidget(self.stage0_widget)    # 页① 项目（新建/继续/模板）
        self.stack.addWidget(self.summary_widget)   # 页② 梗概确认
        self.stack.addWidget(central)               # 页③ 工作台（编排+37环+日志 一屏全览）

        # —— 页切换条：三页随时直跳，不必按流程走完 ——
        self.page_bar = QWidget()
        pb = QHBoxLayout(self.page_bar)
        pb.setContentsMargins(6, 4, 6, 4)
        pb.setSpacing(6)
        self.page_btns = []
        for i, txt in enumerate(("① 项目", "② 梗概", "③ 工作台")):
            b = QPushButton(txt)
            b.setCheckable(True)
            b.setMinimumHeight(30)
            b.setCursor(_Qt.PointingHandCursor)
            b.setStyleSheet(
                "QPushButton{background:#333333;color:#d4d4d4;border:1px solid #3c3c3c;"
                "border-radius:4px;padding:4px 16px;font-weight:bold;}"
                "QPushButton:checked{background:#094771;color:#fff;border-color:#569cd6;}")
            b.clicked.connect(lambda _, ix=i: self._goto_page(ix))
            pb.addWidget(b)
            self.page_btns.append(b)
        pb.addStretch(1)

        root = QWidget()
        rv = QVBoxLayout(root)
        rv.setContentsMargins(0, 0, 0, 0)
        rv.setSpacing(0)
        rv.addWidget(self.page_bar)
        rv.addWidget(self.stack, 1)
        self.setCentralWidget(root)
        self.stack.currentChanged.connect(self._sync_page_bar)
        self._sync_page_bar(self.stack.currentIndex())
        self.setMinimumHeight(660)

        self._update_nav()

    def _goto_page(self, ix):
        """三页版：页切换条直跳（0=项目 1=梗概 2=工作台）。"""
        self.stack.setCurrentIndex(ix)

    def _sync_page_bar(self, ix):
        for i, b in enumerate(getattr(self, "page_btns", [])):
            b.setChecked(i == ix)
        if ix == 0 and getattr(self, "progress_panel", None):
            self._refresh_progress()

    # ------------------------------------------------- 37 环进度面板（第①页）
    def _build_progress_panel(self):
        """4 大模块的 37 环进度：逐环打钩（✓=有 final 产出 / ○=未完成）。"""
        box = QGroupBox("37环进度（4大模块 · 通过打钩）")
        box.setStyleSheet("QGroupBox{color:#00e5ff; font-weight:bold;}")
        v = QVBoxLayout(box)
        v.setContentsMargins(8, 6, 8, 6)
        v.setSpacing(3)
        head = QHBoxLayout()
        self.prog_title = QLabel("")
        self.prog_title.setStyleSheet("color:#cfcfcf; font-size:12px;")
        head.addWidget(self.prog_title, 1)
        b = QPushButton("↻ 刷新")
        b.setFixedHeight(22)
        b.setToolTip("重新扫描各环节产出目录，更新打钩状态")
        b.clicked.connect(self._refresh_progress)
        head.addWidget(b)
        v.addLayout(head)
        sc = QScrollArea()
        sc.setWidgetResizable(True)
        sc.setStyleSheet("QScrollArea{border:none;background:transparent;}")
        self._prog_body = QWidget()
        self._prog_lay = QVBoxLayout(self._prog_body)
        self._prog_lay.setContentsMargins(0, 0, 0, 0)
        self._prog_lay.setSpacing(3)
        self._prog_lay.addStretch(1)
        sc.setWidget(self._prog_body)
        v.addWidget(sc, 1)
        return box

    def _clear_progress_panel(self):
        while self._prog_lay.count():
            it = self._prog_lay.takeAt(0)
            if it.widget():
                it.widget().deleteLater()

    def _refresh_progress(self):
        """扫描项目产出：每个模块下逐环 final 是否存在 → 打钩。"""
        try:
            proj_ws = getattr(self, "_proj_ws", None)
            if not proj_ws or not os.path.isdir(proj_ws):
                proj_ws = paths.output_path(getattr(self, "_proj_name", "") or "未命名项目")
            if not os.path.isdir(proj_ws):
                self._clear_progress_panel()
                self.prog_title.setText("（尚未创建项目）")
                return
            ph_path = os.path.join(paths.get_cfg_rules_dir(), "phases.json")
            phases = json.load(open(ph_path, encoding="utf-8")) or {}
        except Exception as e:
            self._clear_progress_panel()
            self.prog_title.setText("⚠ 进度读取失败：%s" % e)
            return
        self._clear_progress_panel()
        from phase_runner import _ring_final_paths
        total_ok = total = 0
        for mod in self._assign_modules(phases):
            stage = mod["stage"]
            rings = (phases.get("环节") or {}).get(stage) or []
            # 章节循环：02/03/04 可能有 第NN章 子目录，取最新一章作为当前进度
            base = os.path.join(proj_ws, stage)
            chapters = []
            if os.path.isdir(base):
                chapters = sorted([d for d in os.listdir(base)
                                   if d.startswith("第") and os.path.isdir(os.path.join(base, d))])
            cur_ch = chapters[-1] if chapters else None
            pdir = os.path.join(base, cur_ch) if cur_ch else base

            head = QHBoxLayout()
            hl = QLabel("%s（%d 环）" % (stage, len(rings)))
            hl.setStyleSheet("color:#00e5ff; font-weight:bold; font-size:12px;")
            head.addWidget(hl)
            tag = QLabel("")
            head.addWidget(tag)
            head.addStretch(1)
            row = QWidget()
            row.setLayout(head)
            self._prog_lay.addWidget(row)

            ok_n = 0
            cells = []
            for r in rings:
                kind, exp = _ring_final_paths(pdir, r, cur_ch)
                if kind == "items":
                    n_ok = sum(1 for p in exp if os.path.exists(p))
                    done = n_ok >= len(exp)
                    mark = "✓" if done else ("%d/%d" % (n_ok, len(exp)))
                    label = _ring_label(r)
                else:
                    done = all(os.path.exists(p) for p in exp)
                    mark = "✓" if done else "○"
                    label = _ring_label(r)
                cells.append((label, mark, done))
                if done:
                    ok_n += 1
            total_ok += ok_n
            total += len(rings)
            tag.setText("  %d/%d%s" % (ok_n, len(rings),
                                     ("　（当前 %s）" % cur_ch) if cur_ch else ""))
            tag.setStyleSheet("color:%s;" % ("#1e8e3e" if ok_n == len(rings) else "#aaaaaa"))

            grid = QGridLayout()
            grid.setContentsMargins(0, 0, 0, 0)
            grid.setHorizontalSpacing(4)
            per = 6
            for i, (label, mark, done) in enumerate(cells):
                b = QLabel(("%s %s" % (mark, label)).strip())
                b.setStyleSheet(
                    "color:#1e8e3e;" if done else "color:#777777; font-size:11px;")
                b.setToolTip(label)
                grid.addWidget(b, i // per, i % per)
            holder = QWidget()
            holder.setLayout(grid)
            self._prog_lay.addWidget(holder)
        self.prog_title.setText("项目：%s　总进度 %d/%d 环" % (
            getattr(self, "_proj_name", "") or "（未命名）", total_ok, total))
        self._prog_lay.addStretch(1)

    def _auto_refresh_progress(self):
        """只在第①页可见或引擎正在跑时刷新，避免无谓磁盘扫描。"""
        try:
            running = bool(getattr(self, "_phase_worker", None)
                           and self._phase_worker.isRunning())
        except Exception:
            running = False
        if getattr(self, "stack", None) and self.stack.currentIndex() == 0:
            self._refresh_progress()
        elif running:
            self._refresh_progress()

    # ------------------------------------------------- 环节1 · 子环角色指派
    def _ai_app_names(self):
        try:
            from players import load_players
            return [p.get("名字") for p in load_players() if p.get("名字")]
        except Exception:
            return []

    def _build_stage1_assign(self):
        """环节1（规划）页面：7 个子环 + _审核者 + _调整者，每个一行三下拉。
        值从 rules/assignments.json 读，改动即时写回。"""
        w = QWidget()
        v = QVBoxLayout(w)
        v.setContentsMargins(8, 8, 8, 8)
        v.setSpacing(6)

        title = QLabel("环节1 · 规划 — 子环角色指派")
        title.setStyleSheet("font-size:15px; font-weight:bold; color:#00e5ff;")
        v.addWidget(title)
        hint = QLabel("每个子环指派 执行者 / 审核者 / 调整者；改动自动写回 rules/assignments.json。")
        hint.setWordWrap(True)
        hint.setStyleSheet("color:#aaaaaa; font-size:11px;")
        v.addWidget(hint)

        # 表头
        hdr = QHBoxLayout()
        hdr.setSpacing(6)
        for txt, wd in (("子环 / 角色组", 150), ("执行者", 120), ("审核者", 120), ("调整者", 120)):
            h = QLabel(txt)
            h.setFixedWidth(wd)
            h.setStyleSheet("color:#888; font-size:11px;")
            hdr.addWidget(h)
        v.addLayout(hdr)

        try:
            with open(os.path.join(paths.RULES_DIR, "assignments.json"), encoding="utf-8") as f:
                data = json.load(f) or {}
        except Exception:
            data = {}
        stage = data.get("环节", {}).get("01_规划", {})
        sub_rings = list(stage.get("子环", []))
        if not sub_rings:
            # assignments.json 未播种时，直接从 PIPELINE 推导（保证与最新流程一致）
            try:
                import stage_board as _sb
                _st = next((s for s in _sb.PIPELINE if s["key"] == "规划"), None)
                if _st:
                    for _s in _st["steps"]:
                        sub_rings += list(_s.get("blocks") or [])
            except Exception:
                pass
        sub_rings = sub_rings + ["_审核者", "_调整者"]
        detail = stage.get("明细", {})
        exec_def = stage.get("执行", "")
        audit_def = stage.get("审核", "")
        adj_def = stage.get("调整", "")
        app_names = self._ai_app_names()

        for name in sub_rings:
            d = detail.get(name, {}) or {}
            ev = d.get("执行") or exec_def
            av = d.get("审核") or audit_def
            tv = d.get("调整") or adj_def
            row = QHBoxLayout()
            row.setSpacing(6)
            lbl = QLabel(name)
            lbl.setFixedWidth(150)
            lbl.setStyleSheet("color:#ccc; font-size:12px;")
            row.addWidget(lbl)
            for val, role in ((ev, "执行"), (av, "审核"), (tv, "调整")):
                cb = QComboBox()
                opts = [""] + app_names
                if val and val not in opts:
                    opts = ["", val] + app_names
                cb.addItems(opts)
                cb.setCurrentText(val or "")
                cb.setFixedWidth(120)
                cb.setProperty("sub", name)
                cb.setProperty("role", role)
                cb.currentTextChanged.connect(self._on_stage1_assign_changed)
                row.addWidget(cb)
            v.addLayout(row)

        # 运行控制
        btn_row = QHBoxLayout()
        btn_row.setSpacing(8)
        run_btn = QPushButton("▶ 开始运行")
        run_btn.setMinimumHeight(30)
        run_btn.setStyleSheet("background:#1e88e5; color:#fff; font-weight:bold; border-radius:4px;")
        run_btn.clicked.connect(self._stage1_run)
        rel_btn = QPushButton("⏸ 放行")
        rel_btn.setMinimumHeight(30)
        rel_btn.setStyleSheet("background:#43a047; color:#fff; font-weight:bold; border-radius:4px;")
        rel_btn.clicked.connect(self._stage1_release)
        btn_row.addWidget(run_btn)
        btn_row.addWidget(rel_btn)
        btn_row.addStretch(1)
        v.addLayout(btn_row)

        v.addStretch(1)
        sc = QScrollArea()
        sc.setWidgetResizable(True)
        sc.setStyleSheet("QScrollArea{border:none;}")
        sc.setWidget(w)
        return sc

    def _on_stage1_assign_changed(self, text):
        cb = self.sender()
        if not cb:
            return
        name = cb.property("sub")
        role = cb.property("role")
        try:
            with open(os.path.join(paths.RULES_DIR, "assignments.json"), encoding="utf-8") as f:
                data = json.load(f) or {}
        except Exception as e:
            self.log_line(f"⚠ 读取 assignments.json 失败：{e}")
            return
        stage = data.setdefault("环节", {}).setdefault("01_规划", {})
        detail = stage.setdefault("明细", {})
        d = detail.setdefault(name, {})
        d[role] = text
        try:
            with open(os.path.join(paths.RULES_DIR, "assignments.json"), "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
            self.log_line(f"💾 已保存指派：{name} / {role} = {text or '（空）'}")
        except Exception as e:
            self.log_line(f"❌ 写回 assignments.json 失败：{e}")

    def _build_stage0_widget(self):
        w = QWidget()
        v = QVBoxLayout(w)
        v.setContentsMargins(0, 4, 0, 4)
        v.setSpacing(3)

        title = QLabel("环节 0 · 项目初始化")
        title.setStyleSheet("font-size:18px; font-weight:bold; color:#00e5ff;")
        v.addWidget(title)

        hint = QLabel("请先填写项目基础信息，确认后进入协同写作流程。"
                       "若要继续之前未完成的项目，请在下方『已有项目』中选择并点「继续项目」。")
        hint.setWordWrap(True)
        v.addWidget(hint)

        # ---- 37 环进度面板（4 大模块逐环打钩）----
        self.progress_panel = self._build_progress_panel()
        self.progress_panel.setMaximumHeight(260)
        v.addWidget(self.progress_panel)

        # ---- 已有项目：直接加载历史项目并跳到环节1（跳过初始化选择与梗概确认）----
        exist_box = QGroupBox("已有项目（继续未完成的进度）")
        exist_box.setStyleSheet("QGroupBox{color:#00e5ff; font-weight:bold;}")
        exist_h = QHBoxLayout(exist_box)
        exist_h.setSpacing(8)
        exist_h.setContentsMargins(8, 8, 8, 8)
        self.existing_combo = QComboBox()
        self.existing_combo.setMinimumHeight(26)
        self.existing_combo.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        self._fill_existing_projects()
        exist_h.addWidget(self.existing_combo, 1)
        exist_refresh = QPushButton("↻")
        exist_refresh.setFixedWidth(34)
        exist_refresh.setMinimumHeight(26)
        exist_refresh.setToolTip("刷新已有项目列表")
        exist_refresh.clicked.connect(lambda: self._fill_existing_projects())
        exist_h.addWidget(exist_refresh)
        exist_btn = QPushButton("继续项目")
        exist_btn.setMinimumHeight(26)
        exist_btn.setMinimumWidth(90)
        exist_btn.setStyleSheet("QPushButton{background:#43a047; color:#fff; font-weight:bold; border-radius:4px;}"
                                "QPushButton:hover{background:#4caf50;}")
        exist_btn.clicked.connect(self._on_continue_project)
        exist_h.addWidget(exist_btn)
        v.addWidget(exist_box)

        # ---- 项目模板（37 环配置来源）：新建项目时按此生成独立的 config/ ----
        tpl_box = QGroupBox("项目模板（37 环流程配置）")
        tpl_box.setStyleSheet("QGroupBox{color:#00e5ff; font-weight:bold;}")
        tpl_v = QVBoxLayout(tpl_box)
        tpl_v.setContentsMargins(8, 8, 8, 8)
        tpl_v.setSpacing(6)
        tpl_row = QHBoxLayout()
        tpl_row.setSpacing(6)
        self.init_template = QComboBox()
        self.init_template.addItems(["通用37环", "疯骨56子项", "导入blocks.json…"])
        self.init_template.setMinimumHeight(26)
        self.init_template.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        tpl_row.addWidget(QLabel("模板:"), 0)
        tpl_row.addWidget(self.init_template, 1)
        tpl_v.addLayout(tpl_row)
        self.init_blocks_btn = QPushButton("选择 blocks.json")
        self.init_blocks_btn.setMinimumHeight(26)
        self.init_blocks_btn.setStyleSheet("QPushButton{background:#37474f;color:#fff;border-radius:4px;}")
        self.init_blocks_btn.setVisible(False)
        self.init_blocks_path = ""
        self.init_blocks_btn.clicked.connect(self._pick_blocks)
        tpl_v.addWidget(self.init_blocks_btn)
        self.init_template.currentTextChanged.connect(self._on_template_changed)
        tpl_hint = QLabel("通用37环＝23 规划环（每环整体一份）；疯骨56子项＝8 规划组拆成 56 个独立子项文件；"
                          "导入blocks.json＝用你自己的子项定义（blocks 组→规划环，组内 blocks→子项）。")
        tpl_hint.setWordWrap(True)
        tpl_hint.setStyleSheet("color:#aaaaaa; font-size:10px;")
        tpl_v.addWidget(tpl_hint)
        v.addWidget(tpl_box)

        tabs = QTabWidget()

        # ---- 基础信息 ----
        bscroll = QScrollArea()
        bscroll.setWidgetResizable(True)
        bscroll.setHorizontalScrollBarPolicy(_Qt.ScrollBarAlwaysOff)
        bscroll.setVerticalScrollBarPolicy(_Qt.ScrollBarAlwaysOff)
        bscroll.setStyleSheet("QScrollArea{border:none;background:transparent;}")
        form_w = QWidget()
        form = QVBoxLayout(form_w)
        form.setContentsMargins(0, 2, 0, 2)
        form.setSpacing(2)

        self.init_name = self._stage0_line("项目名称", "请输入项目名称")
        form.addWidget(self.init_name)

        self.init_channel = self._stage0_combo("频道", ["男频", "女频"])
        form.addWidget(self.init_channel)

        self.init_genre = self._stage0_combo("题材", list(self.GENRE_SUBS.keys()))
        self.init_genre.findChild(QComboBox).currentTextChanged.connect(self._on_genre_changed)
        form.addWidget(self.init_genre)

        self.init_sub = self._stage0_combo("细分", self.GENRE_SUBS.get(self.init_genre.findChild(QComboBox).currentText(), []))
        form.addWidget(self.init_sub)

        chapters_row = self._stage0_spin("章节数", 1, 99999, 100)
        self.init_chapters = chapters_row.findChild(QSpinBox)
        form.addWidget(chapters_row)

        self.init_gender = self._stage0_combo("主角性别", ["男主", "女主", "双主角"])
        form.addWidget(self.init_gender)

        support_row = self._stage0_spin("配角数量", 0, 100, 3)
        self.init_support = support_row.findChild(QSpinBox)
        form.addWidget(support_row)

        templates_row = QHBoxLayout()
        templates_row.setSpacing(6)
        templates_row.setContentsMargins(0, 0, 0, 0)
        templates_label = QLabel("角色模板")
        templates_label.setStyleSheet("color:#aaaaaa;")
        templates_label.setFixedWidth(64)
        templates_row.addWidget(templates_label)
        self.init_templates = self._make_toggle_grid(self.CHAR_TEMPLATES, 2)
        self.init_templates.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        self.init_templates.setMaximumWidth(220)
        templates_row.addWidget(self.init_templates, 1)
        templates_row.addStretch(1)
        form.addLayout(templates_row)

        core_box = QGroupBox("故事核心")
        core_v = QVBoxLayout(core_box)
        core_v.setSpacing(2)
        core_v.setContentsMargins(2, 4, 2, 4)

        self.init_tone = self._make_radio_group(self.STORY_TONES, "tone", cols=3)
        core_v.addLayout(self._labeled_wrap("基调", self.init_tone))

        self.init_atmo = self._make_radio_group(self.STORY_ATMOS, "atmo", cols=3)
        core_v.addLayout(self._labeled_wrap("氛围", self.init_atmo))

        self.init_pace = self._make_radio_group(self.STORY_PACES, "pace", cols=3)
        core_v.addLayout(self._labeled_wrap("节奏", self.init_pace))

        form.addWidget(core_box)

        desc_row = QHBoxLayout()
        desc_row.setSpacing(6)
        desc_row.setContentsMargins(0, 0, 0, 0)
        desc_label = QLabel("额外想法")
        desc_label.setStyleSheet("color:#aaaaaa;")
        desc_label.setFixedWidth(64)
        desc_row.addWidget(desc_label)
        self.init_desc = QTextEdit()
        self.init_desc.setPlaceholderText("项目简介、世界观、风格要求、额外想法等…")
        self.init_desc.setMinimumHeight(32)
        self.init_desc.setMaximumHeight(36)
        self.init_desc.setMaximumWidth(220)
        self.init_desc.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        desc_row.addWidget(self.init_desc, 1)
        form.addLayout(desc_row)

        bscroll.setWidget(form_w)
        tabs.addTab(bscroll, "基础信息")

        # ---- 性格 / 感情线 / 金手指：子页标签，按钮多选 ----
        self.init_personality = self._make_toggle_grid(self.PERSONALITY_TRAITS, 3)
        tabs.addTab(self._wrap_scroll(self.init_personality), "性格")

        self.init_emotion = self._make_toggle_grid(self.EMOTION_TAGS, 3)
        tabs.addTab(self._wrap_scroll(self.init_emotion), "感情线")

        self.init_golden = self._make_toggle_grid(self.GOLDEN_FINGER_TAGS, 3)
        tabs.addTab(self._wrap_scroll(self.init_golden), "金手指")

        v.addWidget(tabs, 1)

        # 上传 / 随机生成 并排放
        btn_row = QHBoxLayout()
        btn_row.setSpacing(8)
        btn_row.setContentsMargins(0, 0, 0, 0)
        upload_btn = QPushButton("📄 上传参考大纲")
        upload_btn.setMinimumHeight(24)
        upload_btn.setStyleSheet("""
                QPushButton{
                    padding:4px 12px;
                    font-size:13px;
                    color:#cfcfcf;
                    border:1px solid #3a3a3a;
                    border-radius:4px;
                    background-color:#1e1e1e;
                }
                QPushButton:hover{border-color:#5a5a5a;}
                QPushButton:pressed{border-color:#1a73e8; color:#fff;}
            """)
        upload_btn.clicked.connect(self._on_upload_outline)
        btn_row.addWidget(upload_btn)
        random_btn = QPushButton("🎲 随机生成")
        random_btn.setMinimumHeight(24)
        random_btn.setToolTip("随机填充项目设定并直接进入梗概确认")
        random_btn.setStyleSheet("""
                QPushButton{
                    padding:4px 12px;
                    font-size:13px;
                    color:#fff;
                    border:1px solid #5a5a5a;
                    border-radius:4px;
                    background-color:#2d5a27;
                }
                QPushButton:hover{background-color:#3a7a32;}
                QPushButton:pressed{background-color:#1e3e1a;}
            """)
        random_btn.clicked.connect(self._on_random_generate)
        btn_row.addWidget(random_btn)
        btn_row.addStretch(1)
        v.addLayout(btn_row)

        self.outline_label = QLabel("")
        self.outline_label.setStyleSheet("color:#888;font-size:11px;")
        self.outline_label.setWordWrap(True)
        v.addWidget(self.outline_label)

        btn = QPushButton("开始规划")
        btn.setMinimumHeight(28)
        btn.setMinimumWidth(120)
        btn.setStyleSheet("""
            QPushButton{
                padding:6px 16px;
                font-size:14px;
                font-weight:bold;
                color:#fff;
                background-color:#1a73e8;
                border-radius:5px;
            }
            QPushButton:hover{background-color:#2b7de9;}
            QPushButton:pressed{background-color:#1557b0;}
        """)
        btn.clicked.connect(self._on_stage0_confirm)
        v.addWidget(btn, 0, _Qt.AlignCenter)

        # 规划结果展示区（步骤6 动态填充，默认隐藏）
        self.stage0_result = QWidget()
        self.stage0_result.setVisible(False)
        _rl = QVBoxLayout(self.stage0_result)
        _rl.setContentsMargins(0, 10, 0, 0)
        _rl.setSpacing(8)
        v.addWidget(self.stage0_result)

        # ---- 脏标记：已手动输入/选择的字段不会被随机生成覆盖 ----
        self._name_dirty = False
        self._channel_dirty = False
        self._genre_dirty = False
        self._sub_dirty = False
        self._chapters_dirty = False
        self._gender_dirty = False
        self._support_dirty = False
        self._templates_dirty = False
        self._tone_dirty = False
        self._atmo_dirty = False
        self._pace_dirty = False
        self._personality_dirty = False
        self._emotion_dirty = False
        self._golden_dirty = False
        self._desc_dirty = False

        self.init_name.findChild(QLineEdit).textChanged.connect(lambda: setattr(self, '_name_dirty', True))
        self.init_channel.findChild(QComboBox).currentTextChanged.connect(lambda: setattr(self, '_channel_dirty', True))
        self.init_genre.findChild(QComboBox).currentTextChanged.connect(lambda: setattr(self, '_genre_dirty', True))
        self.init_sub.findChild(QComboBox).currentTextChanged.connect(lambda: setattr(self, '_sub_dirty', True))
        self.init_chapters.valueChanged.connect(lambda: setattr(self, '_chapters_dirty', True))
        self.init_gender.findChild(QComboBox).currentTextChanged.connect(lambda: setattr(self, '_gender_dirty', True))
        self.init_support.valueChanged.connect(lambda: setattr(self, '_support_dirty', True))
        self.init_desc.textChanged.connect(lambda: setattr(self, '_desc_dirty', True))
        for b in self.init_templates.findChildren(QPushButton):
            b.toggled.connect(lambda _=None: setattr(self, '_templates_dirty', True))
        for b in self.init_personality.findChildren(QPushButton):
            b.toggled.connect(lambda _=None: setattr(self, '_personality_dirty', True))
        for b in self.init_emotion.findChildren(QPushButton):
            b.toggled.connect(lambda _=None: setattr(self, '_emotion_dirty', True))
        for b in self.init_golden.findChildren(QPushButton):
            b.toggled.connect(lambda _=None: setattr(self, '_golden_dirty', True))
        for group_name, flag in (("tone", "_tone_dirty"), ("atmo", "_atmo_dirty"), ("pace", "_pace_dirty")):
            group = getattr(self, f"init_{group_name}").button_group
            for rb in group.buttons():
                rb.toggled.connect(lambda _=None, f=flag: setattr(self, f, True))

        return self._wrap_scroll(w)

    def _wrap_scroll(self, widget):
        sc = QScrollArea()
        sc.setWidgetResizable(True)
        sc.setHorizontalScrollBarPolicy(_Qt.ScrollBarAlwaysOff)
        sc.setStyleSheet("QScrollArea{border:none;}")
        sc.setWidget(widget)
        return sc

    def _on_genre_changed(self, genre):
        self.init_sub.findChild(QComboBox).clear()
        self.init_sub.findChild(QComboBox).addItems(self.GENRE_SUBS.get(genre, []))

    def _stage0_field(self, label_text):
        box = QWidget()
        h = QHBoxLayout(box)
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(6)
        lbl = QLabel(label_text)
        lbl.setStyleSheet("color:#aaaaaa;")
        lbl.setFixedWidth(80)
        h.addWidget(lbl)
        return box

    def _stage0_line(self, label_text, placeholder):
        box = self._stage0_field(label_text)
        edit = QLineEdit()
        edit.setPlaceholderText(placeholder)
        edit.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        edit.setMaximumWidth(220)
        box.layout().addWidget(edit, 1)
        return box

    def _stage0_combo(self, label_text, items):
        box = self._stage0_field(label_text)
        cb = QComboBox()
        cb.addItems(items)
        cb.setMaximumWidth(220)
        cb.setMinimumWidth(90)
        cb.setSizePolicy(QSizePolicy.Preferred, QSizePolicy.Fixed)
        # 下拉列表不宽过控件本身
        cb.view().setMaximumWidth(220)
        box.layout().addWidget(cb)
        box.layout().addStretch(1)
        return box

    def _stage0_spin(self, label_text, min_v, max_v, val):
        box = self._stage0_field(label_text)
        sp = QSpinBox()
        sp.setRange(min_v, max_v)
        sp.setValue(val)
        sp.setMaximumWidth(220)
        sp.setSizePolicy(QSizePolicy.Preferred, QSizePolicy.Fixed)
        box.layout().addWidget(sp)
        box.layout().addStretch(1)
        return box

    def _make_toggle_grid(self, items, cols):
        w = QWidget()
        grid = QGridLayout(w)
        grid.setContentsMargins(1, 1, 1, 1)
        grid.setSpacing(4)
        for c in range(cols):
            grid.setColumnStretch(c, 1)
        for i, text in enumerate(items):
            btn = QPushButton(text)
            btn.setCheckable(True)
            btn.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
            btn.setStyleSheet("""
                QPushButton{
                    padding:4px 4px;
                    font-size:12px;
                    color:#cfcfcf;
                    border:1px solid #3a3a3a;
                    border-radius:4px;
                    background-color:#1e1e1e;
                }
                QPushButton:checked{
                    color:#ffffff;
                    background-color:#1a73e8;
                    border-color:#1a73e8;
                }
                QPushButton:hover{ border-color:#5a5a5a; }
            """)
            grid.addWidget(btn, i // cols, i % cols)
        return w

    def _collect_toggle_texts(self, widget):
        return [b.text() for b in widget.findChildren(QPushButton) if b.isChecked()]

    def _make_radio_group(self, items, group_name, cols=3):
        group = QButtonGroup(self)
        group.setObjectName(group_name)
        w = QWidget()
        grid = QGridLayout(w)
        grid.setContentsMargins(0, 0, 0, 0)
        grid.setSpacing(2)
        grid.setVerticalSpacing(2)
        for c in range(cols):
            grid.setColumnStretch(c, 1)
        for i, text in enumerate(items):
            rb = QRadioButton(text)
            rb.setStyleSheet("QRadioButton{color:#ccc; spacing:2px; padding:1px 0px;} QRadioButton::indicator{width:12px;height:12px;}")
            rb.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
            group.addButton(rb)
            grid.addWidget(rb, i // cols, i % cols)
        if group.buttons():
            group.buttons()[0].setChecked(True)
        w.button_group = group
        return w

    def _selected_radio_text(self, widget):
        group = getattr(widget, "button_group", None)
        if not group:
            return ""
        btn = group.checkedButton()
        return btn.text() if btn else ""

    def _labeled_hbox(self, label, widget):
        h = QHBoxLayout()
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(8)
        h.addWidget(QLabel(label))
        h.addWidget(widget, 1)
        return h

    def _labeled_wrap(self, label, widget):
        v = QVBoxLayout()
        v.setContentsMargins(0, 0, 0, 0)
        v.setSpacing(2)
        lbl = QLabel(label)
        lbl.setStyleSheet("color:#aaaaaa;")
        v.addWidget(lbl)
        v.addWidget(widget)
        return v

    # ------------------------------------------------- 环节0 开始规划（步骤1-6）
    # 所有产出/提示词路径均由 paths 模块按程序位置推导，不再写死绝对路径
    @staticmethod
    def _safe_name(name):
        """把项目名变成安全的文件夹名（去除 Windows 非法字符、压缩空白）。"""
        import re
        s = (name or "").strip()
        s = re.sub(r'[\\/:*?"<>|]', "_", s)
        s = re.sub(r"\s+", "_", s)
        if not s:
            s = "未命名项目"
        return s[:60]

    # 产出目录下的项目文件树：步骤0=初始化目录，其后依次对应每个环节（步骤）名称。
    # 每个环节目录里再由 auto_stage 直接落该环节的块产物；本步骤规划/下一步建议也在此目录。
    TREE = [
        "00_初始化",
        "01_规划",
        "02_写作",
        "03_去AI",
        "04_审核",
        "05_出厂",
        "_logs",
    ]

    def _normalize_init_info(self, info):
        """把中文键的 UI 数据转换为梗概页 / CDP 发送所需的英文键结构。"""
        sc = info.get("故事核心") or {}
        return {
            "name": info.get("项目名称") or "未命名项目",
            "channel": info.get("频道", ""),
            "genre": info.get("题材", ""),
            "sub_genre": info.get("细分", ""),
            "chapters": info.get("章节数", 0),
            "protagonist": {
                "gender": info.get("主角性别", ""),
                "personality": info.get("主角性格") or [],
            },
            "supporting_roles": {
                "count": info.get("配角数量", 0),
                "templates": info.get("角色模板") or [],
            },
            "story_core": {
                "tone": sc.get("基调", ""),
                "atmosphere": sc.get("氛围", ""),
                "pace": sc.get("节奏", ""),
            },
            "emotion_line": info.get("感情线") or [],
            "golden_finger": info.get("金手指") or [],
            "extra_ideas": info.get("额外想法", ""),
        }

    def _collect_init_info(self):
        """步骤1：读取 UI 所有标签控件，返回中文键字典（与 UI 标签一一对应）。"""
        return {
            "项目名称": self.init_name.findChild(QLineEdit).text().strip() or "未命名项目",
            "频道": self.init_channel.findChild(QComboBox).currentText(),
            "题材": self.init_genre.findChild(QComboBox).currentText(),
            "细分": self.init_sub.findChild(QComboBox).currentText(),
            "章节数": self.init_chapters.value(),
            "主角性别": self.init_gender.findChild(QComboBox).currentText(),
            "主角性格": self._collect_toggle_texts(self.init_personality),
            "感情线": self._collect_toggle_texts(self.init_emotion),
            "金手指": self._collect_toggle_texts(self.init_golden),
            "配角数量": self.init_support.value(),
            "角色模板": self._collect_toggle_texts(self.init_templates),
            "故事核心": {
                "基调": self._selected_radio_text(self.init_tone),
                "氛围": self._selected_radio_text(self.init_atmo),
                "节奏": self._selected_radio_text(self.init_pace),
            },
            "额外想法": self.init_desc.toPlainText().strip(),
            "参考大纲": getattr(self, "reference_outline", "") or "",
        }

    def _on_stage0_confirm(self):
        """环节0·开始规划：收集基础信息 → 进入下一级界面（环节0.5 故事梗概确认）。
        真正的 WorkBuddy 生成放在梗概确认页的「下一步 → 进入环节1」（流程0.5）。"""
        info = self._collect_init_info()
        norm = self._normalize_init_info(info)
        self._current_init_data = norm          # 梗概页 / CDP 发送共用（英文键结构）

        项目名 = info.get("项目名称") or "未命名项目"
        safe = self._safe_name(项目名)

        # 产出目录根：OUTPUT\<项目名>\（按项目名建目录，无日期）
        proj_ws = paths.output_path(safe)
        init_dir = os.path.join(proj_ws, "00_初始化")
        os.makedirs(init_dir, exist_ok=True)
        with open(os.path.join(init_dir, "项目信息.json"), "w", encoding="utf-8") as f:
            json.dump(info, f, ensure_ascii=False, indent=2)

        # 按清单建步骤文件树（已存在则跳过，不删除）
        for rel in self.TREE:
            os.makedirs(os.path.join(proj_ws, rel), exist_ok=True)
        # 步骤文件树清单：写到 _logs（不放初始化目录内），方便按项目回溯
        _logs_dir = os.path.join(proj_ws, "_logs")
        os.makedirs(_logs_dir, exist_ok=True)
        with open(os.path.join(_logs_dir, "文件树清单.json"), "w", encoding="utf-8") as f:
            json.dump(self.TREE, f, ensure_ascii=False, indent=2)

        # 记录本项目根目录（产出目录下的项目目录），供后续流程使用
        self._proj_ws = proj_ws
        self._proj_name = safe
        self.set_project_name(safe)

        # 建立『按项目』工作区：生成协作蓝图（规划文件树）+ 拷贝提示词 + 预指派本地AI
        try:
            paths.set_active_project_workspace(paths.workspace_project_path(safe))
            self._generate_project_plan(safe, info, norm)
        except Exception as e:
            self.log_line(f"⚠ 生成工作区/协作蓝图失败：{e}")

        # 37 环引擎：按所选模板生成本项目独立的 config/（phases/assignments/prompts），
        # 并设为当前激活配置（每个项目互不干扰，可继续项目时切回）。
        try:
            tpl, blocks = self._current_template()
            cfg_dir = os.path.join(proj_ws, "config")
            import build_project_config as _bpc
            if tpl == "导入" and not blocks:
                self.log_line("⚠ 『导入blocks.json』未选择文件，回退通用37环模板")
                tpl = "通用37环"
            res = _bpc.build_config(tpl, cfg_dir, blocks or None)
            paths.set_active_project_cfg(cfg_dir)
            self._proj_cfg = cfg_dir
            self.log_line("🧩 已生成 37 环独立配置：%s（规划环=%d，子项=%d）"
                          % (res["template"], res["规划环数"], res["规划子项数"]))
            try:
                self.eng_chapters.setValue(max(1, int(info.get("章节数") or 3)))
            except Exception:
                pass
            self._refresh_progress()
        except Exception as e:
            import traceback
            self.log_line(f"⚠ 生成 37 环配置失败：{e}\n{traceback.format_exc()}")

        # 同步章节数给自动执行引擎（逐章循环用）
        try:
            import auto_stage as _as
            _as.set_chapter_count(info.get("章节数") or 1)
            _as.set_current_chapter(1)
            _as.set_project_workspace(proj_ws)
            _as.save_chapter_progress()
            total = _as.get_chapter_total()
            self.log_line(f"📚 计划章节数：{total} 章（章为核心循环，从「写作」环节开始；当前第 001 章）")
        except Exception as e:
            self.log_line(f"⚠ 同步章节数失败：{e}")

        # 新项目：重置环节运行状态（保留 AI 指派），避免旧项目残留导致全部显示通过
        try:
            import stage_board as _sb
            current_state, _ = _sb.load()
            _sb.save(current_state, _sb.new_run_state())
            self._refresh_all_panels()
            self.log_line("🔄 已重置环节运行状态，新项目从头开始")
        except Exception as e:
            self.log_line(f"⚠ 重置环节运行状态失败：{e}")

        # 进入下一级界面：环节0.5 故事梗概确认（不直接调 WorkBuddy）
        summary_text = self._generate_summary(norm, self.reference_outline)
        self.summary_edit.setPlainText(summary_text)
        # 第0步梗概文件：把步骤0（初始化）的梗概内容另存为文件放入初始化文件夹
        try:
            init_dir = os.path.join(proj_ws, "00_初始化")
            os.makedirs(init_dir, exist_ok=True)
            with open(os.path.join(init_dir, "第0步梗概.md"), "w", encoding="utf-8") as f:
                f.write("# 第0步 · 故事梗概\n\n")
                f.write(summary_text + "\n")
            self.log_line("📄 已保存第0步梗概文件：00_初始化/第0步梗概.md")
        except Exception as e:
            self.log_line(f"⚠ 保存第0步梗概文件失败：{e}")
        try:
            self.summary_chat.clear()
        except Exception:
            pass
        self.log_line("✅ 已进入「故事梗概确认」页：确认/调整后点「下一步 → 进入环节1」")
        self.stack.setCurrentIndex(1)

    # ---------------------------------------------------------------- 项目模板选择
    def _on_template_changed(self, text):
        """切换模板时，导入项显示 blocks 选择按钮。"""
        self.init_blocks_btn.setVisible(text == "导入blocks.json…")

    def _pick_blocks(self):
        fp, _ = QFileDialog.getOpenFileName(self, "选择 blocks.json", "", "JSON (*.json)")
        if fp:
            self.init_blocks_path = fp
            self.init_blocks_btn.setText("已选: " + os.path.basename(fp))

    def _current_template(self):
        t = self.init_template.currentText()
        if t == "通用37环":
            return "通用37环", ""
        if t == "疯骨56子项":
            return "疯骨56", ""
        # 导入blocks.json…
        return "导入", self.init_blocks_path

    # ---------------------------------------------------------------- 已有项目 / 继续进度
    def _fill_existing_projects(self):
        """刷新『已有项目』下拉：列出产出目录下含 00_初始化 的有效项目。"""
        try:
            self.existing_combo.blockSignals(True)
            self.existing_combo.clear()
            names = self._list_existing_projects()
            if names:
                self.existing_combo.addItems(["（选择已有项目…）"] + names)
            else:
                self.existing_combo.addItems(["（暂无已有项目）"])
            self.existing_combo.setCurrentIndex(0)
        finally:
            self.existing_combo.blockSignals(False)

    def _list_existing_projects(self):
        try:
            root = paths.output_path("")
            if not os.path.isdir(root):
                return []
            out = []
            for d in sorted(os.listdir(root)):
                dp = os.path.join(root, d)
                if not os.path.isdir(dp):
                    continue
                # 有效项目判定：产出目录下存在 00_初始化（含 项目信息.json）即视为可继续
                if os.path.isdir(os.path.join(dp, "00_初始化")):
                    out.append(d)
            return out
        except Exception:
            return []

    def _on_continue_project(self):
        """继续已有项目：加载该项目上下文（工作区/章节数），跳到中央区环节1（规划），
        并还原之前未完成的进度（门控/运行状态从『按项目』工作区读取，不重置）。"""
        name = (self.existing_combo.currentText() or "").strip()
        if name in ("", "（选择已有项目…）", "（暂无已有项目）"):
            self.log_line("⚠ 请先在『已有项目』下拉里选择一个项目")
            return
        safe = self._safe_name(name)
        proj_ws = paths.output_path(safe)
        if not os.path.isdir(proj_ws):
            self.log_line("⚠ 找不到项目目录：%s" % proj_ws)
            return

        # 1) 记录项目根 + 显示名
        self._proj_ws = proj_ws
        self._proj_name = safe
        self.set_project_name(safe)

        # 1.5) 37 环引擎：切回本项目独立 config/（若存在），否则回退全局模板
        cfg_dir = os.path.join(proj_ws, "config")
        if os.path.isdir(cfg_dir):
            paths.set_active_project_cfg(cfg_dir)
            self._proj_cfg = cfg_dir
            self.log_line("🧩 已加载本项目 37 环配置：config/")
        else:
            paths.set_active_project_cfg(None)
            self._proj_cfg = None
            self.log_line("ℹ 本项目无独立 config/，37 环引擎将使用全局模板")

        # 2) 读取原项目章节数（沿用设定）
        chapters = 100
        try:
            info_path = os.path.join(proj_ws, "00_初始化", "项目信息.json")
            if os.path.exists(info_path):
                with open(info_path, encoding="utf-8") as f:
                    info = json.load(f) or {}
                chapters = info.get("章节数") or 100
        except Exception as e:
            self.log_line("⚠ 读取 项目信息.json 失败：%s" % e)
        try:
            self.eng_chapters.setValue(max(1, min(99999, int(chapters))))
        except Exception:
            pass
        self._refresh_progress()

        # 3) 切到该项目的『按项目』工作区（运行状态/规划蓝图随工作区加载，保留之前进度）
        try:
            paths.set_active_project_workspace(paths.workspace_project_path(safe))
        except Exception as e:
            self.log_line("⚠ 切换工作区失败：%s" % e)

        # 4) 同步章节数与项目工作区给自动执行引擎
        try:
            import auto_stage as _as
            _as.set_chapter_count(chapters)
            _as.set_current_chapter(1)
            _as.set_project_workspace(proj_ws)
            _as.save_chapter_progress()
        except Exception as e:
            self.log_line("⚠ 同步章节数失败：%s" % e)

        # 5) 加载已有运行状态（不清空，保留已通过/未通过的进度），刷新面板门控
        self.log_line("📂 已加载已有项目：%s（%d 章）—— 直接跳到环节1 继续未完成的进度"
                      % (safe, chapters))
        self.stack.setCurrentIndex(2)        # 跳过初始化选择与梗概确认，直接进中央区
        self.tabs.setCurrentIndex(0)         # 中央区第一个页签=环节1·规划
        self._refresh_all_panels()           # AssignPanel.refresh 会从激活工作区重载 state/run_state

    # ---------------------------------------------------------------- 工作区 / 协作蓝图
    def _generate_project_plan(self, safe, info, norm):
        """初始化增强：建『按项目』工作区，生成协作蓝图（规划文件树），拷贝提示词，预指派本地AI。

        产出目录（output/<项目名>/）保持不变；规划与提示词落在独立的工作区
        （workspace/<项目名>/），二者分开放，便于按项目回溯。
        """
        import stage_board as _sb
        import auto_stage as _as

        ws_root = paths.workspace_project_path(safe)
        plan_dir = os.path.join(ws_root, "规划")
        prompt_dir = os.path.join(ws_root, "提示词")
        os.makedirs(plan_dir, exist_ok=True)
        os.makedirs(prompt_dir, exist_ok=True)

        # 1) 拷贝提示词到工作区（仅首次，目录已有内容则跳过）
        try:
            if not any(os.scandir(prompt_dir)):
                shutil.copytree(paths.PROMPTS_DIR, prompt_dir, dirs_exist_ok=True)
                self.log_line("📂 已拷贝提示词到工作区：workspace/%s/提示词/" % safe)
        except Exception as e:
            self.log_line("⚠ 拷贝提示词失败：%s" % e)

        # 2) 预指派 AI
        #    - 第0环节『规划』只能由本地端(electron) AI 承担：网页端无法自写文件，
        #      规划蓝图需本地端落盘。
        #    - 审核者 / 调整者只能由本地端承担：环节终审闭环要求整合总结本环节全部产出、
        #      按打钩清单逐条修改并反复复审，网页端无法可靠读盘写盘、重写大段文本。
        #    - 其余产出块：本地优先，无本地则回退『已选 AI 池』（网页端）。
        local = _sb.local_ais()
        web_pool = _sb.available_ais() or []
        pool = local or web_pool or ["（未配置AI）"]
        role_pool = local or web_pool or ["（未配置AI）"]
        state, rstate = _sb.load()
        idx = 0
        for st in _sb.PIPELINE:
            sk = st["key"]
            if sk == "规划":  # 第0环节：只能本地端
                if not local:
                    self.log_line("⚠ 第0环节『规划』需要本地(非web)AI，但未检测到本地端 AI。"
                                  "请先在『添加AI』选择本地端后重跑初始化；该环节暂未指派。")
                    continue
                stage_pool = local
            else:
                stage_pool = pool
            for step in st["steps"]:
                sn = step["name"]
                sstep = state.setdefault(sk, {}).setdefault("steps", {}).setdefault(sn, {})
                sstep.setdefault("blocks", {})
                for b in (step.get("blocks") or []):
                    # 仅填补空位：保留用户手动指派的 AI，避免每次新建/重启项目被自动预指派覆盖
                    if not sstep["blocks"].get(b):
                        sstep["blocks"][b] = stage_pool[idx % len(stage_pool)]
                        idx += 1
                # 审核者 / 调整者：固定从本地端池取（终审子步同样需要调整者以完成闭环）
                # 同样只填补空位，保留用户已选 AI
                if not sstep.get("reviewer"):
                    sstep["reviewer"] = role_pool[idx % len(role_pool)]
                    idx += 1
                if not sstep.get("adjuster"):
                    sstep["adjuster"] = role_pool[idx % len(role_pool)]
                    idx += 1
        _sb.save(state, rstate)
        if local:
            self.log_line("🤖 已预指派（仅填补空位，保留手动指派）：产出块=%s；审核者/调整者=本地端 %s"
                          % ("、".join(pool), "、".join(role_pool)))
        else:
            self.log_line("⚠ 未检测到本地(非web)AI：产出块已回退到已选AI池预指派；"
                          "审核者/调整者因闭环要求需本地端，暂按已选AI池指派，请尽快添加本地端 AI。"
                          "第0环节『规划』需本地端，暂未指派。")

        # 3) 生成规划文件树（总览 + 每子步一个文件）
        chapter_aware = _as.CHAPTER_AWARE_STAGES
        order = _sb.STAGE_ORDER

        # 总览
        ov = ["# 协作蓝图 · 总览", "", "项目：%s" % safe,
              "产出目录（交付物）：output/%s/" % safe,
              "工作区（规划+提示词）：workspace/%s/" % safe, "",
              "## 环节顺序（大环节 → 子步）", ""]
        for i, st in enumerate(_sb.PIPELINE, 1):
            steps = "、".join(s["name"] for s in st["steps"])
            ov.append("%d. 【%s】%s" % (i, st["key"], st.get("desc", "")))
            ov.append("   - 子步：%s" % steps)
        ov.append("")
        ov.append("## 默认预指派 AI 池")
        ov.append("、".join(pool) + ("（本地优先；当前无本地AI，已回退已选池）" if not local else "（本地优先）"))
        ov.append("")
        ov.append("> 每个子步的『任务说明 / 输入资料 / 产出要求 / 指派AI』见同目录 规划_<环节>_<子步>.md；")
        ov.append("> 用户可在指派面板随时修改 AI 指派。")
        with open(os.path.join(plan_dir, "00_总览.md"), "w", encoding="utf-8") as f:
            f.write("\n".join(ov) + "\n")

        # 每子步规划
        for st in _sb.PIPELINE:
            sk = st["key"]
            for step in st["steps"]:
                sn = step["name"]
                content = self._build_step_plan(sk, sn, step, st.get("desc", ""),
                                               sk in chapter_aware, norm)
                with open(os.path.join(plan_dir, "规划_%s_%s.md" % (sk, sn)), "w", encoding="utf-8") as f:
                    f.write(content + "\n")
        self.log_line("📄 已生成协作蓝图：workspace/%s/规划/（总览 + 每子步规划）" % safe)

    def _build_step_plan(self, sk, sn, step, stage_desc, chapter_aware, norm):
        """构造单个子步的规划文件内容（四块：任务说明 / 输入资料 / 产出要求 / 指派AI）。"""
        import stage_board as _sb
        import auto_stage as _as
        L = []
        L.append("# 规划 · %s / %s" % (sk, sn))
        L.append("")
        L.append("## 一、任务说明")
        L.append(stage_desc or "（见总览）")
        if step.get("final"):
            L.append("（终审子步：仅送审核者做最终审核，不调整、不新增执行块。）")
        if chapter_aware:
            L.append("（本章为核心循环：每章先读上一章再生成，产出文件名带章号。）")
        L.append("")

        # 二、输入资料
        L.append("## 二、输入资料（运行前读取的文件）")
        order = _sb.STAGE_ORDER
        pos = order.index(sk)
        if pos == 0:
            L.append("- `00_初始化/1.0_总纲.md` ~ `1.6_卷纲.md`（环节0.5 生成的七份规划蓝图）")
            L.append("- `00_初始化/项目信息.json`（项目基础设定）")
        else:
            for prev in order[:pos]:
                L.append("- 上游环节【%s】产出目录：`%02d_%s/`（含已通过子项产物）"
                         % (prev, order.index(prev) + 1, prev))
            if sk == "写作":
                L.append("- `00_初始化/1.0_总纲.md` ~ `1.6_卷纲.md`（环节0.5 生成的七份规划蓝图）、`00_初始化/项目信息.json`")
            if chapter_aware:
                L.append("- 上一章定稿：`%02d_%s/第{章-1}章_*.md`" % (order.index(sk) + 1, sk))
        L.append("")

        # 三、产出要求
        L.append("## 三、产出要求（完成后按文件是否就位严格校验）")
        items = _as._step_items_of(sk, step)

        def _bname(it):
            ch = 1 if chapter_aware else None
            if it == "reviewer":
                p = _as._review_path(sk, sn, ch)
            elif it == "adjuster":
                p = _as._adjust_path(sk, sn, ch)
            else:
                p = _as._produce_path(sk, sn, it, ch)
            b = os.path.basename(p)
            if chapter_aware:
                b = b.replace("第001章_", "第{N}章_")
            return b

        for it in items:
            b = _bname(it)
            if it == "reviewer":
                L.append("- 审核意见：`%s`（以审核状态为准，不强制落盘文件）" % b)
            elif it == "adjuster":
                L.append("- 调整稿：`%s`" % b)
            else:
                L.append("- 执行产出：`%s`" % b)
        if chapter_aware:
            L.append("（章意识环节文件名前缀 `第{N}章_`，N 为当前章号）")
        L.append("")

        # 四、指派AI
        L.append("## 四、指派AI（默认预选，可在指派面板修改）")
        state, _ = _sb.load()
        sstep = (state.get(sk, {}).get("steps", {}) or {}).get(sn, {}) or {}
        for it in items:
            if it == "reviewer":
                L.append("- 审核者：%s" % (sstep.get("reviewer") or "（未指派）"))
            elif it == "adjuster":
                L.append("- 调整者：%s" % (sstep.get("adjuster") or "（未指派）"))
            else:
                L.append("- 执行块【%s】：%s" % (it, (sstep.get("blocks") or {}).get(it) or "（未指派）"))
        L.append("")
        return "\n".join(L)

    def _open_plan_file(self, sk, sn):
        """打开某子步的规划文件（协作蓝图）；不存在则提示（老项目无规划属正常）。"""
        import subprocess
        safe = getattr(self, "_proj_name", None) or "未命名项目"
        p = paths.workspace_project_path(safe, "规划", "规划_%s_%s.md" % (sk, sn))
        if not os.path.exists(p):
            self.log_line("⚠ 规划文件不存在：%s（请先确认本项目已初始化生成规划；老项目无规划属正常）" % p)
            return
        try:
            os.startfile(p)
        except Exception:
            try:
                subprocess.Popen(["notepad", p])
            except Exception as e:
                self.log_line("⚠ 无法打开规划文件：%s" % e)

    # ------------------------------------------------- 37 环引擎：运行 / 放行 / 指派
    def _run_37phase(self, resume=False):
        """32流程版·37环引擎：按当前激活 config 运行所选大环节（resume=True 断点续跑）。"""
        stage = self.eng_stage.currentText()
        proj_ws = self._engine_project_ws()
        if not proj_ws:
            return
        if getattr(self, "_phase_worker", None) and self._phase_worker.isRunning():
            self.log_line("⚠ 37 环引擎正在运行（如需停请先点 ⏸暂停），请稍候")
            return
        if not resume:
            clear_pause()
        else:
            clear_pause()
        self._phase_worker = _PhaseRunWorker(stage, proj_ws, getattr(self, "_proj_name", ""),
                                             None, resume=resume)
        self._phase_worker.progress.connect(self.log_line)
        self._phase_worker.done.connect(
            lambda ok, msg: self._on_engine_done(stage, ok, msg))
        self._phase_worker.start()
        tag = "（断点续跑：已有产出自动跳过）" if resume else ""
        self.log_line("⏳ 37 环引擎运行中：%s%s → 产物目录 %s/%s/" % (stage, tag, proj_ws, stage))

    def _run_37book(self, resume=False):
        """章节循环：01_规划 一次 → 每章（写作4+润色1+审核9）循环 N 次 → 05_出厂 一次。"""
        proj_ws = self._engine_project_ws()
        if not proj_ws:
            return
        if getattr(self, "_phase_worker", None) and self._phase_worker.isRunning():
            self.log_line("⚠ 37 环引擎正在运行（如需停请先点 ⏸暂停），请稍候")
            return
        chapters = self.eng_chapters.value() if hasattr(self, "eng_chapters") else 1
        clear_pause()
        self._phase_worker = _PhaseRunWorker("全书", proj_ws, getattr(self, "_proj_name", ""),
                                             None, resume=resume, chapters=chapters, book=True)
        self._phase_worker.progress.connect(self.log_line)
        self._phase_worker.done.connect(
            lambda ok, msg: self._on_engine_done("全书（章节循环）", ok, msg))
        self._phase_worker.start()
        tag = "（断点续跑）" if resume else ""
        self.log_line("⏳ 全书章节循环启动：规划1轮 + %d 章（每章 写作4→润色1→审核9）+ 出厂1轮%s"
                      % (chapters, tag))

    def _pause_37phase(self):
        """暂停：当前环节跑完后停住（可改指派后从断点继续）。"""
        if not (getattr(self, "_phase_worker", None) and self._phase_worker.isRunning()):
            self.log_line("⚠ 当前没有在跑的环节，无需暂停")
            return
        request_pause()
        self.log_line("⏸ 已请求暂停：当前环节完成后停止（可 🎯AI指派 换选手/评委，再点 ▶▶继续）")

    def _engine_project_ws(self):
        proj_ws = getattr(self, "_proj_ws", None)
        if not proj_ws or not os.path.isdir(proj_ws):
            proj_ws = paths.output_path(getattr(self, "_proj_name", "") or "未命名项目")
        if not os.path.isdir(proj_ws):
            self.log_line("⚠ 尚未创建/继续项目，请先新建或继续项目")
            return None
        return proj_ws

    def _on_engine_done(self, stage, ok, msg):
        if ok and msg == "已暂停":
            self.log_line("⏸ 37环·%s 已暂停。可改指派后点 ▶▶继续（断点续跑）" % stage)
        elif ok:
            self.log_line("✅ 37环·%s 运行结束" % stage)
        else:
            self.log_line("⚠ 37环·%s 结束：%s" % (stage, msg))
        self._refresh_progress()

    def _release_37phase(self):
        """37 环引擎：把所选环节的 放行.json 标记为已放行（confirmed=true）。
        章节循环模式下若存在 章号 子目录，则逐章放行。"""
        stage = self.eng_stage.currentText()
        proj_ws = self._engine_project_ws()
        if not proj_ws:
            return
        base = os.path.join(proj_ws, stage)
        targets = []
        if os.path.isdir(base):
            subs = [d for d in os.listdir(base)
                    if os.path.isdir(os.path.join(base, d)) and os.path.exists(
                        os.path.join(base, d, "放行.json"))]
            targets = [os.path.join(base, d, "放行.json") for d in sorted(subs)]
        direct = os.path.join(base, "放行.json")
        if os.path.exists(direct):
            targets.append(direct)
        if not targets:
            self.log_line("⚠ 未找到 %s 的放行.json（请先运行本环节）" % stage)
            return
        ok = 0
        for rel in targets:
            try:
                with open(rel, encoding="utf-8") as f:
                    d = json.load(f) or {}
                d["confirmed"] = True
                with open(rel, "w", encoding="utf-8") as f:
                    json.dump(d, f, ensure_ascii=False, indent=2)
                ok += 1
            except Exception as e:
                self.log_line("⚠ 放行失败 %s：%s" % (rel, e))
        self.log_line("✅ 已放行 %s（%d 个放行文件）" % (stage, ok))
        self._refresh_progress()

    def _ai_alive_map(self):
        """实时探测左侧选手栏的连通性（绿灯）：{名字: True/False}。
        绿灯名单就是 AI 指派的候选池——启动几个就有几个选项。"""
        alive = {}
        try:
            from players import cdp_alive as _ca
            for p in (getattr(self, "players", None) or self._ai_app_names_players()):
                port = p.get("cdp_port")
                alive[p.get("名字")] = bool(port and _ca(port))
        except Exception:
            pass
        self._last_alive = alive
        return alive

    def _ai_app_names_players(self):
        try:
            from players import load_players
            return load_players()
        except Exception:
            return []

    def _assign_modules(self, phases):
        """把 phases.json 的环节折成 4 大模块（+05 出厂），每模块统计环数与样例环名。"""
        mods = []
        for stage in ("01_规划", "02_写作", "03_去AI", "04_审核", "05_出厂"):
            rings = (phases.get("环节") or {}).get(stage)
            if not rings:
                continue
            names = []
            for r in rings:
                if isinstance(r, dict):
                    n = r.get("name") or "?"
                    if r.get("items"):
                        n += "(%d子项)" % len(r["items"])
                    if r.get("segments"):
                        n += "(%d段)" % len(r["segments"])
                else:
                    n = str(r)
                names.append(n)
            sample = "、".join(names[:3]) + ("…" if len(names) > 3 else "")
            mods.append({"stage": stage, "count": len(rings), "sample": sample})
        return mods

    def _open_assign_dialog(self):
        """打开 4 大模块 AI 指派对话框（选项=当前绿灯 AI；一个模块指派一次，全环沿用）。"""
        cfg = paths.get_cfg_rules_dir()
        ph_path = os.path.join(cfg, "phases.json")
        as_path = os.path.join(cfg, "assignments.json")
        if not os.path.exists(ph_path):
            self.log_line("⚠ 未找到 phases.json：%s" % ph_path)
            return
        try:
            phases = json.load(open(ph_path, encoding="utf-8")) or {}
            assigns = json.load(open(as_path, encoding="utf-8")) or {} if os.path.exists(as_path) else {}
        except Exception as e:
            self.log_line("⚠ 读取配置失败：%s" % e)
            return
        mods = self._assign_modules(phases)
        if not mods:
            self.log_line("⚠ phases.json 无 01/02/03/04 环节")
            return
        # 候选池 = 当前绿灯（已连通）AI，实时探测；顺序与左侧选手表一致（已启动在上）
        alive = self._ai_alive_map()
        green = self._alive_names(alive)
        self.log_line("🎯 AI指派：当前绿灯 AI %d 个 → %s" % (len(green), "、".join(green) or "无"))
        # 传 green 作为候选名单（对话框按此顺序渲染；未启动的不出现）
        dlg = _AssignModuleDialog(mods, assigns, green, alive, as_path, parent=self)
        if dlg.exec() == QDialog.Accepted:
            self.log_line("✅ 已保存 4 大模块 AI 指派到 %s（各模块下所有环节统一沿用）" % as_path)

    def _deliver(self, src_root, block_key, log_fn=None):
        """AI 已直接把产物写到产出目录的项目步骤树里；此处仅核对关键交付物是否就位。"""
        log_fn = log_fn or self.log_line
        out_dir = paths.output_path(getattr(self, "_proj_name", "未命名项目"))
        try:
            with open(os.path.join(paths.RULES_DIR, "deliverables.json"), encoding="utf-8") as f:
                data = json.load(f) or {}
        except Exception as e:
            log_fn(f"⚠ 读取 deliverables.json 失败：{e}")
            return
        for entry in (data.get(block_key) or []):
            dst_rel = (entry.get("产出区") or "").strip()
            if not dst_rel:
                continue
            dst = os.path.join(out_dir, *dst_rel.split("/"))
            if os.path.exists(dst) and os.path.getsize(dst) >= 1:
                log_fn(f"📦 产出已就位：{dst_rel}")
            else:
                log_fn(f"⚠ 产出缺失（AI 未生成）：{dst_rel}")

    def _deliver_00(self):
        """步骤6：按 deliverables.json 的 00_初始化 块交付。"""
        init_dir = os.path.join(getattr(self, "_proj_ws", paths.WORKSPACE), "00_初始化")
        self._deliver(init_dir, "00_初始化")

    # ------------------------------------------------- 环节1 运行 / 放行
    def _stage1_run(self):
        proj_ws = getattr(self, "_proj_ws", None)
        proj_name = getattr(self, "_proj_name", "")
        if not proj_ws or not os.path.isdir(proj_ws):
            self.log_line("⚠ 尚未完成环节0（无工作区），请先开始规划")
            return
        # 读 rules/assignments.json 的"环节1"块（01_规划）
        try:
            with open(os.path.join(paths.RULES_DIR, "assignments.json"), encoding="utf-8") as f:
                ad = json.load(f) or {}
            blk = ad.get("环节", {}).get("01_规划", {})
            self.log_line(f"环节1 角色：执行={blk.get('执行')} 审核={blk.get('审核')} 调整={blk.get('调整')}")
        except Exception as e:
            self.log_line(f"⚠ 读取 assignments 失败：{e}")
        # 后台运行
        if getattr(self, "_phase_worker", None) and self._phase_worker.isRunning():
            self.log_line("⚠ 上一轮环节1 仍在运行")
            return
        self._phase_worker = _PhaseRunWorker(
            "01_规划", proj_ws, proj_name, self._finalize_phase1)
        self._phase_worker.progress.connect(self.log_line)
        self._phase_worker.done.connect(self._on_phase1_done)
        self._phase_worker.start()
        self.log_line("⏳ 环节1 运行中（后台调用 WorkBuddy，逐子环输出）…")

    def _finalize_phase1(self, phase_dir, subs, finals, log_fn=print):
        """环节1 收尾：对七份复核稿做整合审核 → 调整 → 汇总 规划_锁定版.md → 交付产出区。"""
        log_fn("== 环节1 收尾：整合审核 → 调整 → 规划_锁定版 ==")
        parts = []
        for sub, fp in finals:
            if fp and os.path.exists(fp):
                try:
                    parts.append(f"# {sub}\n" + open(fp, encoding="utf-8").read())
                except Exception:
                    pass
        draft = "\n\n".join(parts)
        if not draft.strip():
            log_fn("⚠ 没有可用的子环产出，无法汇总 规划_锁定版")
            return
        # 整合审核（_审核者 → review.md）
        review_text = generate(phase_dir, "_审核者", draft, "审核",
                               out_name="_审核者/review.md", log_fn=log_fn)
        # 调整（_调整者 → adjusted.md）
        base = draft
        if review_text:
            base = draft + "\n\n## 评审意见\n" + review_text
        adj_text = generate(phase_dir, "_调整者", base, "调整",
                            out_name="_调整者/adjusted.md", log_fn=log_fn)
        locked = (adj_text or review_text or draft)
        locked_path = os.path.join(phase_dir, "规划_锁定版.md")
        with open(locked_path, "w", encoding="utf-8") as f:
            f.write(locked + "\n")
        log_fn(f"✔ 规划_锁定版.md 已汇总：{locked_path}")
        # 交付产出区（deliverables.json 01_规划 块）
        self._deliver(phase_dir, "01_规划", log_fn)

    def _on_phase1_done(self, ok, msg):
        if ok:
            self.log_line("✅ 环节1 运行完成：规划_锁定版.md 已生成并交付产出区")
            self.log_line("⏸ 请在核对后点击【放行】按钮（放行.json confirmed=true）")
        else:
            self.log_line(f"❌ 环节1 运行失败：{msg}")

    def _stage1_release(self):
        proj_ws = getattr(self, "_proj_ws", None)
        if not proj_ws:
            self.log_line("⚠ 尚无工作区，无法放行")
            return
        rel_path = os.path.join(proj_ws, "01_规划", "放行.json")
        try:
            data = {}
            if os.path.exists(rel_path):
                with open(rel_path, encoding="utf-8") as f:
                    data = json.load(f) or {}
            data["confirmed"] = True
            data["by"] = "human"
            data["time"] = time.strftime("%Y-%m-%d %H:%M:%S")
            with open(rel_path, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
            self.log_line(f"✅ 已放行环节1（confirmed=true）：{rel_path}")
        except Exception as e:
            self.log_line(f"❌ 写放行.json 失败：{e}")

    # ------------------------------------------------- 环节2 · 子环角色指派 + 运行/放行
    def _build_stage2_assign(self):
        """环节2（写作）页面：2-1~2-5 子环 + 2-2 六段复合正文，每行三下拉；开始运行/放行。"""
        w = QWidget()
        v = QVBoxLayout(w)
        v.setContentsMargins(8, 8, 8, 8)
        v.setSpacing(6)

        title = QLabel("环节2 · 写作 — 子环角色指派")
        title.setStyleSheet("font-size:15px; font-weight:bold; color:#00e5ff;")
        v.addWidget(title)
        hint = QLabel("2-2 为正文复合子环（始→显→通→动→成→终 六段拼接）。"
                      "改动自动写回 rules/assignments.json。")
        hint.setWordWrap(True)
        hint.setStyleSheet("color:#aaaaaa; font-size:11px;")
        v.addWidget(hint)

        hdr = QHBoxLayout()
        hdr.setSpacing(6)
        for txt, wd in (("子环 / 角色组", 150), ("执行者", 120), ("审核者", 120), ("调整者", 120)):
            h = QLabel(txt)
            h.setFixedWidth(wd)
            h.setStyleSheet("color:#888; font-size:11px;")
            hdr.addWidget(h)
        v.addLayout(hdr)

        try:
            with open(os.path.join(paths.RULES_DIR, "assignments.json"), encoding="utf-8") as f:
                data = json.load(f) or {}
        except Exception:
            data = {}
        stage = data.get("环节", {}).get("02_写作", {})
        sub_rings = list(stage.get("子环", []))
        detail = stage.get("明细", {})
        exec_def = stage.get("执行", "")
        audit_def = stage.get("审核", "")
        adj_def = stage.get("调整", "")
        app_names = self._ai_app_names()

        for name in sub_rings:
            d = detail.get(name, {}) or {}
            ev = d.get("执行") or exec_def
            av = d.get("审核") or audit_def
            tv = d.get("调整") or adj_def
            row = QHBoxLayout()
            row.setSpacing(6)
            lbl = QLabel(name)
            lbl.setFixedWidth(150)
            lbl.setStyleSheet("color:#ccc; font-size:12px;")
            row.addWidget(lbl)
            for val, role in ((ev, "执行"), (av, "审核"), (tv, "调整")):
                cb = QComboBox()
                opts = [""] + app_names
                if val and val not in opts:
                    opts = ["", val] + app_names
                cb.addItems(opts)
                cb.setCurrentText(val or "")
                cb.setFixedWidth(120)
                cb.setProperty("sub", name)
                cb.setProperty("role", role)
                cb.currentTextChanged.connect(self._on_stage2_assign_changed)
                row.addWidget(cb)
            v.addLayout(row)

        btn_row = QHBoxLayout()
        btn_row.setSpacing(8)
        run_btn = QPushButton("▶ 开始运行")
        run_btn.setMinimumHeight(30)
        run_btn.setStyleSheet("background:#1e88e5; color:#fff; font-weight:bold; border-radius:4px;")
        run_btn.clicked.connect(self._stage2_run)
        rel_btn = QPushButton("⏸ 放行")
        rel_btn.setMinimumHeight(30)
        rel_btn.setStyleSheet("background:#43a047; color:#fff; font-weight:bold; border-radius:4px;")
        rel_btn.clicked.connect(self._stage2_release)
        btn_row.addWidget(run_btn)
        btn_row.addWidget(rel_btn)
        btn_row.addStretch(1)
        v.addLayout(btn_row)

        v.addStretch(1)
        sc = QScrollArea()
        sc.setWidgetResizable(True)
        sc.setStyleSheet("QScrollArea{border:none;}")
        sc.setWidget(w)
        return sc

    def _on_stage2_assign_changed(self, text):
        cb = self.sender()
        if not cb:
            return
        name = cb.property("sub")
        role = cb.property("role")
        try:
            with open(os.path.join(paths.RULES_DIR, "assignments.json"), encoding="utf-8") as f:
                data = json.load(f) or {}
        except Exception as e:
            self.log_line(f"⚠ 读取 assignments.json 失败：{e}")
            return
        stage = data.setdefault("环节", {}).setdefault("02_写作", {})
        detail = stage.setdefault("明细", {})
        d = detail.setdefault(name, {})
        d[role] = text
        try:
            with open(os.path.join(paths.RULES_DIR, "assignments.json"), "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
            self.log_line(f"💾 已保存指派：{name} / {role} = {text or '（空）'}")
        except Exception as e:
            self.log_line(f"❌ 写回 assignments.json 失败：{e}")

    def _stage2_run(self):
        proj_ws = getattr(self, "_proj_ws", None)
        proj_name = getattr(self, "_proj_name", "")
        if not proj_ws or not os.path.isdir(proj_ws):
            self.log_line("⚠ 尚未完成环节0（无工作区），请先开始规划")
            return
        try:
            with open(os.path.join(paths.RULES_DIR, "assignments.json"), encoding="utf-8") as f:
                ad = json.load(f) or {}
            blk = ad.get("环节", {}).get("02_写作", {})
            self.log_line(f"环节2 角色：执行={blk.get('执行')} 审核={blk.get('审核')} 调整={blk.get('调整')}")
        except Exception as e:
            self.log_line(f"⚠ 读取 assignments 失败：{e}")
        if getattr(self, "_phase_worker", None) and self._phase_worker.isRunning():
            self.log_line("⚠ 上一轮环节仍在运行")
            return
        self._phase_worker = _PhaseRunWorker(
            "02_写作", proj_ws, proj_name, self._finalize_phase2)
        self._phase_worker.progress.connect(self.log_line)
        self._phase_worker.done.connect(self._on_phase2_done)
        self._phase_worker.start()
        self.log_line("⏳ 环节2 运行中（后台调用 WorkBuddy，含 2-2 六段正文）…")

    def _finalize_phase2(self, phase_dir, subs, finals, log_fn=print):
        """环节2 收尾：把 第001章_正文.md 按 deliverables.json 交付产出区。"""
        log_fn("== 环节2 收尾：交付 第001章_正文.md 到产出区 ==")
        self._deliver(phase_dir, "02_写作", log_fn)

    def _on_phase2_done(self, ok, msg):
        if ok:
            self.log_line("✅ 环节2 运行完成：第001章_正文.md 已生成并交付产出区")
            self.log_line("⏸ 请在核对后点击【放行】按钮（放行.json confirmed=true）")
        else:
            self.log_line(f"❌ 环节2 运行失败：{msg}")

    def _stage2_release(self):
        proj_ws = getattr(self, "_proj_ws", None)
        if not proj_ws:
            self.log_line("⚠ 尚无工作区，无法放行")
            return
        rel_path = os.path.join(proj_ws, "02_写作", "放行.json")
        try:
            data = {}
            if os.path.exists(rel_path):
                with open(rel_path, encoding="utf-8") as f:
                    data = json.load(f) or {}
            data["confirmed"] = True
            data["by"] = "human"
            data["time"] = time.strftime("%Y-%m-%d %H:%M:%S")
            with open(rel_path, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
            self.log_line(f"✅ 已放行环节2（confirmed=true）：{rel_path}")
        except Exception as e:
            self.log_line(f"❌ 写放行.json 失败：{e}")

    # ------------------------------------------------- 环节3 · 子环角色指派 + 运行/放行
    def _build_stage3_assign(self):
        """环节3（去AI）页面：3-1~3-5 五步链式，每行三下拉；开始运行/放行。"""
