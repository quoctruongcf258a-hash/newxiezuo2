def _ring_label(r):
    """环 → 显示名（短）。"""
    if isinstance(r, dict):
        return r.get("name") or "?"
    return str(r)


class _AssignModuleDialog(QDialog):
    """37 环引擎 · 4 大模块 AI 指派。

    设计原则（对应需求）：
      · 一个大模块（01_规划 / 02_写作 / 03_去AI / 04_审核 / 05_出厂）**只指派一次**，
        其下全部环节（规划23 / 写作4 / 润色1 / 审核9）统一沿用，无需逐环再选。
      · 选项名单 = **当前已启动（绿灯）的 AI**，随左侧选手栏的启动状态实时变化：
        启动 3 个就只有 3 个选项，启动 4 个就有 4 个。写手/裁判同样只列绿灯。
      · 写手 ≥ 2（同时开写）、裁判 ≥ 2（同时盲审），不足则拦截保存。
    保存时写 assignments.json 的**环节级**指派，并清掉该模块的环级「明细」，
    避免旧的逐环默认指派反过来覆盖模块级设置。
    """

    def __init__(self, modules, assigns, ai_names, alive, as_path, parent=None):
        super().__init__(parent)
        self.setWindowTitle("37 环 · 4 大模块 · AI 指派")
        self.resize(920, 700)
        self.modules = modules
        self.assigns = assigns or {}
        self.as_path = as_path
        self.alive = alive or {}
        self.green = [n for n in ai_names if self.alive.get(n)]
        self.all_names = ai_names
        self.rows = {}
        self._build()

    # ---------------------------------------------------------- 点选按钮组
    def _style_chip(self, b):
        if b.isChecked():
            b.setStyleSheet(
                "QPushButton{background:#1e8e3e;color:#fff;font-weight:bold;"
                "border:1px solid #166527;border-radius:4px;padding:4px 10px;}"
                "QPushButton:hover{background:#23a34a;}")
        else:
            b.setStyleSheet(
                "QPushButton{background:#333333;color:#d4d4d4;"
                "border:1px solid #3c3c3c;border-radius:4px;padding:4px 10px;}"
                "QPushButton:hover{background:#3e3e42;}")

    def _mk_chips(self, saved_names, lbl, role):
        """绿灯 AI 的点选按钮组：点一下变绿＝选中。返回 (容器, {名字:按钮})。

        按钮宽度按文字实际长度自适应（CJK 按更宽的字宽算），保证名字**完整显示**、
        不被列宽挤掉；每行按钮数按窗口宽度自适应。
        """
        cont = QWidget()
        grid = QGridLayout(cont)
        grid.setContentsMargins(0, 0, 0, 0)
        grid.setHorizontalSpacing(6)
        grid.setVerticalSpacing(4)
        btns = {}
        if not self.green:
            only = QLabel("（当前没有已启动的绿灯 AI，请到左侧『选手』栏启动）")
            only.setStyleSheet("color:#e2574c; font-size:12px;")
            grid.addWidget(only, 0, 0)
            lbl.setText("%s（没有已启动的 AI）" % role)
            lbl.setStyleSheet("color:#e2574c;")
            return cont, btns

        def _w(text):
            # CJK/全角按 15px、半角按 9px 估算 + 内边距
            w = 0
            for ch in text:
                w += 15 if ("\u2e80" <= ch <= "\u9fff" or "\uff00" <= ch <= "\uffef") else 9
            return w + 30

        widths = [_w(n) for n in self.green]
        avail = max(360, self.width() - 260)
        per_row = max(1, min(6, int(avail // (max(widths) + 8))))
        for i, n in enumerate(self.green):
            b = QPushButton(n)
            b.setCheckable(True)
            b.setCursor(_Qt.PointingHandCursor)
            b.setMinimumWidth(widths[i])
            b.setSizePolicy(QSizePolicy.Minimum, QSizePolicy.Fixed)
            b.setChecked(n in saved_names)
            b.setToolTip(n + "（已连通，绿灯）")
            self._style_chip(b)
            grid.addWidget(b, i // per_row, i % per_row)
            btns[n] = b

        def upd():
            n_sel = sum(1 for b in btns.values() if b.isChecked())
            lbl.setText("%s（点选，已选 %d，至少 2）" % (role, n_sel))
            lbl.setStyleSheet("color:#1e8e3e;" if n_sel >= 2 else "color:#e2574c;")

        for b in btns.values():
            b.toggled.connect(lambda _on, bb=b: (self._style_chip(bb), upd()))
        upd()
        return cont, btns

    def _mk_combo(self, val):
        """下拉只列当前绿灯 AI（顺序同选手表），宽度足够显示完整名字。"""
        cb = QComboBox()
        cb.setSizeAdjustPolicy(QComboBox.AdjustToMinimumContentsLengthWithIcon)
        cb.addItem("（不设）")
        for n in self.green:
            cb.addItem(n)
        if val:
            i = cb.findText(val)
            cb.setCurrentIndex(i if i >= 0 else 0)
        longest = max([len("（不设）")] + [len(n) for n in self.green]) if self.green else 8
        cb.setMinimumWidth(min(360, longest * 15 + 60))
        cb.setToolTip("只显示已启动（绿灯）的 AI")
        return cb

    # ---------------------------------------------------------- 界面
    def _build(self):
        lay = QVBoxLayout(self)
        tip = QLabel("① 每个大模块只指派一次，下面所有环节统一沿用；"
                     "② 选项 = 当前已启动（绿灯）的 AI，启动几个就有几个；"
                     "③ 写手 ≥ 2、裁判 ≥ 2。保存写回 assignments.json 的环节级指派。")
        tip.setWordWrap(True)
        tip.setStyleSheet("color:#aaaaaa; font-size:12px;")
        lay.addWidget(tip)

        sc = QScrollArea()
        sc.setWidgetResizable(True)
        body = QWidget()
        bl = QVBoxLayout(body)
        bl.setSpacing(10)
        for mod in self.modules:
            stage = mod["stage"]
            node = self.assigns.get("环节", {}).get(stage, {}) or {}
            # 已有指派：优先环节级；没有则取首个环明细（种子默认值），便于迁移
            detail0 = next(iter((node.get("明细") or {}).values()), {}) or {}
            g = QGroupBox("%s · 共 %d 环：%s" % (stage, mod["count"], mod["sample"]))
            g.setStyleSheet("QGroupBox{color:#00e5ff; font-weight:bold;}")
            gl = QGridLayout(g)
            gl.setSpacing(6)

            w_lbl = QLabel()
            w_cont, w_btns = self._mk_chips(
                set(node.get("writers") or detail0.get("writers") or []), w_lbl, "写手")
            gl.addWidget(w_lbl, 0, 0)
            gl.addWidget(w_cont, 0, 1, 1, 4)
            j_lbl = QLabel()
            j_cont, j_btns = self._mk_chips(
                set(node.get("judges") or detail0.get("judges") or []), j_lbl, "裁判")
            gl.addWidget(j_lbl, 1, 0)
            gl.addWidget(j_cont, 1, 1, 1, 4)

            combos = {}
            for r, (key, lbl_txt) in enumerate((("merger", "汇总"), ("审核", "审核"),
                                                ("调整", "调整")), start=2):
                gl.addWidget(QLabel(lbl_txt), r, 0)
                cb = self._mk_combo(node.get(key) or detail0.get(key) or "")
                gl.addWidget(cb, r, 1)
                combos[key] = cb
            bl.addWidget(g)
            self.rows[stage] = {"writers": w_btns, "judges": j_btns,
                                "merger": combos["merger"], "审核": combos["审核"],
                                "调整": combos["调整"]}
        sc.setWidget(body)
        lay.addWidget(sc, 1)

        btns = QHBoxLayout()
        ok = QPushButton("保存指派")
        ok.setMinimumHeight(30)
        ok.setStyleSheet("QPushButton{background:#43a047;color:#fff;font-weight:bold;border-radius:4px;}")
        ok.clicked.connect(self._save)
        cancel = QPushButton("取消")
        cancel.setMinimumHeight(30)
        cancel.clicked.connect(self.reject)
        btns.addStretch(1)
        btns.addWidget(ok)
        btns.addWidget(cancel)
        lay.addLayout(btns)

    # ---------------------------------------------------------- 保存
    def _save(self):
        bad, parsed = [], {}
        for stage, w in self.rows.items():
            writers = [n for n, b in w["writers"].items() if b.isChecked()]
            judges = [n for n, b in w["judges"].items() if b.isChecked()]
            if len(writers) < 2:
                bad.append("%s：写手仅 %d 个（至少 2 个 AI 同时写）" % (stage, len(writers)))
            if len(judges) < 2:
                bad.append("%s：裁判仅 %d 个（至少 2 个 AI 盲审）" % (stage, len(judges)))
            parsed[stage] = {
                "writers": writers,
                "judges": judges,
                "merger": w["merger"].currentText() if w.get("merger") else "",
                "审核": w["审核"].currentText() if w.get("审核") else "",
                "调整": w["调整"].currentText() if w.get("调整") else "",
            }
        if bad:
            QMessageBox.warning(
                self, "不满足指派规则（未保存）",
                "写手≥2、裁判≥2（点亮的绿色按钮才算选中）：\n\n" + "\n".join(bad) +
                "\n\n如绿灯不够，请先在左侧『选手』栏启动更多 AI（亮绿灯）再打开本窗口。")
            return
        for stage, val in parsed.items():
            node = self.assigns.setdefault("环节", {}).setdefault(stage, {})
            node.update(val)
            # 环级明细里只清掉「AI 选择类」键，让它们回退继承模块级指派；
            # mode / audit 等环节固有配置必须保留（否则该环会被判定为未配置而跳过）
            for ring, det in (node.get("明细") or {}).items():
                if not isinstance(det, dict):
                    continue
                for k in ("writers", "judges", "merger", "审核", "调整"):
                    det.pop(k, None)
            for k in ("merger", "审核", "调整"):
                if not node.get(k):
                    node[k] = ""
        try:
            with open(self.as_path, "w", encoding="utf-8") as f:
                json.dump(self.assigns, f, ensure_ascii=False, indent=2)
        except Exception as e:
            QMessageBox.warning(self, "保存失败", str(e))
            return
        self.accept()


class _WBFileWorker(QThread):
    """后台监听步骤0产出目录：直接让 WorkBuddy 把结果写成文件（参考 v0.8
    判定机制，提示词 no0tisc.md 已要求 AI 落盘到该目录），通过文件大小是否
    稳定来判定 AI 是否生成完毕；稳定即视为完成，发出 done 信号进入下一步。"""
    log = Signal(str)
    done = Signal(str)

    POLL_SEC = 4            # 轮询间隔（秒）
    MAX_ROUNDS = 600        # 最多轮次（约 40 分钟）
    MIN_BYTES = 200         # 低于此大小视为尚未写完整
    STABLE_NEED = 3         # 连续 N 次大小不变即判定完成

    def __init__(self, watch_dir, start_time, proj_name="", min_bytes=None, expected=None):
        super().__init__()
        self.watch_dir = watch_dir
        self.start_time = start_time   # 仅统计此时间之后新建/修改的文件
        self.proj_name = proj_name
        self.min_bytes = min_bytes if min_bytes is not None else self.MIN_BYTES
        self.expected = expected or None   # 期望集齐的文件名列表（步骤0 = 七份规划蓝图）

    def _candidates(self):
        import os
        exts = (".json", ".md", ".txt")
        out = []
        try:
            names = os.listdir(self.watch_dir)
        except Exception:
            return out
        for f in names:
            if not f.lower().endswith(exts):
                continue
            fp = os.path.join(self.watch_dir, f)
            try:
                st = os.stat(fp)
            except Exception:
                continue
            if st.st_mtime < self.start_time:   # 跳过本次发送之前就存在的旧文件
                continue
            out.append((fp, st.st_size))
        return out

    def run(self):
        import os, time
        os.makedirs(self.watch_dir, exist_ok=True)
        self.log.emit(f"⏳ 开始监听产出目录：{self.watch_dir}")
        # 多文件模式（步骤0 = 七份规划蓝图）：全部集齐且大小连续稳定才判定完成
        if self.expected:
            need = list(self.expected)
            sizes = {}
            stable_rounds = 0
            for _ in range(self.MAX_ROUNDS):
                try:
                    present = {}
                    for n in need:
                        fp = os.path.join(self.watch_dir, n)
                        try:
                            st = os.stat(fp)
                        except Exception:
                            continue
                        if st.st_mtime < self.start_time:
                            continue
                        present[n] = st.st_size
                    if len(present) == len(need):
                        if all(sz >= self.min_bytes for sz in present.values()):
                            if present == sizes:
                                stable_rounds += 1
                            else:
                                stable_rounds = 0
                                sizes = dict(present)
                            if stable_rounds >= self.STABLE_NEED:
                                self.log.emit("✅ 七份规划蓝图均已生成且大小稳定，判定完成")
                                self.done.emit(os.path.join(self.watch_dir, sorted(need)[0]))
                                return
                        else:
                            sizes = dict(present)
                            stable_rounds = 0
                    else:
                        sizes = {}
                        stable_rounds = 0
                except Exception as e:
                    self.log.emit(f"⚠ 监听产出目录失败：{e}")
                time.sleep(self.POLL_SEC)
            self.log.emit("⏱ 监听超时（约40分钟）未集齐全部规划蓝图")
            self.done.emit(os.path.join(self.watch_dir, sorted(need)[0]) if need else self.watch_dir)
            return
        # 单文件模式（原有逻辑）：首个文件大小稳定即判定完成
        last_size = -1
        stable = 0
        target = None
        for _ in range(self.MAX_ROUNDS):
            try:
                cands = self._candidates()
                if cands:
                    cands.sort(key=lambda x: os.stat(x[0]).st_mtime, reverse=True)
                    fp, sz = cands[0]
                    target = fp
                    if sz >= self.min_bytes:
                        if sz == last_size:
                            stable += 1
                        else:
                            stable = 0
                            last_size = sz
                        if stable >= self.STABLE_NEED:
                            self.log.emit(f"✅ 文件大小已稳定，判定生成完成：{fp}")
                            self.done.emit(fp)
                            return
                    else:
                        last_size = sz
                        stable = 0
            except Exception as e:
                self.log.emit(f"⚠ 监听产出目录失败：{e}")
            time.sleep(self.POLL_SEC)
        self.log.emit("⏱ 监听超时（约40分钟）未判定完成")
        if target:
            self.log.emit(f"⚠ 超时但已检测到文件：{target}，仍标记为完成")
            self.done.emit(target)


class _WebCaptureWorker(QThread):
    """网页端 AI：发送后用 CDP 从页面抓取回复并落盘（网页端无法自写文件，
    不能走目录监听）。轮询 mix_send.capture_with_meta 直到「真实助手消息气泡」
    文本稳定，才写入产出目录——避免把整页回退文本（n==0，如网页原有内容/欢迎语）
    误判为完成而生成假的「完工文件」。"""
    log = Signal(str)
    done = Signal(str)

    POLL_SEC = 4
    MAX_ROUNDS = 600
    MIN_BYTES = 100
    STABLE_NEED = 2

    def __init__(self, ai_name, out_dir, proj_name=""):
        super().__init__()
        self.ai_name = ai_name
        self.out_dir = out_dir
        self.proj_name = proj_name

    def run(self):
        import os, time, sys
        sys.path.insert(0, paths.WINDOWS_USE)
        from mix_send import capture_with_meta as _cap
        os.makedirs(self.out_dir, exist_ok=True)
        target = os.path.join(self.out_dir, "故事梗概.md")
        prev = ""
        stable = 0
        ever_real = False
        self.log.emit("网页端：从页面抓取回复并落盘（仅认助手气泡，忽略整页回退）…")
        for _ in range(self.MAX_ROUNDS):
            try:
                meta = _cap(self.ai_name) or {}
                txt = (meta.get("text", "") or "").strip()
                n = meta.get("n", 0)
            except Exception as e:
                self.log.emit(f"抓取异常：{e}")
                txt, n = "", 0
            if txt and n > 0:
                ever_real = True
                if txt == prev:
                    stable += 1
                else:
                    stable = 0
                    prev = txt
                self.log.emit(f"抓取中（助手气泡 {n} 个，{len(prev)} 字符，稳定 {stable}）")
                if stable >= self.STABLE_NEED:
                    try:
                        with open(target, "w", encoding="utf-8") as f:
                            f.write(prev)
                        self.log.emit(f"✅ 已抓到真实回复并保存（{len(prev)} 字符）-> {target}")
                        self.done.emit(target)
                        return
                    except Exception as e:
                        self.log.emit(f"写文件失败：{e}")
            elif txt and n == 0:
                self.log.emit("· 本轮仅抓到整页回退文本（无助手气泡），继续等待 AI 回复…")
            else:
                self.log.emit("· 本轮未抓到文本，继续等待…")
            time.sleep(self.POLL_SEC)
        if ever_real and prev.strip():
            try:
                with open(target, "w", encoding="utf-8") as f:
                    f.write(prev)
                self.log.emit(f"⚠ 抓取超时，已保存最后抓到的回复（{len(prev)} 字符）-> {target}")
                self.done.emit(target)
                return
            except Exception:
                pass
        elif not ever_real:
            self.log.emit("❌ 网页端始终未出现助手回复（n==0，可能粘贴未成功或页面结构变化）")
        else:
            self.log.emit("❌ 网页端未能抓取到回复（请确认已登录且 CDP 端口正确）")


class _PlanGenWorker(QThread):
    """环节0 规划：把提示词发给 WorkBuddy，抓取一整块文本输出（不让 AI 写文件），
    再按两个标记拆成 故事梗概.md / AI建议调整方向.md。"""
    progress = Signal(str)
    done = Signal(bool, str)   # (成功?, 失败信息/空)

    GENERATING_JS = (
        "(() => {"
        "  const ags = [...document.querySelectorAll('.cr-agent')];"
        "  if (!ags.length) return 'no-agent';"
        "  const last = ags[ags.length-1];"
        "  const cls = last.className.toString();"
        "  const stop = [...document.querySelectorAll('button')]"
        "     .some(b => (b.getAttribute('aria-label')||'') === '停止');"
        "  return (cls.indexOf('processing') >= 0 || stop) ? 'gen' : 'done';"
        "})()"
    )
    READ_AGENT_JS = (
        "(() => {"
        "  const ags = [...document.querySelectorAll('.cr-agent')];"
        "  if (!ags.length) return '';"
        "  const last = ags[ags.length-1];"
        "  const c = last.querySelector('.cr-agent__content');"
        "  return c ? c.innerText : last.innerText;"
        "})()"
    )
    MARKER1 = "===文件1：故事梗概.md==="
    MARKER2 = "===文件2：AI建议调整方向.md==="

    def __init__(self, prompt, out_dir, proj_name=""):
        super().__init__()
        self.prompt = prompt
        self.out_dir = out_dir
        self.proj_name = proj_name

    def _ensure_wb(self):
        import sys, time
        sys.path.insert(0, paths.WINDOWS_USE)
        try:
            from players import launch as _launch, load_players as _load_players
        except Exception as e:
            self.progress.emit(f"⚠ 导入 players 失败：{e}")
            return
        port = 9227
        if not _cdp_alive(port):
            self.progress.emit("🚀 WorkBuddy 未运行，正在启动…")
            try:
                cfg = _load_players()
                wb = next((x for x in cfg if x.get("名字") == "WorkBuddy"), None)
                if wb:
                    _launch(wb)
            except Exception as e:
                self.progress.emit(f"⚠ 启动 WorkBuddy 失败：{e}")
            for _ in range(25):
                if _cdp_alive(port):
                    break
                time.sleep(1)

    def _capture(self):
        import sys, time
        sys.path.insert(0, paths.WINDOWS_USE)
        from mix_send import CDPTab
        port = 9227
        last_len = -1
        stable = 0
        for _ in range(600):   # 最多约 30 分钟
            try:
                t = CDPTab(port, "")
                status = t.js(self.GENERATING_JS)
                content = t.js(self.READ_AGENT_JS) or ""
            except Exception as e:
                self.progress.emit(f"⚠ 轮询 WorkBuddy 失败：{e}")
                time.sleep(3)
                continue
            if status == "gen":
                self.progress.emit(f"⏳ WorkBuddy 生成中…（当前 {len(content)} 字）")
                stable = 0
                time.sleep(3)
                continue
            if len(content) == last_len:
                stable += 1
            else:
                stable = 0
                last_len = len(content)
            if stable >= 2 and len(content) > 0:
                return content
            if status == "no-agent":
                self.progress.emit("⏳ 尚未检测到对话，继续等待…")
            time.sleep(3)
        try:
            t = CDPTab(port, "")
            return t.js(self.READ_AGENT_JS) or ""
        except Exception:
            return ""

    def run(self):
        import os
        try:
            self._ensure_wb()
            self.progress.emit("📤 正在发送提示词到 WorkBuddy…")
            from mix_send import send as cdp_send
            r = cdp_send("WorkBuddy", self.prompt)
            self.progress.emit(f"📨 发送结果：{r}")
            self.progress.emit("⏳ 等待 WorkBuddy 生成…")
            text = self._capture()
        except Exception as e:
            self.done.emit(False, f"调用 WorkBuddy 失败：{e}")
            return
        if not text.strip():
            self.done.emit(False, "未取到 WorkBuddy 输出")
            return
        # 步骤5：按两个标记拆分
        i1 = text.find(self.MARKER1)
        i2 = text.find(self.MARKER2)
        if i1 == -1 or i2 == -1:
            err_path = os.path.join(self.out_dir, "ERROR.md")
            try:
                with open(err_path, "w", encoding="utf-8") as f:
                    f.write(text.strip() + "\n")
            except Exception:
                pass
            self.done.emit(False, "生成格式异常，请重试")
            return
        part1 = text[i1 + len(self.MARKER1):i2].strip()
        part2 = text[i2 + len(self.MARKER2):].strip()
        try:
            with open(os.path.join(self.out_dir, "故事梗概.md"), "w", encoding="utf-8") as f:
                f.write(part1 + "\n")
            with open(os.path.join(self.out_dir, "AI建议调整方向.md"), "w", encoding="utf-8") as f:
                f.write(part2 + "\n")
        except Exception as e:
            self.done.emit(False, f"写入产出文件失败：{e}")
            return
        self.done.emit(True, "")


def _cdp_alive(port):
    """检查某个 CDP 端口是否可访问（即对应 AI 应用是否已启动）。"""
    import urllib.request
    if not port:
        return False
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/json", timeout=3) as f:
            return f.status == 200
    except Exception:
        return False


def _wb_generate(prompt, log_fn=print):
    """发送 prompt 到 WorkBuddy 并等待生成，返回整块文本（不让 AI 写文件）。"""
    import sys as _sys, time as _t
    _sys.path.insert(0, paths.WINDOWS_USE)
    try:
        from players import launch as _launch, load_players as _load_players
    except Exception as e:
        log_fn(f"⚠ 导入 players 失败：{e}")
        return ""
    port = 9227
    if not _cdp_alive(port):
        log_fn("🚀 WorkBuddy 未运行，正在启动…")
        try:
            cfg = _load_players()
            wb = next((x for x in cfg if x.get("名字") == "WorkBuddy"), None)
            if wb:
                _launch(wb)
        except Exception as e:
            log_fn(f"⚠ 启动 WorkBuddy 失败：{e}")
        for _ in range(25):
            if _cdp_alive(port):
                break
            _t.sleep(1)
    log_fn("📤 正在发送提示词到 WorkBuddy…")
    from mix_send import send as cdp_send
    r = cdp_send("WorkBuddy", prompt)
    log_fn(f"📨 发送结果：{r}")
    log_fn("⏳ 等待 WorkBuddy 生成…")
    return _wb_capture(log_fn)


def _wb_capture(log_fn=print):
    """轮询 WorkBuddy 最后一个 agent 的输出，稳定后返回整块文本。"""
    import sys as _sys, time as _t
    _sys.path.insert(0, paths.WINDOWS_USE)
    from mix_send import CDPTab
    port = 9227
    last_len = -1
    stable = 0
    for _ in range(600):   # 最多约 30 分钟
        try:
            t = CDPTab(port, "")
            status = t.js(_PlanGenWorker.GENERATING_JS)
            content = t.js(_PlanGenWorker.READ_AGENT_JS) or ""
        except Exception as e:
            log_fn(f"⚠ 轮询 WorkBuddy 失败：{e}")
            _t.sleep(3)
            continue
        if status == "gen":
            log_fn(f"⏳ WorkBuddy 生成中…（当前 {len(content)} 字）")
            stable = 0
            _t.sleep(3)
            continue
        if len(content) == last_len:
            stable += 1
        else:
            stable = 0
            last_len = len(content)
        if stable >= 2 and len(content) > 0:
            return content
        if status == "no-agent":
            log_fn("⏳ 尚未检测到对话，继续等待…")
        _t.sleep(3)
    try:
        t = CDPTab(port, "")
        return t.js(_PlanGenWorker.READ_AGENT_JS) or ""
    except Exception:
        return ""


class _PhaseRunWorker(QThread):
    """37 环引擎后台运行：run_phase（单模块）或 run_book（章节循环），结束发 done。"""
    progress = Signal(str)
    done = Signal(bool, str)

    def __init__(self, phase_name, project_dir, proj_name, finalize,
                 resume=False, chapters=1, book=False):
        super().__init__()
        self.phase_name = phase_name
        self.project_dir = project_dir
        self.proj_name = proj_name
        self.finalize = finalize
        self.resume = resume
        self.chapters = chapters
        self.book = book

    def _log(self, msg):
        self.progress.emit(msg)

    def run(self):
        try:
            # 把 phase_runner 的 AI 调用换成真实 WorkBuddy（忽略角色名，统一走 WorkBuddy）
            set_call_ai(
                lambda role, ai_name, prompt, log_fn=None: _wb_generate(prompt, log_fn or self._log))
            if self.book:
                out = run_book(self.project_dir, chapters=self.chapters,
                               log_fn=self._log, resume=self.resume)
            else:
                out = run_phase(self.phase_name, log_fn=self._log,
                                project_dir=self.project_dir, finalize=self.finalize,
                                resume=self.resume)
            if out == "PAUSED":
                self.done.emit(True, "已暂停")
            else:
                self.done.emit(True, "")
        except Exception as e:
            import traceback
            self._log(f"❌ 环节运行异常：{e}\n{traceback.format_exc()}")
            self.done.emit(False, f"环节运行异常：{e}")


class _StageRunWorker(QThread):
    """auto_stage.run_stage 后台线程：运行单个大环节，避免冻结 UI。"""
    progress = Signal(str)
    refresh = Signal()
    done = Signal(bool, str)

    def __init__(self, stage_key, dry=False, chapter=None):
        super().__init__()
        self.stage_key = stage_key
        self.dry = dry
        self.chapter = chapter

    def run(self):
        try:
            import collab_exec as _ce
            _ce.start_run()
            _ce.resume()
            ok = _ce.run_stage(self.stage_key, self.progress.emit, self.dry,
                               self.refresh.emit, chapter=self.chapter)
            if ok:
                self.done.emit(True, "")
            else:
                self.done.emit(False, "环节未全部通过，请检查指派与结果")
        except Exception as e:
            import traceback
            self.progress.emit(f"❌ 环节运行异常：{e}\n{traceback.format_exc()}")
            self.done.emit(False, f"环节运行异常：{e}")


class _StageNextWorker(QThread):
    """手动模式：只发送一个大环节中下一个子项（块/审核/调整），避免冻结 UI。"""
    progress = Signal(str)
    refresh = Signal()
    done = Signal(bool, str)

    def __init__(self, stage_key, dry=False, chapter=None):
        super().__init__()
        self.stage_key = stage_key
        self.dry = dry
        self.chapter = chapter

    def run(self):
        try:
            import collab_exec as _ce
            _ce.start_run()
            _ce.resume()
            ok = _ce.run_next_item(self.stage_key, self.progress.emit, self.dry,
                                   self.refresh.emit, chapter=self.chapter)
            self.done.emit(bool(ok), "")
        except Exception as e:
            import traceback
            self.progress.emit(f"❌ 手动发送异常：{e}\n{traceback.format_exc()}")
            self.done.emit(False, f"手动发送异常：{e}")


