# project_expander.py — 按项目信息动态展开 01_规划 的环节清单
#
# 输入：
#   · 00_初始化/项目信息.json（人物设计列表、章节数）
#   · rules/环节模板.json（固定环 + 人物设计环 + 外围设计环）
#   · rules/phases.json（02_写作 / 03_去AI / 04_审核 / 05_出厂 的环节）
#
# 输出：
#   · rules/rings_items.json（本次项目专属的完整环节清单）
#
# 用法：
#   python project_expander.py --project-dir "F:\...\output\<项目名>"
#   python project_expander.py --info "路径\项目信息.json"
#   python project_expander.py --demo      # 用示例数据跑一遍，不写盘

import argparse
import json
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
RULES_DIR = HERE.parent / "rules"
模板文件 = RULES_DIR / "环节模板.json"
phases文件 = RULES_DIR / "phases.json"
输出文件 = RULES_DIR / "rings_items.json"


# ────────────────────────────────────────────────────────────
# 读取
# ────────────────────────────────────────────────────────────

def 读_json(p: Path, default=None):
    if not p.exists():
        return default
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"[错误] 读 {p} 失败：{e}")
        return default


def 读项目信息(项目目录: Path) -> dict:
    p = 项目目录 / "00_初始化" / "项目信息.json"
    if not p.exists():
        print(f"[错误] 找不到 {p}")
        sys.exit(1)
    return 读_json(p) or {}


# ────────────────────────────────────────────────────────────
# 展开
# ────────────────────────────────────────────────────────────

def 计算外围环数(章节数: int, cfg: dict) -> int:
    base = int(cfg.get("基础数", 3))
    step = int(cfg.get("步长", 100))
    add = int(cfg.get("每步追加", 3))
    if 章节数 <= 0:
        return base
    return base + max(0, (章节数 - 1) // step) * add


def 展开人物设计环(人物列表: list, cfg: dict) -> list:
    out = []
    for i, name in enumerate(人物列表, 1):
        code = cfg["命名模式"].format(index=i)
        disp = cfg["显示名模式"].format(name=name)
        desc = cfg["desc模板"].format(name=name)
        out.append({
            "code": code,
            "name": disp,
            "type": "person",
            "person": name,
            "desc": desc,
        })
    return out


def 展开外围环(章节数: int, cfg: dict) -> list:
    n = 计算外围环数(章节数, cfg)
    pool = cfg.get("环池", [])
    out = []
    for item in pool[:n]:
        out.append({
            "code": item["code"],
            "name": item["name"],
            "type": "peripheral",
            "desc": item["desc"],
        })
    return out


def 组装规划环节(模板: dict, 项目信息: dict) -> dict:
    """把固定环 + 人物设计环 + 外围环按顺序拼成 01_规划 的完整清单"""
    人物列表 = 项目信息.get("人物设计列表") or []
    if isinstance(人物列表, str):
        人物列表 = [x.strip() for x in 人物列表.replace("，", ",").split(",") if x.strip()]
    章节数 = int(项目信息.get("章节数") or 100)

    固定环 = 模板.get("固定环", [])
    人物环cfg = 模板.get("人物设计环", {})
    外围cfg = 模板.get("外围设计环", {})

    人物环 = 展开人物设计环(人物列表, 人物环cfg)
    外围环 = 展开外围环(章节数, 外围cfg)

    # 按顺序拼接：P01-P05 → 人物设计环 → P07 → 外围环 → P08-P21
    结果 = []
    for r in 固定环:
        if r["code"] in ("P01", "P02", "P03", "P04", "P05"):
            结果.append({**r, "type": "fixed"})
    结果.extend(人物环)
    for r in 固定环:
        if r["code"] == "P07":
            结果.append({**r, "type": "fixed"})
    结果.extend(外围环)
    for r in 固定环:
        if r["code"] not in ("P01", "P02", "P03", "P04", "P05", "P07"):
            结果.append({**r, "type": "fixed"})

    return {
        "环数": len(结果),
        "固定环数": sum(1 for x in 结果 if x["type"] == "fixed"),
        "人物设计环数": len(人物环),
        "外围环数": len(外围环),
        "章节数": 章节数,
        "人物设计列表": 人物列表,
        "环节": 结果,
    }


def 抄其他阶段(phases: dict) -> dict:
    """02_写作 / 03_去AI / 04_审核 / 05_出厂 直接抄 phases.json，只做规范化"""
    环节 = phases.get("环节", {}) or {}
    out = {}
    for 阶段 in ("02_写作", "03_去AI", "04_审核", "05_出厂"):
        items = 环节.get(阶段, [])
        norm = []
        for i, item in enumerate(items, 1):
            if isinstance(item, str):
                norm.append({"code": f"{阶段[:2]}-{i:02d}", "name": item, "type": "fixed"})
            elif isinstance(item, dict):
                norm.append({
                    "code": item.get("code") or f"{阶段[:2]}-{i:02d}",
                    "name": item.get("name", ""),
                    "type": item.get("mode", "fixed"),
                    "raw": item,
                })
        out[阶段] = {"环数": len(norm), "环节": norm}
    return out


# ────────────────────────────────────────────────────────────
# 写盘
# ────────────────────────────────────────────────────────────

def 生成(项目信息: dict, 模板: dict, phases: dict) -> dict:
    return {
        "_说明": "本次项目专属的完整环节清单，由 project_expander.py 生成。",
        "生成时间": time.strftime("%Y-%m-%d %H:%M:%S"),
        "项目名": 项目信息.get("项目名称") or 项目信息.get("name") or "未命名",
        "章节数": int(项目信息.get("章节数") or 100),
        "人物设计列表": 项目信息.get("人物设计列表") or [],
        "01_规划": 组装规划环节(模板, 项目信息),
        **抄其他阶段(phases),
    }


def 打印摘要(清单: dict):
    print("=" * 70)
    print(f"项目：{清单['项目名']}　章节数：{清单['章节数']}")
    print(f"人物设计列表：{清单['人物设计列表']}")
    print("=" * 70)

    g = 清单["01_规划"]
    print(f"01_规划：总 {g['环数']} 环 "
          f"（固定 {g['固定环数']} + 人物 {g['人物设计环数']} + 外围 {g['外围环数']}）")
    print()
    for r in g["环节"]:
        mark = {"fixed": "  ", "person": "👤", "peripheral": "🌐"}.get(r["type"], "  ")
        print(f"  {mark} {r['code']:<10} {r['name']}")
    print()
    for 阶段 in ("02_写作", "03_去AI", "04_审核", "05_出厂"):
        info = 清单[阶段]
        print(f"{阶段}：{info['环数']} 环")
        for r in info["环节"]:
            print(f"     {r['code']:<10} {r['name']}")
        print()

    总 = g["环数"] + sum(清单[s]["环数"] for s in ("02_写作", "03_去AI", "04_审核", "05_出厂"))
    print("=" * 70)
    print(f"合计：{总} 个环节")
    print("=" * 70)


# ────────────────────────────────────────────────────────────
# CLI
# ────────────────────────────────────────────────────────────

def main():
    ap = argparse.ArgumentParser(description="按项目信息动态展开环节清单")
    ap.add_argument("--project-dir", default="", help="项目目录（含 00_初始化/项目信息.json）")
    ap.add_argument("--info", default="", help="直接指定 项目信息.json 路径")
    ap.add_argument("--out", default=str(输出文件), help="输出路径（默认 rules/rings_items.json）")
    ap.add_argument("--demo", action="store_true", help="用示例数据跑一遍，不写盘")
    args = ap.parse_args()

    模板 = 读_json(模板文件)
    if not 模板:
        print(f"[错误] 找不到或读不了 {模板文件}")
        sys.exit(1)
    phases = 读_json(phases文件, default={"环节": {}})

    if args.demo:
        项目信息 = {
            "项目名称": "示例项目",
            "章节数": 200,
            "人物设计列表": ["陆炎", "容妃", "幼帝", "白泽", "蛇口会首"],
        }
    elif args.info:
        项目信息 = 读_json(Path(args.info)) or {}
    elif args.project_dir:
        项目信息 = 读项目信息(Path(args.project_dir))
    else:
        print("[错误] 请给 --project-dir、--info 或 --demo")
        sys.exit(1)

    清单 = 生成(项目信息, 模板, phases)
    打印摘要(清单)

    if args.demo:
        print("\n[demo] 未写盘。")
        return

    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(清单, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(f"\n✔ 已写入：{out}")


if __name__ == "__main__":
    main()