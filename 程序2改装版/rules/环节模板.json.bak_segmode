{
  "_说明": "01_规划的环节模板。固定环 + 外围环（按章节数扩展）。",
  "固定环": [
    {
      "code": "P01",
      "name": "规划前约束",
      "desc": "字数/时间/平台/资源/风险五约；AI 出模板与候选，人填真实约束"
    },
    {
      "code": "P02",
      "name": "类型平台读者卖点",
      "desc": "主类型/子类型/平台/读者画像/竞品/差异点/雷点"
    },
    {
      "code": "P03",
      "name": "文风与叙事基调",
      "desc": "叙事视角/语调/恢弘vs爽白/描写密度/去AI味基线"
    },
    {
      "code": "P04",
      "name": "一句话故事",
      "desc": "主角+身份+欲望+阻力+代价+独特设定→合成句"
    },
    {
      "code": "P05",
      "name": "简介与主题",
      "desc": "常态/变故/行动/悬念；主题/核心问题/价值冲突"
    },
    {
      "code": "P06",
      "name": "人物设计",
      "desc": "读项目信息的『人物设计列表』，为每个人物生成一份档案：基础信息/外貌/性格/表深层欲望/恐惧/创伤/秘密/能力+代价/弱点/口癖/初始状态/终局状态/成长弧光/功法/宝物/获取时间线"
    },
    {
      "code": "P07",
      "name": "核心冲突与反派",
      "desc": "冲突分层/反派基础目标动机/镜像点/资源/弱点/底线/结局"
    },
    {
      "code": "P08",
      "name": "世界规则最小集",
      "desc": "地理/势力/社会/经济/文化禁忌/力量体系/等级/能力/代价/限制/获取/禁忌/克制/历史/日常"
    },
    {
      "code": "P09",
      "name": "全书结构",
      "desc": "三幕/五幕划分（哪一幕从第几章到第几章）+ 主线弧光（主角从 ___ 到 ___）+ 全书大结构锚点（开局钩子/中点翻转/高潮爆点/终局画面）+ 各卷主线递进关系（卷1 主线→卷2 主线→…）",
      "fields": [
        "三幕/五幕划分",
        "主线弧光",
        "开局钩子",
        "中点翻转",
        "高潮爆点",
        "终局画面",
        "各卷主线递进关系"
      ]
    },
    {
      "code": "P10",
      "name": "分卷结构",
      "desc": "卷数/字数/起止章/时间地点/本卷目标/冲突/新人新图/关键事件/高潮/钩子/伏笔/主角变化"
    },
    {
      "code": "P11",
      "name": "情绪规划",
      "desc": "全书情绪主基调/每卷情绪曲线/压抑·释放·爽·痛·燃·泪·绝望·希望章定位"
    },
    {
      "code": "P12",
      "name": "节奏规划",
      "desc": "信息释放/冲突升级/高潮间隔/张弛比例/钩子密度/章节节奏/中段防拖"
    },
    {
      "code": "P13",
      "name": "结局与终局",
      "desc": "终局画面/主角终态/世界变化/最大代价/反派结局/配角结局/主题回答/最后场景"
    },
    {
      "code": "P14",
      "name": "总纲规划",
      "desc": "故事内容摘要（500 字）+ 故事底色 + 人物的成长 + 最后的结局",
      "fields": [
        "故事内容摘要（500 字）",
        "故事底色",
        "人物成长",
        "最后结局"
      ]
    },
    {
      "code": "P15",
      "name": "粗纲规划",
      "desc": "每卷一段话（约 200 字）+ 卷级起承转合",
      "fields": [
        "每卷一段话（约 200 字）",
        "卷级起承转合"
      ]
    },
    {
      "code": "P16",
      "name": "简短细纲规划",
      "desc": "每章一句话（约 30 字），按卷分次产出（第一卷/第二卷/…）",
      "segment_mode": "volume",
      "fields": [
        "章序号",
        "每章一句话（约 30 字）"
      ]
    },
    {
      "code": "P17",
      "name": "详细细纲规划",
      "desc": "每章 16 项字段（目标/阻力/代价/时间锚点/章内跨度/与上章时差/倒计时状态/爽点/叙事线归属/对手层级/视角/关键实体/本章变化/章末未闭合问题/六要素阶段/钩子类型），按 30 章分次产出（1-30章/31-60章/…）",
      "segment_mode": "chapters",
      "segment_size": 30,
      "fields": [
        "章序号",
        "目标",
        "阻力",
        "代价",
        "时间锚点",
        "章内跨度",
        "与上章时差",
        "倒计时状态",
        "爽点",
        "叙事线归属",
        "对手层级",
        "视角",
        "关键实体",
        "本章变化",
        "章末未闭合问题",
        "六要素阶段",
        "钩子类型"
      ]
    },
    {
      "code": "P18",
      "name": "前30章章纲",
      "desc": "每章钩子/冲突/悬念/结尾钩子；章纲范式=交付轨一段话+字段轨（含六要素阶段）"
    },
    {
      "code": "P19",
      "name": "开篇黄金三章爆破",
      "desc": "前三章强代入/强钩/爽点前置/人设立住/零infodump"
    },
    {
      "code": "P20",
      "name": "伏笔时间线关系表",
      "desc": "伏笔表/时间线/关系图/章节状态表"
    },
    {
      "code": "P21",
      "name": "书名设计",
      "desc": "候选≥10个（主名+备选）：品类关键词/记忆点/搜索友好"
    },
    {
      "code": "P22",
      "name": "上架简介",
      "desc": "30字/80字/300字/分平台版；首句钩子+卖点词×3+主角困境+末句悬念"
    },
    {
      "code": "P23",
      "name": "标签选择",
      "desc": "主分类/主题/角色/阅读/情节/情感/人设/世界观；必须来自 标签池.json"
    },
    {
      "code": "P24",
      "name": "封面设计规划",
      "desc": "构图/主体/场景/色调/字体层级/卖点短词/避雷项/尺寸"
    },
    {
      "code": "P25",
      "name": "文档与备份",
      "desc": "文件夹/命名/三处备份/版本"
    },
    {
      "code": "P26",
      "name": "发布与合规",
      "desc": "平台规则/签约/版权/分成/AI政策/预算/合规风险"
    },
    {
      "code": "P27",
      "name": "规划验收",
      "desc": "八方向逐方向打勾 + 章纲终审投票 + 人终检锁章纲"
    }
  ],
  "外围设计环": {
    "依据字段": "章节数",
    "编号前缀": "P0Z",
    "基础数": 3,
    "步长": 100,
    "每步追加": 3,
    "扩展公式": "外围环数 = 基础数 + max(0, (章节数 - 1) // 步长) × 每步追加",
    "插入位置": "在 P08 世界规则最小集 之后、P09 全书结构 之前",
    "环池": [
      {
        "code": "P0Z-1",
        "name": "门派与势力",
        "desc": "门派/宗门/家族/势力：立场/功法特色/与主角关系/势力分布"
      },
      {
        "code": "P0Z-2",
        "name": "副本与任务线",
        "desc": "副本类型/进入条件/产出；主线/支线/隐藏任务线分类与节点"
      },
      {
        "code": "P0Z-3",
        "name": "血脉与灵兽",
        "desc": "特殊血脉类型/觉醒条件/代价；灵兽种类/契约方式/能力/等级"
      },
      {
        "code": "P0Z-4",
        "name": "地图与秘境",
        "desc": "主要地图/区域划分/秘境入口/进入条件/产出"
      },
      {
        "code": "P0Z-5",
        "name": "宝物与传承",
        "desc": "主要宝物/传承/遗迹/获取难度/守护者"
      },
      {
        "code": "P0Z-6",
        "name": "天骄与对手",
        "desc": "同辈天骄/对头/竞赛体系/排名/实力对比"
      },
      {
        "code": "P0Z-7",
        "name": "战争与格局",
        "desc": "大规模战争/势力格局变迁/阵营战/历史战役"
      },
      {
        "code": "P0Z-8",
        "name": "世界层级与飞升",
        "desc": "世界层级/上界/飞升规则/更高维度/终极力量"
      }
    ]
  }
}
